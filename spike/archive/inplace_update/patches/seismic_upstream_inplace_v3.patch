+// ===========================================================================
+// In-place format v3 (2026-09-29): masked posting words + per-block inflation.
+// Spec: spike/inplace_update/FORMAT_V3.md (main repo). The v2 methods above
+// are untouched; these are their twins with (1) the posting word loaded
+// atomically and filtered by visible(w, E), (2) START masked to 32 bits, and
+// (3) the block dot multiplied by the block's inflation code before the skip
+// test and the first-term sort. With zero patches (FREE = 0, TAG = 0, E = 0,
+// every code 0) every step is bit-identical to the v2 twin.
+// ===========================================================================
+
+/// v3 posting word: bit 63 = FREE.
+pub const V3_FREE_SHIFT: u32 = 63;
+/// v3 posting word: bits 48..62 = epoch TAG.
+pub const V3_TAG_SHIFT: u32 = 48;
+/// v3 TAG width mask (15 bits).
+pub const V3_TAG_MASK: u64 = 0x7FFF;
+/// v3 posting word: bits 16..47 = START (word offset into forward_data.bin).
+pub const V3_START_SHIFT: u32 = 16;
+/// v3 START width mask (32 bits).
+pub const V3_START_MASK: u64 = 0xFFFF_FFFF;
+/// v3 posting word: bits 0..15 = LEN (record length in words).
+pub const V3_LEN_MASK: u64 = 0xFFFF;
+/// Inflation code meaning "bound is +inf, always evaluate the block".
+pub const V3_INFL_SATURATED: u8 = 255;
+
+const fn build_infl_lut() -> [f32; 256] {
+    let mut lut = [0f32; 256];
+    let mut c = 0usize;
+    while c < 256 {
+        lut[c] = 1.0 + (c as f32) / 32.0;
+        c += 1;
+    }
+    lut
+}
+
+/// Inflation multiplier per code: `1 + code/32` (code 0 -> exactly 1.0).
+/// Code 255 is handled as saturated by the caller, never through the LUT.
+pub static V3_INFL_LUT: [f32; 256] = build_infl_lut();
+
+/// `visible(w, E) = (TAG <= E) XOR FREE` (FORMAT_V3.md §2.2).
+#[inline(always)]
+pub fn v3_visible(word: u64, epoch: u64) -> bool {
+    let tag = (word >> V3_TAG_SHIFT) & V3_TAG_MASK;
+    ((tag <= epoch) as u64 ^ (word >> V3_FREE_SHIFT)) != 0
+}
+
+/// Masked forward range of a v3 posting word.
+#[inline(always)]
+pub fn v3_range(word: u64) -> std::ops::Range<usize> {
+    let start = ((word >> V3_START_SHIFT) & V3_START_MASK) as usize;
+    let len = (word & V3_LEN_MASK) as usize;
+    start..(start + len)
+}
+
+/// Atomic (Relaxed) load of a mapped posting word. The mapping is 8-byte
+/// aligned (`read_pod` asserts it) and read-only; a relaxed 8-byte atomic load
+/// is a plain `mov` on x86-64 and is permitted on read-only memory.
+#[inline(always)]
+fn v3_load_word(p: &PackedPostingBlock) -> u64 {
+    let ptr = p as *const PackedPostingBlock as *const std::sync::atomic::AtomicU64;
+    unsafe { (*ptr).load(std::sync::atomic::Ordering::Relaxed) }
+}
+
+/// Atomic (Relaxed) load of a mapped inflation code.
+#[inline(always)]
+fn v3_load_code(b: &u8) -> u8 {
+    let ptr = b as *const u8 as *const std::sync::atomic::AtomicU8;
+    unsafe { (*ptr).load(std::sync::atomic::Ordering::Relaxed) }
+}
+
+impl<'a> MmapPostingList<'a> {
+    /// Number of blocks (= summaries) of this list; the length its inflation
+    /// slice must have.
+    #[inline]
+    pub fn n_blocks(&self) -> usize {
+        self.block_offsets.len().saturating_sub(1)
+    }
+
+    /// Summary dots with the per-block inflation applied (`infl` = this
+    /// list's slice of the active bank). Code 0 multiplies by exactly 1.0.
+    #[inline]
+    fn inflated_dots(&self, query: &SparseVectorView<'_, u16, f32>, infl: &[u8]) -> Vec<f32> {
+        let mut dots = self.summaries.distances(query);
+        assert_eq!(dots.len(), infl.len(), "inflation slice length != block count");
+        for (d, b) in dots.iter_mut().zip(infl.iter()) {
+            let c = v3_load_code(b);
+            *d = if c == V3_INFL_SATURATED {
+                f32::INFINITY
+            } else {
+                *d * V3_INFL_LUT[c as usize]
+            };
+        }
+        dots
+    }
+
+    /// v3 twin of [`Self::search`].
+    #[allow(clippy::too_many_arguments)]
+    pub fn search_v3<'e, 'q, S>(
+        &self,
+        evaluator: &mut <EncoderFor<S> as VectorEncoder>::Evaluator<'e>,
+        query: &SparseVectorView<'q, u16, f32>,
+        k: usize,
+        heap_factor: f32,
+        heap: &mut KHeap<ScoredRange<DotProduct>>,
+        visited: &mut FxHashSet<usize>,
+        forward_index: &'e S,
+        mut block_stats: Option<&mut Vec<usize>>,
+        infl: &[u8],
+        epoch: u64,
+    ) where
+        S: SeismicSearchDataset,
+    {
+        let dots = self.inflated_dots(query, infl);
+        let m8_batch = m8_batch_enabled();
+        for (block_id, dot) in dots.into_iter().enumerate() {
+            if heap.len() == k && dot < heap_factor * heap.peek().distance.distance() {
+                continue;
+            }
+            let scored = self.evaluate_posting_block_v3(
+                self.block_slice(block_id), evaluator, heap, visited, forward_index, m8_batch, epoch,
+            );
+            if let Some(acc) = block_stats.as_deref_mut() {
+                acc.push(scored);
+            }
+        }
+    }
+
+    /// v3 twin of [`Self::sort_and_search`]: the sort key is the inflated dot.
+    #[allow(clippy::too_many_arguments)]
+    pub fn sort_and_search_v3<'e, 'q, S>(
+        &self,
+        evaluator: &mut <EncoderFor<S> as VectorEncoder>::Evaluator<'e>,
+        query: &SparseVectorView<'q, u16, f32>,
+        k: usize,
+        heap_factor: f32,
+        heap: &mut KHeap<ScoredRange<DotProduct>>,
+        visited: &mut FxHashSet<usize>,
+        forward_index: &'e S,
+        mut block_stats: Option<&mut Vec<usize>>,
+        infl: &[u8],
+        epoch: u64,
+    ) where
+        S: SeismicSearchDataset,
+    {
+        let dots = self.inflated_dots(query, infl);
+        let dots: Vec<_> = dots.into_iter().enumerate()
+            .sorted_unstable_by(|&(_, a), &(_, b)| b.total_cmp(&a))
+            .collect();
+        let m8_batch = m8_batch_enabled();
+        for (block_id, dot) in dots {
+            if heap.len() == k && dot < heap_factor * heap.peek().distance.distance() {
+                continue;
+            }
+            let scored = self.evaluate_posting_block_v3(
+                self.block_slice(block_id), evaluator, heap, visited, forward_index, m8_batch, epoch,
+            );
+            if let Some(acc) = block_stats.as_deref_mut() {
+                acc.push(scored);
+            }
+        }
+    }
+
+    /// v3 twin of [`Self::evaluate_posting_block`]: every pass loads the word
+    /// atomically, skips it unless `v3_visible(w, E)`, and uses the masked
+    /// range. A concurrent single writer only ever (a) writes a slot dead at E
+    /// with TAG E+1 (invisible before and after) or (b) sets FREE/TAG E+1 on a
+    /// live slot keeping START/LEN (visible with the same range before and
+    /// after), so the two loads of one word always agree on (visible, range).
+    #[allow(clippy::too_many_arguments)]
+    fn evaluate_posting_block_v3<'e, S>(
+        &self,
+        packed_posting_block: &[PackedPostingBlock],
+        evaluator: &<EncoderFor<S> as VectorEncoder>::Evaluator<'e>,
+        heap: &mut KHeap<ScoredRange<DotProduct>>,
+        visited: &mut FxHashSet<usize>,
+        forward_index: &'e S,
+        m8_batch: bool,
+        epoch: u64,
+    ) -> usize
+    where
+        S: SeismicSearchDataset,
+    {
+        for pack in packed_posting_block.iter() {
+            let w = v3_load_word(pack);
+            if !v3_visible(w, epoch) {
+                continue;
+            }
+            let range = v3_range(w);
+            if visited.contains(&range.start) {
+                continue;
+            }
+            forward_index.prefetch_with_range(range);
+        }
+
+        if !m8_batch {
+            let mut scored_in_block = 0usize;
+            for pack in packed_posting_block.iter() {
+                let w = v3_load_word(pack);
+                if !v3_visible(w, epoch) {
+                    continue;
+                }
+                let range = v3_range(w);
+                if visited.insert(range.start) {
+                    let vector = forward_index.get_with_range(range.clone());
+                    let distance = evaluator.compute_distance(vector);
+                    heap.push(ScoredRange { distance, range });
+                    scored_in_block += 1;
+                }
+            }
+            return scored_in_block;
+        }
+
+        let mut survivors: Vec<std::ops::Range<usize>> =
+            Vec::with_capacity(packed_posting_block.len());
+        for pack in packed_posting_block.iter() {
+            let w = v3_load_word(pack);
+            if !v3_visible(w, epoch) {
+                continue;
+            }
+            let range = v3_range(w);
+            if visited.insert(range.start) {
+                survivors.push(range);
+            }
+        }
+        let mut chunks = survivors.chunks_exact(M8_BATCH_WIDTH);
+        for chunk in chunks.by_ref() {
+            let vectors = [
+                forward_index.get_with_range(chunk[0].clone()),
+                forward_index.get_with_range(chunk[1].clone()),
+                forward_index.get_with_range(chunk[2].clone()),
+                forward_index.get_with_range(chunk[3].clone()),
+                forward_index.get_with_range(chunk[4].clone()),
+                forward_index.get_with_range(chunk[5].clone()),
+            ];
+            let distances = evaluator.compute_distances_batch6_exact(vectors);
+            for (distance, range) in distances.into_iter().zip(chunk.iter()) {
+                heap.push(ScoredRange {
+                    distance,
+                    range: range.clone(),
+                });
+            }
+        }
+        for range in chunks.remainder() {
+            let vector = forward_index.get_with_range(range.clone());
+            let distance = evaluator.compute_distance(vector);
+            heap.push(ScoredRange {
+                distance,
+                range: range.clone(),
+            });
+        }
+        survivors.len()
+    }
+}
