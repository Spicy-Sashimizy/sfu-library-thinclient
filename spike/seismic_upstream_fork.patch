+// ---------------------------------------------------------------------------
+// read_rss_kb — /proc/self/status RssAnon + RssFile
+// ---------------------------------------------------------------------------
+
+/// Read the process RSS breakdown from `/proc/self/status`. Returns
+/// `(rss_anon_kb, rss_file_kb)`. Both are in kilobytes (matching /proc). Used
+/// by the C1a bin to measure the Path-A floor vs the mmap cure.
+pub fn read_rss_kb() -> (usize, usize) {
+    let mut anon = 0usize;
+    let mut file = 0usize;
+    if let Ok(status) = std::fs::read_to_string("/proc/self/status") {
+        for line in status.lines() {
+            if let Some(rest) = line.strip_prefix("RssAnon:") {
+                anon = rest.trim().split_whitespace().next().and_then(|s| s.parse().ok()).unwrap_or(0);
+            } else if let Some(rest) = line.strip_prefix("RssFile:") {
+                file = rest.trim().split_whitespace().next().and_then(|s| s.parse().ok()).unwrap_or(0);
+            }
+        }
+    }
+    (anon, file)
+}
