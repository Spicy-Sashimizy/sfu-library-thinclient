+    /// E7 Fix #5 (2026-07-03): page-aligned converter parity. A synthetic index
+    /// big enough that records genuinely straddle 4 KiB boundaries; convert with
+    /// page_align both off and on; the aligned dir must (a) produce EXACTLY the
+    /// same search results as the unaligned dir (same FixedU8Q quantization —
+    /// the pad is decode-transparent), (b) have no record straddling a page
+    /// unless longer than a page, and (c) decode every doc losslessly (the
+    /// converter itself verifies this with sample_check = n_docs).
+    #[test]
+    fn dotvbyte_page_align_parity() {
+        let base = std::path::PathBuf::from(format!("/tmp/seismic_e7pa_test_{}", std::process::id()));
+        let f16_dir = base.join("f16");
+        let dv_dir = base.join("dv");
+        let pa_dir = base.join("dv_pa");
+        let _ = std::fs::remove_dir_all(&base);
+        std::fs::create_dir_all(&f16_dir).expect("create test dirs");
+
+        // 600 docs, ~60-100 nnz each over a 2048 vocab — records ~20-30 u64
+        // words, so ~1 in 20 straddles a 512-word page boundary without
+        // alignment (mirrors the shard0 geometry, straddle fraction ~0.05).
+        let dim = 2048usize;
+        let mut token_to_id_map = HashMap::new();
+        for i in 0..dim {
+            token_to_id_map.insert(format!("t{}", i), i);
+        }
+        let encoder = ScalarSparseQuantizer::<u16, f32, f16, DotProduct>::new(dim, dim);
+        let mut ds = SparseDatasetGrowable::new(encoder);
+        let mut rng_state = 0x9E3779B97F4A7C15u64; // deterministic LCG-ish
+        let mut next = move || {
+            rng_state ^= rng_state << 13;
+            rng_state ^= rng_state >> 7;
+            rng_state ^= rng_state << 17;
+            rng_state
+        };
+        let n_docs = 600usize;
+        for _ in 0..n_docs {
+            let nnz = 60 + (next() % 41) as usize; // 60..=100
+            let mut comps: Vec<u16> = (0..nnz)
+                .map(|_| (next() % dim as u64) as u16)
+                .collect();
+            comps.sort_unstable();
+            comps.dedup();
+            let vals: Vec<f32> = comps.iter().map(|_| 0.1 + (next() % 30) as f32 / 10.0).collect();
+            ds.push(SparseVectorView::new(&comps, &vals));
+        }
+        let frozen: OwnedForward = ds.into();
+        let doc_mapping: Vec<String> = (0..n_docs).map(|i| format!("doc{}", i)).collect();
+        let owned = SeismicIndex::new(
+            frozen,
+            Configuration::default(),
+            Some(doc_mapping),
+            None::<Vec<Option<String>>>,
+            token_to_id_map,
+        );
+        write_mmap_index(&owned, &f16_dir).expect("write_mmap_index");
+
+        let rep_plain = convert_f16_dir_to_dotvbyte(&f16_dir, &dv_dir, n_docs, false, ValueScale::Fixed)
+            .expect("convert plain");
+        let rep_pa = convert_f16_dir_to_dotvbyte(&f16_dir, &pa_dir, n_docs, true, ValueScale::Fixed)
+            .expect("convert page-aligned");
+        assert_eq!(rep_pa["page_align"]["enabled"], true);
+        let pad_words = rep_pa["page_align"]["pad_words"].as_u64().unwrap();
+        assert!(pad_words > 0, "test geometry produced no straddles — enlarge the corpus");
+        eprintln!("page-align pad_words={} growth={}%",
+            pad_words, rep_pa["page_align"]["growth_pct"]);
+
+        // (b) no straddle: walk the padded offsets.
+        let off_bytes = std::fs::read(pa_dir.join("forward_offsets.bin")).unwrap();
+        let offs: &[usize] = bytemuck::cast_slice(&off_bytes);
+        const PAGE_WORDS: usize = 512;
+        for i in 0..offs.len() - 1 {
+            let (s, e) = (offs[i], offs[i + 1]);
+            let span = (e - 1) / PAGE_WORDS - s / PAGE_WORDS + 1;
+            assert!(span <= (e - s).div_ceil(PAGE_WORDS),
+                "doc {i} straddles after page-align");
+        }
+
+        // (a) exact search parity between aligned and unaligned dirs.
+        let dv_idx = MmapSeismicIndexDotVByte::from_mmap(&dv_dir).expect("dv from_mmap");
+        let pa_idx = MmapSeismicIndexDotVByte::from_mmap(&pa_dir).expect("pa from_mmap");
+        for q in 0..20u64 {
+            let toks: Vec<String> = (0..8)
+                .map(|j| format!("t{}", (q * 251 + j * 97) % dim as u64))
+                .collect();
+            let vals: Vec<f32> = (0..8).map(|j| 1.0 + j as f32 * 0.3).collect();
+            let dv_res = dv_idx.search_raw(&toks, &vals, 10, 8, 0.8, true);
+            let pa_res = pa_idx.search_raw(&toks, &vals, 10, 8, 0.8, true);
+            assert_eq!(dv_res.len(), pa_res.len(), "result count mismatch at q{q}");
+            for (i, (d, p)) in dv_res.iter().zip(pa_res.iter()).enumerate() {
+                assert_eq!(d.vector, p.vector, "doc mismatch q{q} rank {i}");
+                assert_eq!(d.distance.distance(), p.distance.distance(),
+                    "score mismatch q{q} rank {i} (pad must be decode-transparent)");
+            }
+        }
+        eprintln!("dotvbyte_page_align_parity OK ({} docs, pad_words={})", n_docs, pad_words);
+    }
