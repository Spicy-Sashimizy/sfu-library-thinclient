+#[pyfunction]
+fn transcode_to_flat(src_bmp: PathBuf, dst_bmflat: PathBuf) -> PyResult<()> {
+    let load = std::env::var("BMP_LOAD").unwrap_or_default();
+    let (index, bfwd) = if load.eq_ignore_ascii_case("mmap") {
+        bmp::index::from_file_mmap(src_bmp)
+    } else {
+        bmp::index::from_file(src_bmp)
+    }
+    .expect("Index cannot be loaded.");
+    bmp::index::flat::write_flat(dst_bmflat, &index, &bfwd)
+        .map_err(|e| pyo3::exceptions::PyRuntimeError::new_err(format!("transcode failed: {e}")))?;
+    Ok(())
+}
