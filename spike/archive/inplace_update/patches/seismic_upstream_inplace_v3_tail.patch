+                return Err(inval("posting word with bits 48..63 set in a zero-patch dir".into()));
+            }
+            let start = ((w >> 16) & V3_START_MASK) as usize;
+            if let Some(&ts) = start_map.get(&start) {
+                let len = w & 0xFFFF;
+                let v2 = ((ts as u64) << 16) | len;
+                let v3 = (1u64 << 48) | v2;
+                pw.write_all_at(&v3.to_le_bytes(), at as u64)?;
