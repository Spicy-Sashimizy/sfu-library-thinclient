+/// constructor sniffs `manifest.json` `forward_format` and dispatches. Callers
+/// (`seismic_backend.py`, `sharded_seismic_backend.py`) need zero changes to
+/// serve a converted dotvbyte shard.
+enum AnyMmapIndex {
+    F16(MmapSeismicIndex),
+    DotVByte(MmapSeismicIndexDotVByte),
