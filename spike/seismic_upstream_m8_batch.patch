+    /// Build a synthetic index whose posting list for token `t0` splits into
+    /// fixed-size blocks of `block_size` docs.
+    ///
+    /// Every doc carries `t0`, so posting list 0 holds all `n_docs` docs. With
+    /// `BlockingStrategy::FixedSize` the boundaries are
+    /// `0, B, 2B, …, (n_docs/B − 1)·B, n_docs` (see
+    /// `PostingList::fixed_size_blocking`), so when `n_docs % B == 0` every
+    /// block is exactly `B` long, and otherwise the LAST block absorbs the
+    /// remainder (`B + n_docs % B`). A single-token query with `query_cut = 1`
+    /// scans only that list, and since each doc appears in it once, every block
+    /// contributes exactly its length as survivors to `evaluate_posting_block`.
+    ///
+    /// `t1` is carried by the even docs only (≈ half the corpus) so multi-term
+    /// queries can produce RAGGED survivor counts through the `visited` dedup.
+    fn build_fixed_block_index(block_size: usize, n_docs: usize) -> SeismicIndex<OwnedForward> {
+        let dim = 16usize;
+        let mut token_to_id_map = HashMap::new();
+        for i in 0..dim {
+            token_to_id_map.insert(format!("t{}", i), i);
+        }
+        let encoder = ScalarSparseQuantizer::<u16, f32, f16, DotProduct>::new(dim, dim);
+        let mut ds = SparseDatasetGrowable::new(encoder);
+        for i in 0..n_docs {
+            // t0 (shared, drives the posting list under test) + t1 on even docs
+            // + two spread tokens so the summaries are non-degenerate. Distinct
+            // t0 weights (step 0.01, distinctly representable in f16 near 1.0)
+            // keep the ranking total — no ties to make the comparison ambiguous.
+            let comps: Vec<u16> = {
+                let mut c = vec![0u16, 3 + (i % 4) as u16, 8 + (i % 5) as u16];
+                if i % 2 == 0 {
+                    c.push(1);
+                }
+                c.sort_unstable();
+                c.dedup();
+                c
+            };
+            let vals: Vec<f32> = comps
+                .iter()
+                .map(|&c| {
+                    if c == 0 {
+                        1.0 + i as f32 * 0.01
+                    } else {
+                        0.25 + (c as f32) * 0.05
+                    }
+                })
+                .collect();
+            ds.push(SparseVectorView::new(&comps, &vals));
+        }
+        let frozen: OwnedForward = ds.into();
+        let doc_mapping: Vec<String> = (0..n_docs).map(|i| format!("doc{}", i)).collect();
+        let config = Configuration::default()
+            .pruning_strategy(PruningStrategy::FixedSize { n_postings: n_docs })
+            .blocking_strategy(BlockingStrategy::FixedSize { block_size });
+        SeismicIndex::new(
+            frozen,
+            config,
+            Some(doc_mapping),
+            None::<Vec<Option<String>>>,
+            token_to_id_map,
+        )
+    }
