index 0000000..5fb8af3
--- /dev/null
+++ b/src/index/flat.rs
@@ -0,0 +1,491 @@
+//! R3 flat layout — the actual G2 cure.
+//!
+//! The stock BMP `.bmp` is `bincode(Index, BlockForwardIndex)`. That nested
+//! `BlockForwardIndex.data: Vec<Vec<(u16, Vec<(u8,u8)>)>>` is ~100% of the
+//! resident anonymous RAM (measured 1.86 GB for a 606 MB shard). bincode always
+//! materializes it owned, even when read from an mmap'd slice — so a buffer
+//! *source* swap can't cure the floor (R2, confirmed).
+//!
+//! This module stores the forward index **flat on disk** behind an offset table,
+//! mmaps the whole file, and decodes exactly **one block on demand** inside the
+//! search loop (`get_block`). The transient decoded block is dropped after
+//! `block_score`, so anonymous RAM = accumulator + one block (~KB), and the hot
+//! working set is reclaimable page cache, not a rising anon floor.
+//!
+//! Layout of a `.bmflat` (all little-endian; u64 offsets are absolute from the
+//! file start):
+//!
+//! ```text
+//!  HEADER (fixed 48 bytes)
+//!    magic:          [u8; 8]   b"BMFLAT\0\0"
+//!    version:        u32
+//!    num_documents:  u64
+//!    block_size:     u64       (b256 = 256)
+//!    num_blocks:     u64
+//!    compress_range: u8        (1 = range_maxes are Compressed, 0 = Raw)
+//!  OFFSET TABLE — num_blocks × u64   (byte offset of block i's flat encoding)
+//!  FORWARD REGION — per block, flat:
+//!      num_terms: u16
+//!      repeat num_terms: term_id:u16, num_pairs:u16, then num_pairs × (u8 off, u8 score)
+//!  INVERTED REGION (small, cache + offset-indexed, still mmap-backed):
+//!    num_terms: u64
+//!    termmap_len: u64, termmap bytes (fst::Map<Vec<u8>>)
+//!    documents: u64 count, then u64-len-prefixed UTF-8 strings
+//!    kth_score per term: num_terms × 3 u8
+//!    range_maxes: per term — Raw => u64 byte-len then bytes (zero-copy &[u8] view);
+//!                              Compressed => u64 count, then count × {u64 off, u8 score}
+//! ```
+//!
+//! Correctness (G1) is identical-by-construction: the search math is unchanged;
+//! only the *storage* of `BlockForwardIndex.data` and `range_maxes` moves from
+//! owned Vecs to mmap'd bytes decoded on demand.
+
+use crate::index::forward_index::BlockForwardIndex;
+use crate::index::inverted_index::Index;
+use crate::index::posting_list::{BlockData, CompressedBlock, PostingList};
+use crate::query::cursor::{RangeMaxScore, RangeMaxScoreCursor};
+use anyhow::{anyhow, Result};
+use memmap2::{Advice, Mmap};
+use std::fs::File;
+use std::path::Path;
+
+const MAGIC: &[u8; 8] = b"BMFLAT\0\0";
+const VERSION: u32 = 1;
+const HEADER_LEN: usize = 48;
+
+// --------------------------------------------------------------------------- //
+// Flat on-disk + in-memory views.
+
+/// Header parsed from the file.
+struct Header {
+    num_documents: u64,
+    block_size: usize,
+    num_blocks: u64,
+    compress_range: bool,
+}
+
+impl Header {
+    fn parse(buf: &[u8]) -> Result<Self> {
+        if buf.len() < HEADER_LEN {
+            return Err(anyhow!("flat file too short"));
+        }
+        if &buf[0..8] != MAGIC {
+            return Err(anyhow!("bad flat magic"));
+        }
+        let version = u32::from_le_bytes(buf[8..12].try_into().unwrap());
+        if version != VERSION {
+            return Err(anyhow!("unsupported flat version {version}"));
+        }
+        Ok(Header {
+            num_documents: u64::from_le_bytes(buf[12..20].try_into().unwrap()),
+            block_size: u64::from_le_bytes(buf[20..28].try_into().unwrap()) as usize,
+            num_blocks: u64::from_le_bytes(buf[28..36].try_into().unwrap()),
+            compress_range: buf[36] != 0,
+        })
+    }
+}
+
+/// A mmap-backed flat index. `forward` is the whole file; block decode reads
+/// through `&self.forward`. The inverted side is small + owned/decoded-once.
+pub struct FlatIndex {
+    forward: Mmap,
+    num_documents: usize,
+    block_size: usize,
+    num_blocks: usize,
+    /// Byte offsets of each block's flat encoding. Length = num_blocks + 1
+    /// (trailing = end of forward region) so block length = next - cur.
+    block_offsets: Vec<u64>,
+    // --- owned inverted structures (small; the cure target was the forward idx) ---
+    documents: Vec<String>,
+    /// FST term -> term_id, generalized to expose cursor iteration.
+    terms: Vec<String>, // built only if a cursor API is needed
+    termmap: fst::Map<Vec<u8>>,
+    range_maxes: Vec<PostingList>,
+}
+
+// Small temporary reader over the forward region.
+impl FlatIndex {
+    /// Open `path` and lazily mmap it. Anonymous RAM after this call = the small
+    /// inverted structures only (termmap FST bytes, documents, range_maxes) —
+    /// NOT the forward index (that stays in the page cache, reclaimable).
+    pub fn open<P: AsRef<Path>>(path: P) -> Result<Self> {
+        let file = File::open(path)?;
+        // SAFETY: `.bmflat` is an immutable build artifact; read-only.
+        let forward = unsafe { Mmap::map(&file)? };
+        // Hint the whole mapping as a likely-future read so the kernel can begin
+        // populating the page cache; cold faults still work regardless.
+        let _ = forward.advise(Advice::WillNeed);
+        Self::from_mmap(forward)
+    }
+
+    fn from_mmap(forward: Mmap) -> Result<Self> {
+        let hdr = Header::parse(&forward[..])?;
+        let num_blocks = hdr.num_blocks as usize;
+        let buf = &forward[..];
+
+        // Offset table starts right after the header.
+        let off_base = HEADER_LEN;
+        let table_end = off_base + num_blocks * 8;
+        if buf.len() < table_end {
+            return Err(anyhow!("flat: offset table truncated"));
+        }
+        let mut block_offsets: Vec<u64> = (0..num_blocks)
+            .map(|i| {
+                let s = off_base + i * 8;
+                u64::from_le_bytes(buf[s..s + 8].try_into().unwrap())
+            })
+            .collect();
+        // Trailing end-of-region for block-length math.
+        // (We'll fix this up after we know where the inverted region starts.)
+
+        // The forward region spans [first_offset .. inv_off). We don't yet know
+        // inv_off, so the trailing sentinel is filled from the inverted header.
+
+        // Inverted region begins immediately after the last block's data. Find
+        // the max byte used by the forward region defensively: decode each
+        // block's length by walking it.
+        let inv_off = compute_forward_end(&forward, &block_offsets)?;
+        block_offsets.push(inv_off);
+
+        let ibuf = &buf[inv_off as usize..];
+        let mut p = 0usize;
+        let read_u64 = |b: &[u8], o: &mut usize| -> u64 {
+            let v = u64::from_le_bytes(b[*o..*o + 8].try_into().unwrap());
+            *o += 8;
+            v
+        };
+        let num_terms = read_u64(ibuf, &mut p) as usize;
+        let termmap_len = read_u64(ibuf, &mut p) as usize;
+        let termmap_bytes = ibuf[p..p + termmap_len].to_vec();
+        p += termmap_len;
+        let termmap = fst::Map::new(termmap_bytes)?;
+
+        let num_docs = read_u64(ibuf, &mut p) as usize;
+        let mut documents = Vec::with_capacity(num_docs);
+        for _ in 0..num_docs {
+            let l = read_u64(ibuf, &mut p) as usize;
+            let s = std::str::from_utf8(&ibuf[p..p + l])?.to_string();
+            p += l;
+            documents.push(s);
+        }
+
+        // kth_score: num_terms × 3 u8 (only 3 are used but we stored 3).
+        let mut kth_scores: Vec<Vec<u8>> = Vec::with_capacity(num_terms);
+        for _ in 0..num_terms {
+            kth_scores.push(ibuf[p..p + 3].to_vec());
+            p += 3;
+        }
+
+        let mut range_maxes: Vec<PostingList> = Vec::with_capacity(num_terms);
+        if hdr.compress_range {
+            for t in 0..num_terms {
+                // Writer format (flat.rs write_flat, compressed arm):
+                //   [num_blocks: u64]
+                //   per block b: [num_pairs: u64][num_pairs × (off:u64, score:u8)]
+                let num_blocks_t = read_u64(ibuf, &mut p) as usize;
+                let mut blocks: Vec<CompressedBlock> = Vec::with_capacity(num_blocks_t);
+                for _ in 0..num_blocks_t {
+                    let num_pairs = read_u64(ibuf, &mut p) as usize;
+                    let mut max_scores: Vec<(usize, u8)> = Vec::with_capacity(num_pairs);
+                    for _ in 0..num_pairs {
+                        let off = read_u64(ibuf, &mut p) as usize;
+                        let score = ibuf[p];
+                        p += 1;
+                        max_scores.push((off, score));
+                    }
+                    blocks.push(CompressedBlock { max_scores });
+                }
+                range_maxes.push(PostingList::new(
+                    BlockData::Compressed(blocks),
+                    kth_scores[t].clone(),
+                ));
+            }
+        } else {
+            for t in 0..num_terms {
+                let len = read_u64(ibuf, &mut p) as usize;
+                range_maxes.push(PostingList::new(
+                    BlockData::Raw(ibuf[p..p + len].to_vec()),
+                    kth_scores[t].clone(),
+                ));
+                p += len;
+            }
+        }
+
+        Ok(FlatIndex {
+            forward,
+            num_documents: hdr.num_documents as usize,
+            block_size: hdr.block_size,
+            num_blocks,
+            block_offsets,
+            documents,
+            terms: Vec::new(),
+            termmap,
+            range_maxes,
+        })
+    }
+
+    pub fn num_documents(&self) -> usize {
+        self.num_documents
+    }
+    pub fn block_size(&self) -> usize {
+        self.block_size
+    }
+    pub fn num_blocks(&self) -> usize {
+        self.num_blocks
+    }
+    pub fn documents(&self) -> &Vec<String> {
+        &self.documents
+    }
+
+    /// Decode exactly one block on demand. The returned Vec is transient (freed
+    /// after the caller scores it). This is the cure: no full forward index is
+    /// ever resident.
+    pub fn get_block(&self, block: usize) -> Vec<(u16, Vec<(u8, u8)>)> {
+        let buf = &self.forward[..];
+        let start = self.block_offsets[block] as usize;
+        let end = self.block_offsets[block + 1] as usize;
+        let region = &buf[start..end];
+        let mut p = 0usize;
+        let num_terms = u16::from_le_bytes(region[p..p + 2].try_into().unwrap()) as usize;
+        p += 2;
+        let mut out = Vec::with_capacity(num_terms);
+        for _ in 0..num_terms {
+            let term_id = u16::from_le_bytes(region[p..p + 2].try_into().unwrap());
+            p += 2;
+            let num_pairs = u16::from_le_bytes(region[p..p + 2].try_into().unwrap()) as usize;
+            p += 2;
+            // (u8, u8) packed: we stored doc_off then score, each u8.
+            let mut pairs = Vec::with_capacity(num_pairs);
+            let chunk = &region[p..p + num_pairs * 2];
+            p += num_pairs * 2;
+            for pair in chunk.chunks_exact(2) {
+                pairs.push((pair[0], pair[1]));
+            }
+            out.push((term_id, pairs));
+        }
+        out
+    }
+
+    /// Get a cursor like the stock Index (so the existing search wiring works).
+    pub fn get_cursor(&self, term: &str, term_weight: u32) -> Option<FlatPostingListIter> {
+        let position = self.termmap.get(term)? as usize;
+        Some(FlatPostingListIter::new(
+            &self.range_maxes[position],
+            position as u32,
+            term_weight,
+        ))
+    }
+
+    /// Advise the OS to prefetch a block's bytes into the page cache ahead of
+    /// `get_block`. Cheap; the actual decode still happens on demand. Replaces
+    /// stock's `_mm_prefetch` on the owned `Vec` pointer (which doesn't exist
+    /// here — the bytes live in the mmap).
+    pub fn prefetch_block(&self, block: u32) {
+        // Per-block `posix_fadvise(WILLNEED)` would need the raw backing fd,
+        // which memmap2 0.9's safe `Mmap` doesn't expose. The whole-mapping
+        // `WillNeed` applied at open() already hints the kernel to read-ahead;
+        // block-specific prefetch is a cold-p95 (R1) optimization we can add
+        // later via an `MmapRaw`/fd path if G3 needs it. No-op for now keeps
+        // correctness identical to stock (which only prefetches as an opt).
+        let _ = block;
+    }
+}
+
+/// Walk the forward region block-by-block to find where it ends (the inverted
+/// region offset). Defensive: never trusts a stored end pointer.
+fn compute_forward_end(buf: &Mmap, block_offsets: &[u64]) -> Result<u64> {
+    let mut end = 0u64;
+    for (i, &off) in block_offsets.iter().enumerate() {
+        let mut p = off as usize;
+        let num_terms = u16::from_le_bytes(buf[p..p + 2].try_into().unwrap()) as usize;
+        p += 2;
+        for _ in 0..num_terms {
+            p += 2; // term_id
+            let num_pairs = u16::from_le_bytes(buf[p..p + 2].try_into().unwrap()) as usize;
+            p += 2;
+            p += num_pairs * 2;
+        }
+        end = end.max(p as u64);
+    }
+    Ok(end)
+}
+
+// --------------------------------------------------------------------------- //
+// Cursor shim so the existing search wiring (which expects PostingListIterator)
+// is reusable. We wrap a PostingList — same interface, same behavior.
+
+#[derive(Clone, Copy)]
+pub struct FlatPostingListIter<'a> {
+    pl: &'a PostingList,
+    term_id: u32,
+    term_weight: u32,
+}
+impl<'a> FlatPostingListIter<'a> {
+    pub fn new(pl: &'a PostingList, term_id: u32, term_weight: u32) -> Self {
+        FlatPostingListIter {
+            pl,
+            term_id,
+            term_weight,
+        }
+    }
+    pub fn kth(&self, k: usize) -> u8 {
+        self.pl.kth(k)
+    }
+    pub fn term_weight(&self) -> u8 {
+        self.term_weight as u8
+    }
+    pub fn term_id(&self) -> u32 {
+        self.term_id
+    }
+}
+
+impl crate::query::cursor::Cursor for FlatPostingListIter<'_> {
+    type Value = u32;
+    type Error = ();
+    fn reset(&mut self) {}
+}
+impl<'a> RangeMaxScoreCursor for FlatPostingListIter<'a> {
+    fn range_max_scores(&self) -> RangeMaxScore<'a> {
+        match self.pl.range_maxes() {
+            BlockData::Compressed(cb) => RangeMaxScore::Compressed(&cb[..]),
+            BlockData::Raw(rb) => RangeMaxScore::Raw(&rb[..]),
+        }
+    }
+}
+
+// --------------------------------------------------------------------------- //
+// Transcoder: serializes an existing in-memory (Index, BlockForwardIndex)
+// — produced by the stock bincode loader — into the flat layout. This is how
+// we reuse the existing build (no corpus re-encode): load owned, then transcode.
+
+/// Write `index` + `bfwd` to `path` in the flat layout. The forward index is
+/// flattened per-block; the inverted side is serialized compactly.
+pub fn write_flat<P: AsRef<Path>>(
+    path: P,
+    index: &Index,
+    bfwd: &BlockForwardIndex,
+) -> Result<()> {
+    use std::io::{BufWriter, Write};
+    let p = path.as_ref();
+    let f = File::create(p)?;
+    let mut w = BufWriter::new(f);
+
+    let num_blocks = bfwd.data.len();
+    let block_size = bfwd.block_size;
+    // Compressed if the first term's range_maxes is BlockData::Compressed.
+    let compress_range = match index.posting_lists().first() {
+        Some(p) => matches!(p.range_maxes(), BlockData::Compressed(_)),
+        None => false,
+    };
+
+    // --- Pass 1: encode forward blocks, collecting their offsets. ---
+    let mut block_blobs: Vec<Vec<u8>> = Vec::with_capacity(num_blocks);
+    for block in &bfwd.data {
+        let mut buf = Vec::new();
+        let num_terms = block.len() as u16;
+        buf.extend_from_slice(&num_terms.to_le_bytes());
+        for (term_id, pairs) in block {
+            buf.extend_from_slice(&term_id.to_le_bytes());
+            let np = pairs.len() as u16;
+            buf.extend_from_slice(&np.to_le_bytes());
+            for (off, score) in pairs {
+                buf.push(*off);
+                buf.push(*score);
+            }
+        }
+        block_blobs.push(buf);
+    }
+
+    // --- Header ---
+    w.write_all(MAGIC)?;
+    w.write_all(&VERSION.to_le_bytes())?;
+    w.write_all(&(index.num_documents() as u64).to_le_bytes())?;
+    w.write_all(&(block_size as u64).to_le_bytes())?;
+    w.write_all(&(num_blocks as u64).to_le_bytes())?;
+    w.write_all(&[if compress_range { 1u8 } else { 0u8 }])?;
+    // Pad header to 48 bytes (we've written 8+4+8+8+8+1 = 37).
+    w.write_all(&[0u8; HEADER_LEN - 37])?;
+
+    // --- Offset table placeholders (num_blocks × u64), filled after we know offsets. ---
+    let offset_table_pos = HEADER_LEN;
+    let offset_table_len = num_blocks * 8;
+    // Write zeros, remember position, fill after forward region.
+    w.write_all(&vec![0u8; offset_table_len])?;
+
+    // --- Forward region: write blocks, recording absolute offsets. ---
+    let mut abs = (offset_table_pos + offset_table_len) as u64;
+    let mut offsets: Vec<u64> = Vec::with_capacity(num_blocks);
+    for blob in &block_blobs {
+        offsets.push(abs);
+        w.write_all(blob)?;
+        abs += blob.len() as u64;
+    }
+
+    // --- Inverted region (small). ---
+    let pls = index.posting_lists();
+    let num_terms = pls.len() as u64;
+    w.write_all(&num_terms.to_le_bytes())?;
+    // termmap FST bytes
+    let termmap_bytes = index.fst_bytes();
+    w.write_all(&(termmap_bytes.len() as u64).to_le_bytes())?;
+    w.write_all(&termmap_bytes)?;
+    // documents
+    let docs = index.documents();
+    w.write_all(&(docs.len() as u64).to_le_bytes())?;
+    for d in docs {
+        let b = d.as_bytes();
+        w.write_all(&(b.len() as u64).to_le_bytes())?;
+        w.write_all(b)?;
+    }
+    // kth_score: write 3 u8 per term (kth() indexes 0..3)
+    for pl in pls {
+        let kth = pl.kth_score_bytes();
+        // stock stores exactly 3 (s10/s100/s1000); pad if a writer ever sent more/fewer.
+        let mut buf = [0u8; 3];
+        for (i, &v) in kth.iter().take(3).enumerate() {
+            buf[i] = v;
+        }
+        w.write_all(&buf)?;
+    }
+    // range_maxes
+    for pl in pls {
+        match pl.range_maxes() {
+            BlockData::Raw(bytes) => {
+                w.write_all(&(bytes.len() as u64).to_le_bytes())?;
+                w.write_all(bytes)?;
+            }
+            BlockData::Compressed(blocks) => {
+                // Each block max_scores is Vec<(usize, u8)>. Flatten with count.
+                // Reconstruct the per-block list (we stored CompressedBlock per
+                // superblock during build). The stock serialize keeps them as
+                // Vec<CompressedBlock>; mirror that exactly here.
+                w.write_all(&(blocks.len() as u64).to_le_bytes())?;
+                for b in blocks {
+                    // We collapse max_scores pairs: store count then pairs.
+                    w.write_all(&(b.max_scores.len() as u64).to_le_bytes())?;
+                    for (off, score) in &b.max_scores {
+                        w.write_all(&(*off as u64).to_le_bytes())?;
+                        w.write_all(&[*score])?;
+                    }
+                }
+            }
+        }
+    }
+
+    // --- Patch the offset table with the real offsets. ---
+    w.flush()?;
+    drop(w);
+    patch_offset_table(p, &offsets)?;
+
+    Ok(())
+}
+
+fn patch_offset_table(path: &Path, offsets: &[u64]) -> Result<()> {
+    use std::io::{Seek, SeekFrom, Write};
+    let mut f = std::fs::OpenOptions::new().read(true).write(true).open(path)?;
+    f.seek(SeekFrom::Start(HEADER_LEN as u64))?;
+    for off in offsets {
+        f.write_all(&off.to_le_bytes())?;
+    }
+    Ok(())
+}
