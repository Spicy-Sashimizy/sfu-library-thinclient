+    pub fn unit_view(&self, t: usize, off: u64) -> Result<Arc<MmapPostingList<'static>>, String> {
+        if let Some(v) = self.unit_cache.lock().unwrap().get(&(t, off)) {
+            return Ok(v.clone());
+        }
+        let v = Arc::new(self.build_unit_view(t, off)?);
+        let mut c = self.unit_cache.lock().unwrap();
+        if c.len() >= 4096 {
