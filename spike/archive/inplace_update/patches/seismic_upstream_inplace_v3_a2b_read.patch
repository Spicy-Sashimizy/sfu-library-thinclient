+    /// Parse, verify (checksum) and build the view of the A2b unit at `off`
+    /// for list `t` (FORMAT_V3.md §3.6, revision 3). Uncached.
+    pub fn build_unit_view(&self, t: usize, off: u64) -> Result<MmapPostingList<'static>, String> {
+        if off < self.pl_len {
+            return Err(format!("list {t}: unit offset {off} is inside posting_lists.bin"));
+        }
+        let h = (off - self.pl_len) as usize;
+        if h % 8 != 0 || h + UNIT_HEADER > self.posting_heap.len() {
+            return Err(format!("list {t}: unit offset {off} misaligned or beyond the heap"));
+        }
+        let heap: &'static [u8] = self.posting_heap;
+        let hdr = &heap[h..h + UNIT_HEADER];
+        let u64_at = |o: usize| u64::from_le_bytes(hdr[o..o + 8].try_into().unwrap());
+        if u64_at(0) != UNIT_MAGIC {
+            return Err(format!("list {t}: bad unit magic at {off}"));
+        }
+        if u32::from_le_bytes(hdr[8..12].try_into().unwrap()) as usize != t {
+            return Err(format!("list {t}: unit at {off} belongs to another list"));
+        }
+        let body_len = u64_at(16) as usize;
+        if h + UNIT_HEADER + body_len > heap.len() {
+            return Err(format!("list {t}: unit body beyond the heap"));
+        }
+        let body: &'static [u8] = &heap[h + UNIT_HEADER..h + UNIT_HEADER + body_len];
+        let ck = fnv1a64_update(fnv1a64(&hdr[0..UNIT_CKSUM_AT]), body);
+        if ck != u64_at(UNIT_CKSUM_AT) {
+            return Err(format!("list {t}: unit checksum mismatch at {off}"));
+        }
+        let mut sc = [0u64; UNIT_SCALARS];
+        for (i, x) in sc.iter_mut().enumerate() {
+            *x = u64_at(24 + 8 * i);
+        }
+        let view = posting_list_view_from_unit(body, &sc)?;
+        if view.n_blocks() > UNIT_MAX_BLOCKS {
+            return Err(format!("list {t}: unit has {} blocks", view.n_blocks()));
+        }
+        for w in view.posting_words() {
+            if v3_range(w).end > self.fdw {
+                return Err(format!("list {t}: unit posting beyond forward_data"));
+            }
+        }
+        Ok(view)
+    }
