+use num_traits::FromPrimitive;
+
+// ── Cross-platform page-cache / residency hooks (PORTABLE_SOCSCI §7) ──────────
+// The F3–F6 prefault / mlock / madvise optimizations are POSIX-only. They are
+// pure *performance* hints over a read-only mmap — correctness-neutral, since the
+// OS demand-pages the mapping identically without them. Funnelling every `libc`
+// syscall through these two shims lets the engine cross-compile for native
+// Windows x86-64 (the portable social-sciences thumb-drive bundle): real
+// syscalls on unix, no-ops elsewhere (Windows accepts slower cold faults; the
+// prefault/pin tier simply does not apply). Correctness on Linux is unchanged —
+// the shim expands to the exact prior `libc::` calls under `#[cfg(unix)]`.
+// See docs/infrastructure/PORTABLE_SOCSCI_WINDOWS_BUNDLE.md §7.
+#[derive(Clone, Copy)]
+enum Advice { WillNeed, Sequential, DontNeed, Random }
+
+/// `madvise(2)` on a read-only mmap range; no-op on non-unix.
+///
+/// Returns the raw `madvise` status: `0` on success, non-zero on failure (the
+/// caller reads `errno` only for diagnostics; we never panic on it). F5 fix
+/// 2026-08-31: the return value is now *load-bearing* for the DONTNEED paths —
+/// `MADV_DONTNEED` EINVALs on `mlock`ed ranges (doc 02 §4), and the original F5
+/// hook counted the advised length unconditionally, which is how the 2026-07-14
+/// cell reported "released 16.45 GB" while RssFile did not move. Bytes are now
+/// only accounted when the syscall actually succeeded.
+#[cfg(unix)]
+#[inline]
+unsafe fn os_madvise(ptr: *mut core::ffi::c_void, len: usize, advice: Advice) -> i32 {
+    let a = match advice {
+        Advice::WillNeed => libc::MADV_WILLNEED,
+        Advice::Sequential => libc::MADV_SEQUENTIAL,
+        Advice::DontNeed => libc::MADV_DONTNEED,
+        Advice::Random => libc::MADV_RANDOM,
+    };
+    unsafe { libc::madvise(ptr, len, a) as i32 }
+}
+/// Non-unix: nothing is advised, so report failure — callers then account 0
+/// bytes released (the residency tier degrades to a no-op, never a false
+/// "released" number).
+#[cfg(not(unix))]
+#[inline]
+unsafe fn os_madvise(_ptr: *mut core::ffi::c_void, _len: usize, _advice: Advice) -> i32 { -1 }
+
+/// `mlock(2)` on a read-only mmap range. Returns 0 on success (unix). On non-unix
+/// returns -1 so callers record 0 bytes locked (the pin tier degrades to no-op).
+#[cfg(unix)]
+#[inline]
+unsafe fn os_mlock(ptr: *const core::ffi::c_void, len: usize) -> i32 {
+    unsafe { libc::mlock(ptr, len) as i32 }
+}
+#[cfg(not(unix))]
+#[inline]
+unsafe fn os_mlock(_ptr: *const core::ffi::c_void, _len: usize) -> i32 { -1 }
+
+// ---------------------------------------------------------------------------
+// Manifest types (serde_json; the only structured format — all data is flat raw)
+// ---------------------------------------------------------------------------
+
+/// Per-posting-list manifest entry. Records where each flat slice lives in its
+/// file + the scalars the reader needs to reconstruct `EliasFanoView`/`BitFieldSlice`.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+struct PostingListManifest {
+    // packed_postings: &[u64] (PackedPostingBlock is #[repr(transparent] over u64)
+    packed_postings_words: usize,
+    // block_offsets: &[usize]
+    block_offsets_len: usize,
+    // summaries — flat fields
+    n_summaries: usize,
+    dim: usize,
+    has_component_ids: bool,
+    component_ids_len: usize, // in elements (u16)
+    values_len: usize,       // in u8 elements
+    minimums_len: usize,     // in f32 elements
+    quants_len: usize,       // in f32 elements
+    summaries_ids_field_width: u8,
+    summaries_ids_n_bits: usize,
+    summaries_ids_n_words: usize,
+    // EliasFano offsets
+    ef_high_bits_n_bits: usize,
+    ef_high_bits_n_words: usize,
+    ef_low_bits_field_width: u8,
+    ef_low_bits_n_bits: usize,
+    ef_low_bits_n_words: usize,
+    ef_low_len: usize,
+    ef_universe: usize,
+    ef_num_vals: usize,
+    // Inventories for the DArray<false> (high_bits)
+    inv_n_sets: usize,
+    inv_block_inventory_len: usize, // i64
+    inv_subblock_inventory_len: usize, // u16
+    inv_overflow_positions_len: usize, // usize
+}
+
+/// Top-level manifest.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct MmapManifest {
+    n_posting_lists: usize,
+    forward_offsets_len: usize,   // usize
+    forward_components_len: usize, // u16 (f16 layout; 0 in dotvbyte layout)
+    forward_values_len: usize,      // f16 (f16 layout; 0 in dotvbyte layout)
+    n_docs: usize,
+    posting_lists: Vec<PostingListManifest>,
+    /// Has the Knn graph (serialized separately via bincode, the one non-flat piece).
+    has_knn: bool,
+    config_json: String, // serde_json of Configuration
+    /// E7 (2026-07-02): forward-index format switch. Absent/None ⇒ the original
+    /// two-file f16 layout; `Some("dotvbyte_fixedu8")` ⇒ compressed packed
+    /// layout (`forward_offsets.bin` word offsets + `forward_data.bin` u64
+    /// words + `forward_encoder.bin` bincode'd `DotVByteFixedU8Encoder`).
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    forward_format: Option<String>,
+    /// E7: u64 word count of `forward_data.bin` (dotvbyte layout only).
+    #[serde(default)]
+    forward_data_words: usize,
+    /// E7: total nnz across docs (dotvbyte layout only — the f16 layout reads
+    /// it off `forward_components_len`).
+    #[serde(default)]
+    forward_nnz: usize,
+    /// E7 Fix #5 (2026-07-03): true when `forward_data.bin` was written with
+    /// page-boundary-aware record placement (no record straddles a 4 KiB page
+    /// unless longer than one page). Provenance only — the reader is layout-
+    /// transparent because the padding lives INSIDE the previous record, before
+    /// its end-anchored SIMD values tail (see `page_align_packed_forward`).
+    #[serde(default)]
+    forward_page_aligned: bool,
+    /// E5 (2026-07-09): provenance of a forward-reorder pass (`reorder_mmap_dir`)
+    /// — the ordering-method name (e.g. "block_walk_canonical"). Absent/None ⇒
+    /// build/insertion order. Provenance only: packs carry absolute offsets, so
+    /// the reader is order-transparent (doc 13 §2.2).
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    forward_reordered: Option<String>,
+    /// Q1 E8 dv-v2 (2026-07-10): the per-doc-value-scale format version of a
+    /// dotvbyte dir's record envelope. 1 (default when absent) = the shipped
+    /// FixedU8Q global-1/64 scale (v1); 2 = the SFR1 per-doc linear u8 scale
+    /// (v2: store u8=round(v/vmax_doc*255) + a per-doc f16 vmax_doc, dequant
+    /// u8/255*vmax_doc). Decouples format-name from record-envelope version —
+    /// `forward_format` stays "dotvbyte_fixedu8" for both; this field is the
+    /// load-bearing tag the reader branches on so a v1 reader refuses a v2 dir
+    /// (and vice versa) loudly, never a silent mis-decode. Absent on all
+    /// pre-Q1 dirs ⇒ defaults to 1 (v1, bit-identical load path unchanged).
+    #[serde(default = "one_u32")]
+    forward_format_version: u32,
+}
+
+fn one_u32() -> u32 { 1 }
+
+impl MmapManifest {
+    /// E7: which forward layout this dir carries.
+    pub fn is_dotvbyte(&self) -> bool {
+        self.forward_format.as_deref() == Some("dotvbyte_fixedu8")
+    }
+    /// Q1 E8: is this a dv-v2 (per-doc-scale) dotvbyte dir? v1 dirs carry no
+    /// version field (defaults to 1) or an explicit 1; v2 dirs carry 2. The
+    /// reader uses this to pick the dequant kernel (1/64 global vs per-doc
+    /// vmax/255) AND to cross-reject (a v1-only reader refuses a v2 dir).
+    pub fn is_dotvbyte_v2(&self) -> bool {
+        self.is_dotvbyte() && self.forward_format_version == 2
+    }
+    /// Q1 E8: the forward record-envelope version (1 = v1 FixedU8Q, 2 = v2
+    /// per-doc). Exposed for the reader's cross-version rejection message.
+    pub fn forward_format_version(&self) -> u32 {
+        self.forward_format_version
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Writer
+// ---------------------------------------------------------------------------
+
+/// Write a built in-RAM `SeismicIndex<OwnedForward>` to raw flat files under
+/// `dir/`. All four components serialized via `bytemuck::cast_slice` (zero-decode
+/// on read); the `EliasFano`/`BitField` backing words are written natively. A
+/// JSON manifest records per-list file offsets + the scalars the reader needs.
+///
+/// Files written: `forward_offsets.bin`, `forward_components.bin`,
+/// `forward_values.bin`, `posting_lists.bin` (concatenated; offsets in manifest),
+/// `manifest.json`, `config.json`, `knn.bin` (optional, bincode — the one non-flat).
+pub fn write_mmap_index(
+    index: &SeismicIndex<OwnedForward>,
+    dir: &Path,
+) -> Result<MmapManifest, std::io::Error> {
+    std::fs::create_dir_all(dir)?;
+    let inverted: &InvertedIndexBase<OwnedForward> = index.inverted_index();
+    let forward: &OwnedForward = inverted.dataset();
+
+    // ---- forward index: offsets &[usize], components &[u16], values &[f16] ----
+    // Access via the SparseStorage trait (offsets()/components()/values() return
+    // &Box<[T]> which derefs to &[T]).
+    use vectorium::core::storage::SparseStorage;
+    let fwd_offsets: &[usize] = forward.storage().offsets().as_ref();
+    let fwd_components: &[u16] = forward.storage().components().as_ref();
+    let fwd_values: &[f16] = forward.storage().values().as_ref();
+
+    write_pod_slice(&dir.join("forward_offsets.bin"), fwd_offsets)?;
+    write_pod_slice(&dir.join("forward_components.bin"), fwd_components)?;
+    write_pod_slice(&dir.join("forward_values.bin"), fwd_values)?;
+
+    // ---- posting lists ----
+    let posting_lists: &[PostingList<u16>] = inverted.posting_lists();
+    let mut pl_manifests = Vec::with_capacity(posting_lists.len());
+
+    // Single concatenated file for all posting lists' flat slices, in a fixed
+    // per-list layout. The manifest records lengths; the reader re-slices one
+    // big mmap region. Layout per list (in order):
+    //   packed_postings (u64 words), block_offsets (usize),
+    //   ef_high_bits_words (u64), inv_block_inventory (i64),
+    //   inv_subblock_inventory (u16), inv_overflow_positions (usize),
+    //   ef_low_bits_words (u64), summaries_ids_words (u64),
+    //   values (u8), minimums (f32), quants (f32), component_ids (u16)?
+    let mut pl_buf: Vec<u8> = Vec::new();
+    // Track file byte offsets per slice so the manifest can record them.
+    let mut cursor: usize = 0;
+
+    for pl in posting_lists {
+        // PackedPostingBlock is #[repr(transparent)] over a single u64 field, so
+        // &[PackedPostingBlock] and &[u64] have identical layout — cast via bytemuck.
+        let pp: &[crate::posting_list::PackedPostingBlock] = pl.packed_postings().as_ref();
+        let pp: &[u64] = bytemuck::cast_slice(pp);
+        let pp_words = pp.len();
+        extend_pod(&mut pl_buf, pp);
+        cursor += pp_words * std::mem::size_of::<u64>();
+
+        let bo: &[usize] = pl.block_offsets().as_ref();
+        let bo_len = bo.len();
+        extend_pod(&mut pl_buf, bo);
+
+        let summaries: &QuantizedSummary<u16> = pl.summaries();
+        let n_summaries = summaries.n_summaries();
+        let dim = summaries.dim();
+        let values: &[u8] = summaries.values();
+        let minimums: &[f32] = summaries.minimums();
+        let quants: &[f32] = summaries.quants();
+
+        // EliasFano offsets
+        let ef: &EliasFano = summaries.offsets();
+        let high: &DArray = ef.high_bits();
+        let high_bv = high.bv();
+        let high_words: &[u64] = high_bv.words();
+        let ef_high_bits_n_bits = high_bv.len();
+        let ef_high_bits_n_words = high_words.len();
+        extend_pod(&mut pl_buf, high_words);
+
+        // Inventories
+        let inv: &Inventories<true> = high.ones_inventories();
+        let inv_n_sets = inv.n_sets();
+        let block_inv: &[i64] = inv.block_inventory();
+        let subblock_inv: &[u16] = inv.subblock_inventory();
+        let overflow: &[usize] = inv.overflow_positions();
+        extend_pod(&mut pl_buf, block_inv);
+        extend_pod(&mut pl_buf, subblock_inv);
+        extend_pod(&mut pl_buf, overflow);
+
+        // low_bits BitField
+        let low_bits = ef.low_bits();
+        let low_bv = low_bits.bitvector();
+        let low_words: &[u64] = low_bv.words();
+        let ef_low_bits_field_width = low_bits.field_width();
+        let ef_low_bits_n_bits = low_bv.len();
+        let ef_low_bits_n_words = low_words.len();
+        extend_pod(&mut pl_buf, low_words);
+
+        let ef_low_len = ef.low_len();
+        let ef_universe = ef.universe();
+        let ef_num_vals = ef.num_vals();
+
+        // summaries_ids BitField
+        let sids = summaries.summaries_ids();
+        let sids_bv = sids.bitvector();
+        let sids_words: &[u64] = sids_bv.words();
+        let summaries_ids_field_width = sids.field_width();
+        let summaries_ids_n_bits = sids_bv.len();
+        let summaries_ids_n_words = sids_words.len();
+        extend_pod(&mut pl_buf, sids_words);
+
+        // values / minimums / quants
+        extend_pod(&mut pl_buf, values);
+        extend_pod(&mut pl_buf, minimums);
+        extend_pod(&mut pl_buf, quants);
+
+        // component_ids (optional)
+        let has_component_ids = summaries.component_ids().is_some();
+        let component_ids_len = summaries.component_ids().map(|c| c.len()).unwrap_or(0);
+        if let Some(cids) = summaries.component_ids() {
+            extend_pod(&mut pl_buf, cids);
+        }
+
+        pl_manifests.push(PostingListManifest {
+            packed_postings_words: pp_words,
+            block_offsets_len: bo_len,
+            n_summaries,
+            dim,
+            has_component_ids,
+            component_ids_len,
+            values_len: values.len(),
+            minimums_len: minimums.len(),
+            quants_len: quants.len(),
+            summaries_ids_field_width,
+            summaries_ids_n_bits,
+            summaries_ids_n_words,
+            ef_high_bits_n_bits,
+            ef_high_bits_n_words,
+            ef_low_bits_field_width,
+            ef_low_bits_n_bits,
+            ef_low_bits_n_words,
+            ef_low_len,
+            ef_universe,
+            ef_num_vals,
+            inv_n_sets,
+            inv_block_inventory_len: block_inv.len(),
+            inv_subblock_inventory_len: subblock_inv.len(),
+            inv_overflow_positions_len: overflow.len(),
+        });
+    }
+    write_file(&dir.join("posting_lists.bin"), &pl_buf)?;
+
+    // ---- config ----
+    let config = inverted.config();
+    let config_json = serde_json::to_string(config)?;
+    write_file(&dir.join("config.json"), config_json.as_bytes())?;
+
+    // ---- knn (optional; bincode via the existing IndexSerializer) ----
+    let has_knn = inverted.knn().is_some();
+    if let Some(knn) = inverted.knn() {
+        // Knn has its own serialize(); mirror the existing path.
+        knn.serialize(dir.join("knn.bin").to_str().unwrap())?;
+    }
+
+    // ---- token_to_id_map (small, O(vocab), owned) ----
+    let token_map = index.token_to_id_map();
+    {
+        let bin_cfg = bincode::config::standard()
+            .with_fixed_int_encoding()
+            .with_little_endian();
+        let bytes = bincode::serde::encode_to_vec(token_map, bin_cfg)
+            .map_err(|e| std::io::Error::new(std::io::ErrorKind::Other, e))?;
+        write_file(&dir.join("token_to_id_map.bin"), &bytes)?;
+    }
+
+    // ---- document_mapping (C2: flat mmap'd string slab) ----
+    // Was: bincode'd Vec<String> decoded into Box<[String]> (per-doc heap alloc,
+    // the dominant C1a anon residual). Now: concatenated UTF-8 bytes + offsets
+    // (n_docs+1 usize offsets) so the reader borrows the slab zero-copy.
+    if let Some(doc_mapping) = index.document_mapping() {
+        let mut strings_buf: Vec<u8> = Vec::new();
+        let mut offsets: Vec<usize> = Vec::with_capacity(doc_mapping.len() + 1);
+        offsets.push(0);
+        for doc_id in doc_mapping.iter() {
+            strings_buf.extend_from_slice(doc_id.as_bytes());
+            offsets.push(strings_buf.len());
+        }
+        // Sanity: offsets monotonically non-decreasing.
+        debug_assert!(offsets.windows(2).all(|w| w[0] <= w[1]));
+        write_file(&dir.join("document_mapping_strings.bin"), &strings_buf)?;
+        write_pod_slice(&dir.join("document_mapping_offsets.bin"), &offsets)?;
+    }
+
+    let manifest = MmapManifest {
+        n_posting_lists: posting_lists.len(),
+        forward_offsets_len: fwd_offsets.len(),
+        forward_components_len: fwd_components.len(),
+        forward_values_len: fwd_values.len(),
+        n_docs: forward.len(),
+        posting_lists: pl_manifests,
+        has_knn,
+        config_json,
+        forward_format: None, // f16 two-file layout (the original)
+        forward_data_words: 0,
+        forward_nnz: 0,
+        forward_page_aligned: false,
+        forward_reordered: None, // build/insertion order
+        forward_format_version: 1, // Q1 E8: f16 layout is inherently v1
+    };
+    let manifest_json = serde_json::to_string_pretty(&manifest)?;
+    write_file(&dir.join("manifest.json"), manifest_json.as_bytes())?;
+    Ok(manifest)
+}
+
+fn write_file(path: &Path, bytes: &[u8]) -> std::io::Result<()> {
+    let mut f = File::create(path)?;
+    f.write_all(bytes)?;
+    Ok(())
+}
+
+fn write_pod_slice<T: Pod>(path: &Path, slice: &[T]) -> std::io::Result<()> {
+    let bytes: &[u8] = bytemuck::cast_slice(slice);
+    write_file(path, bytes)
+}
+
+fn extend_pod<T: Pod>(buf: &mut Vec<u8>, slice: &[T]) {
+    // C1a (2026-06-27): pad the buffer to T's alignment before appending, so
+    // the reader's `bytemuck::cast_slice` over the mmap'd buffer finds each
+    // slice naturally aligned (concatenating mixed-type slices back-to-back
+    // would otherwise misalign e.g. an i64 slice following a u64 region whose
+    // length isn't a multiple of 8). The padding bytes (zeros) are skipped by
+    // the reader (it walks the layout via the manifest's per-slice lengths).
+    let align = std::mem::align_of::<T>();
+    let cur = buf.len();
+    let pad = (align - (cur % align)) % align;
+    buf.extend(std::iter::repeat_n(0u8, pad));
+    let bytes: &[u8] = bytemuck::cast_slice(slice);
+    buf.extend_from_slice(bytes);
+}
+
+// ---------------------------------------------------------------------------
+// MmapSeismicIndex — reader
+// ---------------------------------------------------------------------------
+
+/// The mmap-backed whole index. The `Mmap` handle is `Box::leak`'d (spike-only;
+/// see module docs) so the borrowed views take `'static` lifetimes. All four
+/// SEISMIC components read zero-decode off reclaimable file cache.
+pub struct MmapSeismicIndex {
+    // Leaked handles (spike-only). Keep them as fields so the struct owns them
+    // conceptually even though the Borrows view into their (now 'static) bytes.
+    _forward_offsets_mmap: &'static [u8],
+    // E7 Fix #4 (2026-07-03): the f16 forward's two elephant slabs
+    // (components + values, ~3.3 GB each = the codec the gate-c bar models) were
+    // leaked but their handles were NOT retained as fields — so `release_pages()`
+    // could only `MADV_DONTNEED` `forward_offsets.bin` (150 MB), leaving the
+    // 6.5 GB components+values resident across cold cycles. That made the cold-pass
+    // majflt baseline structurally asymmetric (f16's forward never re-faulted) and
+    // is the root of the floor the gate-c ratio Never reflected the codec under
+    // test. Retaining both handles lets `release_pages` evict them + lets
+    // `prefault_floor` skip them (the gate measures forward faults, not floor).
+    _forward_components_mmap: &'static [u8],
+    _forward_values_mmap: &'static [u8],
+    _postings_mmap: &'static [u8],
+    _doc_strings_mmap: Option<&'static [u8]>,
+    _doc_offsets_mmap: Option<&'static [u8]>,
+    forward: MmapForward<'static>,
+    posting_lists: Box<[MmapPostingList<'static>]>,
+    config: Configuration,
+    knn: Option<Box<Knn>>,
+    // C2: document_mapping is now a flat mmap'd string slab instead of
+    // Box<[String]>, eliminating the O(n_docs) per-doc allocation overhead that
+    // was the dominant anon residual in C1a (+0.186 GB).
+    doc_mapping: Option<MmapDocMapping<'static>>,
+    token_to_id_map: HashMap<String, usize>,
+}
+
+/// C2: borrowed view over a flat doc-mapping slab.
+/// `strings` is the concatenated UTF-8 bytes of all doc IDs; `offsets[i]` and
+/// `offsets[i+1]` delimit the byte range for doc `i`. No per-string heap alloc.
+#[derive(Clone, Copy)]
+pub struct MmapDocMapping<'a> {
+    strings: &'a [u8],
+    offsets: &'a [usize],
+}
+
+impl<'a> MmapDocMapping<'a> {
+    #[must_use]
+    pub const fn new(strings: &'a [u8], offsets: &'a [usize]) -> Self {
+        Self { strings, offsets }
+    }
+
+    /// Number of documents in the mapping.
+    #[inline]
+    pub fn len(&self) -> usize {
+        self.offsets.len().saturating_sub(1)
+    }
+
+    #[inline]
+    pub fn is_empty(&self) -> bool {
+        self.len() == 0
+    }
+
+    /// Return the doc ID string for `doc_idx` as a zero-copy `&str` slice into
+    /// the mmap'd string slab.
+    #[inline]
+    pub fn get(&self, doc_idx: usize) -> Option<&'a str> {
+        let start = *self.offsets.get(doc_idx)?;
+        let end = *self.offsets.get(doc_idx + 1)?;
+        let bytes = self.strings.get(start..end)?;
+        // Persona doc IDs are valid UTF-8 Strings upstream; debug_assert in case.
+        debug_assert!(
+            std::str::from_utf8(bytes).is_ok(),
+            "document_mapping contains non-UTF-8 bytes"
+        );
+        // SAFETY: doc IDs were written as UTF-8 Strings by write_mmap_index.
+        Some(unsafe { std::str::from_utf8_unchecked(bytes) })
+    }
+}
+
+impl MmapSeismicIndex {
+    /// Build from a directory written by `write_mmap_index`.
+    pub fn from_mmap(dir: &Path) -> Result<Self, std::io::Error> {
+        let manifest_json = std::fs::read_to_string(dir.join("manifest.json"))?;
+        let manifest: MmapManifest = serde_json::from_str(&manifest_json)
+            .map_err(|e| std::io::Error::new(std::io::ErrorKind::InvalidData, e))?;
+        if manifest.is_dotvbyte() {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::InvalidData,
+                "manifest says forward_format=dotvbyte_fixedu8 — load via MmapSeismicIndexDotVByte",
+            ));
+        }
+
+        // ---- forward index ----
+        // E7 Fix #2 (REFINED to dv-only after Arm C): MADV_RANDOM on the forward
+        // files QUADRUPLED f16's absolute faults (117k->437k) + worsened cold
+        // latency, even though the *ratio* bar passed. The dense-record benefit is
+        // real for dotvbyte but a net loss for f16 — so apply MADV_RANDOM only on
+        // the dotvbyte path, leave f16 on default advice. See Arm C anchor.
+        let fwd_mmap = leak_mmap_advise(dir.join("forward_offsets.bin"), false)?;
+        let fwd_offsets: &'static [usize] = bytemuck::cast_slice(fwd_mmap);
+        // The manifest records the length; verify.
+        debug_assert_eq!(fwd_offsets.len(), manifest.forward_offsets_len);
+
+        // components + values in separate files — leak+mmap each.
+        let fwd_components_mmap = leak_mmap_advise(dir.join("forward_components.bin"), false)?;
+        let fwd_components: &'static [u16] = bytemuck::cast_slice(fwd_components_mmap);
+        let fwd_values_mmap = leak_mmap_advise(dir.join("forward_values.bin"), false)?;
+        let fwd_values: &'static [f16] = bytemuck::cast_slice(fwd_values_mmap);
+
+        let fwd_storage = MmapSparseStorage::from_raw_parts(
+            fwd_offsets,
+            fwd_components,
+            fwd_values,
+        );
+        // The encoder is reconstructed from the config dim; use the manifest's
+        // n_docs for the dataset. The forward encoder needs input_dim = dim.
+        // We get dim from the first posting list's dim (all lists share it) or
+        // from the config. Use the first posting list's dim.
+        let dim = manifest.posting_lists.first().map(|m| m.dim).unwrap_or(0);
+        let encoder = ScalarSparseQuantizer::<u16, f32, f16, DotProduct>::new(dim, dim);
+        let forward: MmapForward<'static> =
+            SparseDatasetGeneric::from_raw_parts(fwd_storage, manifest.n_docs, encoder);
+
+        // ---- posting lists (shared reconstruction; E7 refactor, walk unchanged) ----
+        let pl_mmap = leak_mmap(dir.join("posting_lists.bin"))?;
+        let posting_lists = read_posting_lists(pl_mmap, &manifest);
+
+        // ---- config ----
+        let config: Configuration =
+            serde_json::from_str(&manifest.config_json)
+                .map_err(|e| std::io::Error::new(std::io::ErrorKind::InvalidData, e))?;
+
+        // ---- knn (optional, bincode via the existing path) ----
+        let knn = if manifest.has_knn {
+            Some(Box::new(Knn::new_from_serialized(
+                dir.join("knn.bin").to_str().unwrap(),
+                None,
+            )))
+        } else {
+            None
+        };
+
+        // ---- token_to_id_map (owned, O(vocab)) ----
+        let token_to_id_map = read_token_map(dir);
+
+        // ---- document_mapping (C2: flat mmap'd string slab) ----
+        let (doc_mapping, doc_strings_mmap, doc_offsets_mmap) = read_doc_mapping(dir)?;
+
+        Ok(Self {
+            _forward_offsets_mmap: fwd_mmap,
+            _forward_components_mmap: fwd_components_mmap,
+            _forward_values_mmap: fwd_values_mmap,
+            _postings_mmap: pl_mmap,
+            _doc_strings_mmap: doc_strings_mmap,
+            _doc_offsets_mmap: doc_offsets_mmap,
+            forward,
+            posting_lists: posting_lists.into_boxed_slice(),
+            config,
+            knn,
+            doc_mapping,
+            token_to_id_map,
+        })
+    }
+}
+
+/// E7 (2026-07-02): shared per-list reconstruction, extracted verbatim from
+/// `MmapSeismicIndex::from_mmap` so the compressed-forward reader
+/// (`MmapSeismicIndexDotVByte`) reuses the identical walk — the byte layout of
+/// `posting_lists.bin` is the same in both formats (the E7 converter rewrites
+/// only the packed-posting WORDS, never the layout).
+fn read_posting_lists(
+    pl_mmap: &'static [u8],
+    manifest: &MmapManifest,
+) -> Vec<MmapPostingList<'static>> {
+    let pl_bytes: &'static [u8] = pl_mmap;
+    let mut cursor: usize = 0;
+    let mut posting_lists: Vec<MmapPostingList<'static>> =
+        Vec::with_capacity(manifest.n_posting_lists);
+
+    for plm in &manifest.posting_lists {
+            // packed_postings (u64) — read as u64 then cast to PackedPostingBlock
+            // (#[repr(transparent)] over u64, identical layout).
+            let pp_u64: &'static [u64] = read_pod(&pl_bytes, &mut cursor, plm.packed_postings_words);
+            let pp: &'static [crate::posting_list::PackedPostingBlock] = unsafe {
+                std::slice::from_raw_parts(pp_u64.as_ptr() as *const _, pp_u64.len())
+            };
+
+            // block_offsets (usize)
+            let bo: &'static [usize] = read_pod(&pl_bytes, &mut cursor, plm.block_offsets_len);
+
+            // ---- EliasFano high_bits: DArray<false> -> bv: BitVector(words) + Inventories ----
+            let hb_words: &'static [u64] = read_pod(&pl_bytes, &mut cursor, plm.ef_high_bits_n_words);
+            let hb_bv: BitSlice<'static> = unsafe {
+                BitSlice::from_raw_parts(hb_words, plm.ef_high_bits_n_bits)
+            };
+
+            // Inventories: block_inventory (i64), subblock (u16), overflow (usize)
+            let bi: &'static [i64] = read_pod(&pl_bytes, &mut cursor, plm.inv_block_inventory_len);
+            let sbi: &'static [u16] = read_pod(&pl_bytes, &mut cursor, plm.inv_subblock_inventory_len);
+            let ov: &'static [usize] = read_pod(&pl_bytes, &mut cursor, plm.inv_overflow_positions_len);
+            let inv_view = InventoriesView {
+                n_sets: plm.inv_n_sets,
+                block_inventory: bi,
+                subblock_inventory: sbi,
+                overflow_positions: ov,
+            };
+            let high = DArrayView::from_raw_parts(hb_bv, inv_view);
+
+            // low_bits BitField: words (u64) + scalars
+            let lb_words: &'static [u64] = read_pod(&pl_bytes, &mut cursor, plm.ef_low_bits_n_words);
+            let lb_bv: BitSlice<'static> = unsafe {
+                BitSlice::from_raw_parts(lb_words, plm.ef_low_bits_n_bits)
+            };
+            let low_bits = unsafe {
+                BitFieldSlice::from_raw_parts_view(
+                    lb_bv,
+                    plm.ef_low_bits_field_width,
+                    compute_mask(plm.ef_low_bits_field_width as usize),
+                    plm.ef_num_vals,
+                )
+            };
+
+            let offsets = EliasFanoView::from_raw_parts(
+                high,
+                low_bits,
+                plm.ef_low_len,
+                plm.ef_universe,
+                plm.ef_num_vals,
+            );
+
+            // summaries_ids BitField (u64 words)
+            let sids_words: &'static [u64] = read_pod(&pl_bytes, &mut cursor, plm.summaries_ids_n_words);
+            let sids_bv: BitSlice<'static> = unsafe {
+                BitSlice::from_raw_parts(sids_words, plm.summaries_ids_n_bits)
+            };
+            let summaries_ids = unsafe {
+                BitFieldSlice::from_raw_parts_view(
+                    sids_bv,
+                    plm.summaries_ids_field_width,
+                    compute_mask(plm.summaries_ids_field_width as usize),
+                    // values_len == the owned summaries_ids.len() (codes/ids
+                    // are extended in lockstep, quantized_summary.rs) — NOT
+                    // n_summaries (block count). Mislabeling as n_summaries
+                    // (c987160..2026-08-10) tripped the reader's
+                    // debug_asserts on every values_len > n_summaries list;
+                    // release reads were in-bounds and value-correct (the
+                    // physical bit length below is the true one).
+                    plm.values_len,
+                )
+            };
+
+            // values (u8) — alignment 1, no padding needed
+            let values: &'static [u8] = read_bytes(&pl_bytes, &mut cursor, plm.values_len);
+            // minimums (f32)
+            let minimums: &'static [f32] = read_pod(&pl_bytes, &mut cursor, plm.minimums_len);
+            // quants (f32)
+            let quants: &'static [f32] = read_pod(&pl_bytes, &mut cursor, plm.quants_len);
+            // component_ids (optional, u16)
+            let component_ids: Option<&'static [u16]> = if plm.has_component_ids {
+                Some(read_pod(&pl_bytes, &mut cursor, plm.component_ids_len))
+            } else {
+                None
+            };
+
+            let summaries = MmapQuantizedSummary::from_raw_parts(
+                plm.n_summaries,
+                plm.dim,
+                component_ids,
+                offsets,
+                summaries_ids,
+                values,
+                minimums,
+                quants,
+            );
+            posting_lists.push(MmapPostingList::from_raw_parts(pp, bo, summaries));
+    }
+    posting_lists
+}
+
+/// E7: token map read, extracted verbatim from `MmapSeismicIndex::from_mmap`.
+fn read_token_map(dir: &Path) -> HashMap<String, usize> {
+    let mut token_to_id_map: HashMap<String, usize> = HashMap::new();
+    if let Ok(bytes) = std::fs::read(dir.join("token_to_id_map.bin")) {
+        let bin_cfg = bincode::config::standard()
+            .with_fixed_int_encoding()
+            .with_little_endian();
+        if let Ok((map, _)) = bincode::serde::decode_from_slice::<HashMap<String, usize>, _>(&bytes, bin_cfg) {
+            token_to_id_map = map;
+        }
+    }
+    token_to_id_map
+}
+
+/// E7: doc-mapping slab read, extracted verbatim from `MmapSeismicIndex::from_mmap`.
+#[allow(clippy::type_complexity)]
+fn read_doc_mapping(
+    dir: &Path,
+) -> std::io::Result<(
+    Option<MmapDocMapping<'static>>,
+    Option<&'static [u8]>,
+    Option<&'static [u8]>,
+)> {
+    Ok(if dir.join("document_mapping_strings.bin").exists() {
+        let strings_mmap = leak_mmap(dir.join("document_mapping_strings.bin"))?;
+        let offsets_mmap = leak_mmap(dir.join("document_mapping_offsets.bin"))?;
+        let offsets: &'static [usize] = bytemuck::cast_slice(offsets_mmap);
+        let mapping = MmapDocMapping::new(strings_mmap, offsets);
+        (Some(mapping), Some(strings_mmap), Some(offsets_mmap))
+    } else {
+        (None, None, None)
+    })
+}
