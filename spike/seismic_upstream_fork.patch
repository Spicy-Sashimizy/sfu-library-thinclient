+impl MmapSeismicIndex {
+    /// Mirror `SeismicIndex::search_raw` (inverted_index_wrapper.rs:217) +
+    /// `InvertedIndexBase::search_inner` (inverted_index.rs:199-282). Resolves
+    /// query tokens via the token map, then runs the mmap-backed search directly
+    /// over `self.forward`/`self.posting_lists` (no transient `MmapInvertedIndex`
+    /// local — the body is inlined, matching the owned path's `&'q self` borrow).
+    #[allow(clippy::too_many_arguments)]
+    pub fn search_raw(
+        &self,
+        query_components_original: &[String],
+        query_values: &[f32],
+        k: usize,
+        query_cut: usize,
+        heap_factor: f32,
+        n_knn: usize,
+        first_sorted: bool,
+    ) -> Vec<ScoredVectorDotProduct>
+    where
+        MmapForward<'static>: SeismicSearchDataset,
+        EncoderFor<MmapForward<'static>>: VectorEncoder<Distance = DotProduct>,
+        for<'q> <EncoderFor<MmapForward<'static>> as VectorEncoder>::QueryVector<'q>:
+            From<SparseVectorView<'q, u16, f32>>,
+    {
+        self.search_raw_visited(
+            query_components_original, query_values, k, query_cut, heap_factor,
+            n_knn, first_sorted,
+        ).0
+    }
+
+    /// Q6/E5 (2026-07-09): `search_raw` + the traversal's `visited` set — the
+    /// forward-range START of every candidate the engine actually scored
+    /// (`evaluate_posting_block`'s dedup key). This is the real per-query
+    /// candidate set the E5 co-access reordering sim needs (top-k' winners are
+    /// a ~200-doc subset of the ~10^4–10^5 scored candidates whose page
+    /// touches dominate cold cost). Read-only instrumentation: identical
+    /// traversal, results are byte-identical to `search_raw` (it now delegates
+    /// here). Starts are forward component indices (f16) resolvable to rows by
+    /// binary search over `forward_offsets.bin`.
+    #[allow(clippy::too_many_arguments)]
+    pub fn search_raw_visited(
+        &self,
+        query_components_original: &[String],
+        query_values: &[f32],
+        k: usize,
+        query_cut: usize,
+        heap_factor: f32,
+        n_knn: usize,
+        first_sorted: bool,
+    ) -> (Vec<ScoredVectorDotProduct>, Vec<usize>)
+    where
+        MmapForward<'static>: SeismicSearchDataset,
+        EncoderFor<MmapForward<'static>>: VectorEncoder<Distance = DotProduct>,
+        for<'q> <EncoderFor<MmapForward<'static>> as VectorEncoder>::QueryVector<'q>:
+            From<SparseVectorView<'q, u16, f32>>,
+    {
+        use crate::utils::KHeap;
+        use rustc_hash::FxHashSet;
+        use vectorium::dataset::ScoredRange;
+
+        let (filtered_components, filtered_values) = resolve_query_tokens::<u16>(
+            query_components_original,
+            query_values,
+            &self.token_to_id_map,
+        );
+        let query = SparseVectorView::new(
+            filtered_components.as_slice(),
+            filtered_values.as_slice(),
+        );
+
+        let query_components = query.components();
+        let query_values_slice = query.values();
+
+        assert!(
+            query_components.is_sorted(),
+            "Query components must be sorted in ascending order."
+        );
+
+        // `query_for_eval` borrows the local query components — its lifetime is
+        // inferred to the function body (the `for<'q>` bound above lets the
+        // compiler pick it). Matches the owned `search_inner` pattern.
+        let query_for_eval = <EncoderFor<MmapForward<'static>> as VectorEncoder>::QueryVector::from(query);
+        let mut evaluator = self.forward.encoder().query_evaluator(query_for_eval);
+
+        let mut heap = KHeap::new(k);
+        let mut visited = FxHashSet::with_capacity_and_hasher(
+            query_cut.min(query_components.len()) * 5000,
+            Default::default(),
+        );
+
+        // Evaluate the top `query_cut` query terms; verbatim from
+        // `InvertedIndexBase::search_inner` (inverted_index.rs:233-270).
+        let mut iter = query_components
+            .iter()
+            .zip(query_values_slice)
+            .k_largest_by(query_cut, |a, b| a.1.total_cmp(b.1));
+        if first_sorted {
+            if let Some((&component_id, _value)) = iter.next() {
+                let component_idx: usize = component_id.as_();
+                self.posting_lists[component_idx].sort_and_search(
+                    &mut evaluator, &query, k, heap_factor, &mut heap, &mut visited,
+                    &self.forward, None,
+                );
+            }
+        }
+        for (&component_id, _value) in iter {
+            let component_idx: usize = component_id.as_();
+            self.posting_lists[component_idx].search(
+                &mut evaluator, &query, k, heap_factor, &mut heap, &mut visited,
+                &self.forward, None,
+            );
+        }
+        if n_knn > 0
+            && let Some(knn) = self.knn.as_ref()
+        {
+            knn.refine(
+                &mut evaluator,
+                &mut heap,
+                &mut visited,
+                &self.forward,
+                n_knn,
+            );
+        }
+
+        let visited_starts: Vec<usize> = visited.into_iter().collect();
+        (
+            heap.into_sorted_vec()
+                .into_iter()
+                .map(|scored| ScoredVectorDotProduct {
+                    distance: scored.distance,
+                    vector: self.forward.id_from_range(scored.range),
+                })
+                .collect(),
+            visited_starts,
+        )
+    }
+
+    /// Q3/M8 instrument (2026-07-10, f16 path): mirror of the dotvbyte
