diff --git a/src/bin/c0_5_compressed_decode.rs b/src/bin/c0_5_compressed_decode.rs
new file mode 100644
index 0000000..4d42b04
--- /dev/null
+++ b/src/bin/c0_5_compressed_decode.rs
@@ -0,0 +1,305 @@
+//! SEISMIC testbed — G3 Path C / Step C0.5: the REAL compressed-format decode
+//! cost that C0 deliberately set aside.
+//!
+//! `docs/seismic_150m_testbed/07_G3_RAM_FIX_PLAN.md` §4.1 bounding caveat: C0
+//! modeled `offsets` (EliasFano) + `summaries_ids` (BitField) as FLAT u32 = the
+//! *best case* for zero-decode. The real upstream `QuantizedSummary`
+//! (`src/quantized_summary.rs:14`) holds them *compressed* and its hot loop
+//! `distances()` (`:64-160`) does, per query:
+//!   - `offsets.select(i)`               once per query term  → DArray.select1
+//!   - `summaries_ids.get_unchecked(pos)` once per VALUE scored → BitField get_bits
+//!   - `values[off..next]`               the flat u8 slab C0 already tested
+//! This bench measures whether mmap'ing the *compressed* index AS-IS holds the
+//! serving latency target — or whether the fork must RESTRUCTURE the compressed
+//! formats to flat POD. That is the make-or-break for R-OWN scope (07 §3):
+//!   * mmap-compressed holds latency  → fork can mmap-as-is (CHEAP R-OWN)
+//!   * it doesn't                      → fork must restructure to POD (EXPENSIVE R-OWN)
+//!
+//! It uses the REAL `toolkit::EliasFano` + `BitField` (the exact structs upstream
+//! uses), not a reimplementation, over a faithful synthetic summary slab — so the
+//! DArray.select1 block-inventory walk + BitField get_bits shift/mask costs are
+//! the true per-query costs, not estimates.
+//!
+//! THREE readers, identical work budget (N queries × terms_per_query, fixed so the
+//! G4 pruning confound can't hide behind corpus growth):
+//!   * COMPRESSED  — the upstream format: EliasFano.select() per term + BitField
+//!                   get_bits_unchecked per value, over a Box<[u8]> values slab
+//!                   held in RAM (mmap-as-is analogue; the decode work is the
+//!                   question, the page source is secondary here).
+//!   * ZERO_DECODE — the C0 best case: flat u32 offsets + flat u32 s_ids, cast
+//!                   views, no compressed decode (the floor C0 measured).
+//!   * MATERIALIZE— the FORMAT-WALL control: per-query copy (recreates the BMP
+//!                   696ms wall). Parity anchor: COMPRESSED and ZERO_DECODE
+//!                   produce identical accumulators (arithmetic twins, R3-v2 G1).
+//!
+//! Result JSON → stdout. Run:
+//!   cargo run --release --no-default-features --bin c0_5_compressed_decode -- \
+//!       --n-terms 800000 --n-summaries 2000000 --avg-values-per-term 80 \
+//!       --n-queries 30 --terms-per-query 64
+use std::time::Instant;
+use clap::Parser;
+use rand::{Rng, SeedableRng};
+use rand_chacha::ChaCha8Rng;
+use serde_json::json;
+use toolkit::{BitField, EliasFanoBuilder};
+
+#[derive(Parser, Debug)]
+#[command(name = "c0_5_compressed_decode", about = "C0.5: real compressed-format decode-cost micro-bench")]
+struct Args {
+    /// #query-term buckets (= postings blocks the EF indexes into the values slab).
+    #[arg(long, default_value_t = 800_000)]
+    n_terms: usize,
+    /// #summary blocks (= docs; the accumulator length + s_id universe).
+    #[arg(long, default_value_t = 2_000_000)]
+    n_summaries: usize,
+    /// mean #u8 values per term (= postings per block in QuantizedSummary).
+    #[arg(long, default_value_t = 80)]
+    avg_values_per_term: usize,
+    /// timed queries.
+    #[arg(long, default_value_t = 30)]
+    n_queries: usize,
+    /// SPLADE_QUERY_TERMS (mirror the serving retriever).
+    #[arg(long, default_value_t = 64)]
+    terms_per_query: usize,
+    /// the ~20% Path-A-parity budget from 07 §6.
+    #[arg(long, default_value_t = 1.2)]
+    latency_budget_mult: f64,
+}
+
+/// The faithful compressed-format summary slab, mirroring QuantizedSummary<C>'s
+/// hot fields (`quantized_summary.rs:14-24`). Built once; all three readers use
+/// the SAME underlying values/s_ids so the latency delta isolates to FORMAT.
+struct Slab {
+    n_summaries: usize,
+    n_values: usize,
+    // The compressed-format fields (the upstream shape):
+    offsets: toolkit::EliasFano,          // select(i) -> value-slab range for term i
+    summaries_ids: BitField,               // get_unchecked(pos) -> s_id (the per-value fetch)
+    values: Vec<u8>,                       // the flat u8 slab (scored bytes)
+    minimums: Vec<f32>,                    // dequant LUT, random access by s_id
+    quants: Vec<f32>,                      // dequant LUT, random access by s_id
+    // The zero-decode (C0 best-case) mirror: flat u32 offsets + flat u32 s_ids.
+    flat_offsets: Vec<u32>,                // [n_terms+1], element offsets into values
+    flat_sids: Vec<u32>,                   // [n_values], the s_id per value, flat
+}
+
+fn build_slab(args: &Args) -> Slab {
+    let mut rng = ChaCha8Rng::seed_from_u64(20260626);
+    let n_terms = args.n_terms;
+    let n_summaries = args.n_summaries;
+    // Per-term value counts (≈ postings-per-block spread). Sum = n_values.
+    let counts: Vec<usize> = (0..n_terms)
+        .map(|_| (args.avg_values_per_term / 2)
+            + rng.random_range(0..(args.avg_values_per_term * 3 / 2).max(1)))
+        .map(|c| c.max(1))
+        .collect();
+    let n_values: usize = counts.iter().sum();
+    let mut offsets_b = EliasFanoBuilder::new(n_values + n_terms, n_terms + 1);
+    let mut flat_offsets = Vec::with_capacity(n_terms + 1);
+    let mut summaries_ids_g = toolkit::BitFieldGrowable::with_capacity(n_values, 32);
+    let mut flat_sids = Vec::with_capacity(n_values);
+    let mut values = Vec::with_capacity(n_values);
+    let mut acc = 0usize;
+    for &c in &counts {
+        flat_offsets.push(acc as u32);
+        offsets_b.push(acc);
+        for _ in 0..c {
+            let sid = rng.random_range(0..n_summaries as u32);
+            summaries_ids_g.push(sid as u64);
+            flat_sids.push(sid);
+            values.push(rng.random::<u8>());
+            acc += 1;
+        }
+    }
+    flat_offsets.push(acc as u32);
+    offsets_b.push(acc);
+    let offsets = offsets_b.build();
+    let summaries_ids: BitField = summaries_ids_g.into();
+    // Dequant LUTs (random-access by s_id in the hot loop).
+    let minimums = (0..n_summaries).map(|_| rng.random_range(-1.0..0.0)).collect();
+    let quants = (0..n_summaries).map(|_| rng.random_range(0.0..0.1)).collect();
+    Slab { n_summaries, n_values, offsets, summaries_ids, values, minimums, quants,
+           flat_offsets, flat_sids }
+}
+
+// --------------------------------------------------------------------------- //
+// Readers. Each scans a workload = vec of queries; each query is a vec of
+// (term_index, weight). They accumulate dequantized dot products into an
+// n_summaries-length f32 accumulator — the exact shape of distances().
+
+fn reader_compressed(slab: &Slab, workload: &[Vec<(usize, f32)>], acc: &mut [f32]) {
+    for q in workload {
+        for &(ti, qw) in q {
+            let lo = slab.offsets.select(ti).unwrap();
+            let hi = slab.offsets.select(ti + 1).unwrap();
+            // THE upstream hot loop: BitField get_bits per value + LUT dequant.
+            for pos in lo..hi {
+                let s_id = unsafe { slab.summaries_ids.get_unchecked(pos) } as usize;
+                let v = slab.values[pos] as f32;
+                acc[s_id] += (v * slab.quants[s_id] + slab.minimums[s_id]) * qw;
+            }
+        }
+    }
+}
+
+fn reader_zero_decode(slab: &Slab, workload: &[Vec<(usize, f32)>], acc: &mut [f32]) {
+    for q in workload {
+        for &(ti, qw) in q {
+            let lo = slab.flat_offsets[ti] as usize;
+            let hi = slab.flat_offsets[ti + 1] as usize;
+            // Flat u32 views: NO compressed decode (the C0 best case).
+            let vs = &slab.values[lo..hi];
+            let ss = &slab.flat_sids[lo..hi];
+            for (v, s_id) in vs.iter().zip(ss) {
+                let s_id = *s_id as usize;
+                acc[s_id] += ((*v as f32) * slab.quants[s_id] + slab.minimums[s_id]) * qw;
+            }
+        }
+    }
+}
+
+fn reader_materialize(slab: &Slab, workload: &[Vec<(usize, f32)>], acc: &mut [f32]) {
+    for q in workload {
+        for &(ti, qw) in q {
+            let lo = slab.flat_offsets[ti] as usize;
+            let hi = slab.flat_offsets[ti + 1] as usize;
+            // MATERIALIZE: copy the touched bytes per query (recreates the wall).
+            let vs = slab.values[lo..hi].to_vec();
+            let ss = slab.flat_sids[lo..hi].to_vec();
+            for (v, s_id) in vs.iter().zip(&ss) {
+                let s_id = *s_id as usize;
+                acc[s_id] += ((*v as f32) * slab.quants[s_id] + slab.minimums[s_id]) * qw;
+            }
+        }
+    }
+}
+
+// --------------------------------------------------------------------------- //
+
+fn build_workload(n_terms: usize, n_queries: usize, terms_per_query: usize)
+    -> Vec<Vec<(usize, f32)>>
+{
+    let mut rng = ChaCha8Rng::seed_from_u64(98765);
+    (0..n_queries).map(|_| {
+        (0..terms_per_query).map(|_| {
+            (rng.random_range(0..n_terms), rng.random_range(0.5..1.5))
+        }).collect()
+    }).collect()
+}
+
+fn pct(xs: &[f64], p: f64) -> f64 {
+    if xs.is_empty() { return 0.0; }
+    let mut s = xs.to_vec(); s.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    let k = ((p / 100.0) * (s.len() - 1) as f64).round() as usize;
+    s[k]
+}
+
+fn time_run<R>(reader: R, slab: &Slab, workload: &[Vec<(usize, f32)>], acc: &mut [f32],
+               n: usize) -> Vec<f64>
+where R: Fn(&Slab, &[Vec<(usize, f32)>], &mut [f32]) {
+    // Warm: one untimed pass.
+    reader(slab, workload, acc);
+    let mut out = Vec::with_capacity(n);
+    for _ in 0..n {
+        for a in acc.iter_mut() { *a = 0.0; }
+        let t0 = Instant::now();
+        reader(slab, workload, acc);
+        out.push(t0.elapsed().as_secs_f64() * 1000.0);
+    }
+    out
+}
+
+fn main() {
+    let args = Args::parse();
+    eprintln!("C0.5: building faithful compressed-format summary slab \
+               (n_terms={}, n_summaries={}, avg_v/term={})...",
+              args.n_terms, args.n_summaries, args.avg_values_per_term);
+    let slab = build_slab(&args);
+    eprintln!("slab: n_values={} values={:.1}MB EF-offsets+BitField(compressed) \
+               + flat-u32 mirror", slab.n_values, slab.n_values as f64 / 1e6);
+    let workload = build_workload(args.n_terms, args.n_queries, args.terms_per_query);
+    let mut acc = vec![0f32; slab.n_summaries];
+
+    // Parity: COMPRESSED and ZERO_DECODE must agree (arithmetic twins, R3-v2 G1).
+    for a in acc.iter_mut() { *a = 0.0; }
+    reader_compressed(&slab, &workload, &mut acc);
+    let acc_c = acc.clone();
+    for a in acc.iter_mut() { *a = 0.0; }
+    reader_zero_decode(&slab, &workload, &mut acc);
+    let acc_z = acc.clone();
+    let parity = acc_c == acc_z;
+    eprintln!("parity (compressed == zero_decode): {}", if parity { "OK" } else { "FAIL" });
+    assert!(parity, "C0.5 parity FAILED: readers are not arithmetic twins");
+
+    let wc = time_run(reader_compressed, &slab, &workload, &mut acc, args.n_queries);
+    let wz = time_run(reader_zero_decode, &slab, &workload, &mut acc, args.n_queries);
+    let wm = time_run(reader_materialize, &slab, &workload, &mut acc, args.n_queries);
+
+    // Warm=bestOf run (page cache hot); the readers have no cold variant in-RAM
+    // (no mmap eviction here — C0.5 isolates DECODE cost, not page faults; C0
+    // owned the cold/warm page-fault axis).
+    let warm_c_p50 = pct(&wc, 50.0); let warm_c_p95 = pct(&wc, 95.0);
+    let warm_z_p50 = pct(&wz, 50.0); let warm_z_p95 = pct(&wz, 95.0);
+    let warm_m_p50 = pct(&wm, 50.0); let warm_m_p95 = pct(&wm, 95.0);
+
+    // C0.5 verdict: is COMPRESSED within the budget of ZERO_DECODE (the C0 floor)?
+    let ratio_cz = warm_c_p50 / warm_z_p50.max(1e-9);
+    let wall_recreated = warm_c_p50 > args.latency_budget_mult * warm_z_p50;
+
+    let verdict = if !wall_recreated {
+        format!("C0.5 COMPRESSED_HOLDS — real compressed decode p50 {:.2}ms is {:.2}x the \
+                 zero-decode floor ({:.2}ms), within the {:.1}x budget. The fork can mmap the \
+                 compressed index AS-IS (cheap R-OWN): no POD restructure needed. Proceed to C1 \
+                 with the upstream format preserved.",
+                warm_c_p50, ratio_cz, warm_z_p50, args.latency_budget_mult)
+    } else {
+        format!("C0.5 FORMAT_WALL_RECURS — real compressed decode p50 {:.2}ms is {:.2}x the \
+                 zero-decode floor ({:.2}ms), OVER the {:.1}x budget. DArray.select1 + BitField \
+                 get_bits per-query decode recreates the wall on the real format. The fork MUST \
+                 restructure compressed offsets/summaries_ids to flat POD (expensive R-OWN) — \
+                 mmap-as-is is NOT enough. Re-scope C1 before paying the fork.",
+                warm_c_p50, ratio_cz, warm_z_p50, args.latency_budget_mult)
+    };
+
+    let result = json!({
+        "meta": {
+            "engine": "seismic-pyseismic-lsr-0.4.0 (upstream toolkit EliasFano+BitField, real)",
+            "built_utc": "2026-06-26",
+            "purpose": "G3 Path C / Step C0.5: REAL compressed-format decode cost (the caveat \
+                        C0 set aside). Decides C1 fork scope: mmap-as-is (cheap R-OWN) vs \
+                        restructure-to-POD (expensive R-OWN).",
+            "doc_refs": [
+                "07_G3_RAM_FIX_PLAN.md §4.1 (C0 caveat) + §3 Step C (R-OWN scope)",
+                "quantized_summary.rs:14-160 (upstream struct + distances())",
+                "toolkit elias_fano.rs:28-108 + darray.rs (DArray.select1) + bitfield.rs:118 (get_bits)"
+            ],
+            "slab_provenance": "FAITHFUL-SHAPE synthetic; uses the REAL toolkit::EliasFano + \
+                                BitField structs (not a reimplementation), so DArray.select1 \
+                                block-walk + BitField shift/mask costs are true. Latency/decode \
+                                bench, NOT G2/recall."
+        },
+        "config": {
+            "n_terms": args.n_terms, "n_summaries": args.n_summaries,
+            "avg_values_per_term": args.avg_values_per_term,
+            "n_queries": args.n_queries, "terms_per_query": args.terms_per_query,
+            "latency_budget_mult": args.latency_budget_mult,
+            "n_values": slab.n_values, "values_slab_mb": (slab.n_values as f64 / 1e6)
+        },
+        "latency_ms": {
+            "compressed":      {"warm_p50": warm_c_p50, "warm_p95": warm_c_p95,
+                                "min": wc.iter().cloned().fold(f64::INFINITY, f64::min),
+                                "max": wc.iter().cloned().fold(0.0 / 0.0, f64::max)},
+            "zero_decode":    {"warm_p50": warm_z_p50, "warm_p95": warm_z_p95,
+                                "min": wz.iter().cloned().fold(f64::INFINITY, f64::min),
+                                "max": wz.iter().cloned().fold(0.0 / 0.0, f64::max)},
+            "materialize":    {"warm_p50": warm_m_p50, "warm_p95": warm_m_p95,
+                                "min": wm.iter().cloned().fold(f64::INFINITY, f64::min),
+                                "max": wm.iter().cloned().fold(0.0 / 0.0, f64::max)}
+        },
+        "compressed_vs_zero_decode_x": (ratio_cz * 1000.0).round() / 1000.0,
+        "parity_ok": parity,
+        "c0_5_verdict": verdict
+    });
+    println!("{}", serde_json::to_string_pretty(&result).unwrap());
+    eprintln!("=== C0.5 VERDICT ===\n{}", verdict);
+}
diff --git a/src/bin/c1a_mmap_index.rs b/src/bin/c1a_mmap_index.rs
new file mode 100644
index 0000000..903379f
--- /dev/null
+++ b/src/bin/c1a_mmap_index.rs
@@ -0,0 +1,362 @@
+//! SEISMIC testbed — G3 Path C / Step C1a: the mmap integration gate.
+//!
+//! C0 (page-fault axis, §4.1) + C0.5 (compressed-decode axis, §4.2) de-risked
+//! the *format*. C1a measures the *integration* axis C0.5 deferred: "Can the
+//! mmap file-cache swap be wired into `SeismicIndex` without breaking the
+//! search path — and does it actually drop RssAnon to ≈0 (the §6 target)?"
+//!
+//! Four phases, parity-gated, over the REAL persona index
+//! (`med_bio_2m.index.seismic`, the same one `seismic_ram_floor_persona_2m.json`
+//! measured at 912 B/doc anon under Path A):
+//!   1. Load the owned `SeismicIndex` via bincode `load_index` (= Path A floor).
+//!      Measure RssAnon after load. Run N deterministic persona queries via the
+//!      owned `search_raw` to capture the parity reference. KEEP the owned index
+//!      alive for the comparison.
+//!   2. `write_mmap_index(&owned, mmap_dir)` — serialize all 4 components to raw
+//!      flat files (zero-decode on read).
+//!   3. Build `MmapSeismicIndex::from_mmap(mmap_dir)`. Measure RssAnon after
+//!      build (should add ≈0 anon since the views borrow the mmap). Re-run the
+//!      SAME N queries → mmap results.
+//!   4. Parity assert (mmap == owned, doc_ids identical + scores within 1e-4
+//!      f32 epsilon) + latency (warm p50/p95, owned vs mmap, timed).
+//!
+//! Result JSON → stdout (schema mirrors C0/C0.5). Gate:
+//!   KEEPS_GATE iff parity_ok AND after_mmap_anon ≈ path_a_anon (anon delta ≈0,
+//!   <5% of index size) AND mmap warm_p50 ≤ budget_mult × path_a warm_p50.
+//!   Else FAILS_GATE with the failing axis named.
+//!
+//! Run:
+//!   RUSTFLAGS="-C target-cpu=native" cargo run --release --no-default-features \
+//!       --bin c1a_mmap_index -- --index-book /tmp/seismic_testbed/index/med_bio_2m.index.seismic \
+//!       --mmap-dir /tmp/seismic_testbed/mmap --n-queries 30 --k 10 \
+//!       --query-cut 8 --heap-factor 1.0
+use std::collections::HashMap;
+use std::path::PathBuf;
+use std::time::Instant;
+
+use clap::Parser;
+use rand::{Rng, SeedableRng};
+use rand_chacha::ChaCha8Rng;
+use serde_json::json;
+
+use seismic::inverted_index_wrapper::SeismicIndex;
+use seismic::mmap_index::OwnedForward;
+use seismic::mmap_io::{read_rss_kb, write_mmap_index, MmapSeismicIndex};
+use vectorium::IndexSerializer;
+use vectorium::{Distance, ScoredVectorDotProduct};
+
+#[derive(Parser, Debug)]
+#[command(name = "c1a_mmap_index", about = "C1a: SEISMIC mmap integration gate (parity + floor + latency)")]
+struct Args {
+    /// Path to the existing bincode `*.index.seismic` (Path A owned index).
+    #[arg(long, default_value = "/tmp/seismic_testbed/index/med_bio_2m.index.seismic")]
+    index_book: PathBuf,
+    /// Directory for the flat mmap files (created if missing).
+    #[arg(long, default_value = "/tmp/seismic_testbed/mmap")]
+    mmap_dir: PathBuf,
+    /// #deterministic persona queries to run through both owned + mmap paths.
+    #[arg(long, default_value_t = 30)]
+    n_queries: usize,
+    /// top-k per query.
+    #[arg(long, default_value_t = 10)]
+    k: usize,
+    /// query_cut (top terms to evaluate).
+    #[arg(long, default_value_t = 8)]
+    query_cut: usize,
+    /// heap_factor (pruning threshold).
+    #[arg(long, default_value_t = 1.0)]
+    heap_factor: f32,
+    /// n_knn (knn refinement breadth; 0 disables).
+    #[arg(long, default_value_t = 0)]
+    n_knn: usize,
+    /// first_sorted (sort first query term's blocks before scanning).
+    #[arg(long, default_value_t = true)]
+    first_sorted: bool,
+    /// warmup iterations per query (warm percentile timing).
+    #[arg(long, default_value_t = 3)]
+    warm_iters: usize,
+    /// the ~20% Path-A latency budget from 07 §6 (mmap p50 ≤ mult × path_a p50).
+    #[arg(long, default_value_t = 1.2)]
+    latency_budget_mult: f64,
+}
+
+/// A deterministic persona query workload (token subsets from the index's own
+/// token map; fixed RNG seed so owned + mmap run identical queries).
+struct QueryWorkload {
+    tokens: Vec<Vec<String>>,
+    values: Vec<Vec<f32>>,
+}
+
+/// Percentile helper (matches C0/C0.5 bin).
+fn pct(samples: &[f64], p: f64) -> f64 {
+    if samples.is_empty() {
+        return f64::NAN;
+    }
+    let mut s = samples.to_vec();
+    s.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    let idx = ((s.len() as f64 - 1.0) * p / 100.0).round() as usize;
+    s[idx.min(s.len() - 1)]
+}
+
+fn main() {
+    let args = Args::parse();
+    eprintln!("=== C1a SEISMIC mmap integration gate ===");
+    eprintln!("index_book: {}", args.index_book.display());
+    eprintln!("mmap_dir:   {}", args.mmap_dir.display());
+
+    // ---- Phase 1: load the owned index (= Path A floor) ----
+    eprintln!("\n[Phase 1] Loading owned SeismicIndex (bincode Path A)...");
+    let load_start = Instant::now();
+    let owned: SeismicIndex<OwnedForward> = SeismicIndex::load_index(
+        args.index_book.to_str().expect("non-UTF8 index path"),
+    )
+    .expect("failed to load owned SeismicIndex (bincode)");
+    let load_secs = load_start.elapsed().as_secs_f64();
+    eprintln!("  loaded in {:.2}s, n_docs={}, n_posting_lists={}",
+        load_secs, owned.len(), owned.inverted_index().n_posting_lists());
+
+    // RssAnon after load = the Path-A floor (the number G3 measured at 912 B/doc).
+    let (path_a_anon_kb, path_a_file_kb) = read_rss_kb();
+    eprintln!("  RssAnon after load (Path-A floor): {:.3} GB ({:.0} KB)", path_a_anon_kb as f64 / 1e6, path_a_anon_kb);
+    eprintln!("  RssFile after load:               {:.3} GB ({:.0} KB)", path_a_file_kb as f64 / 1e6, path_a_file_kb);
+
+    // Build a deterministic workload of REAL token strings sampled from the
+    // index's own token→ID map (so resolve_query_tokens finds them). Fixed RNG
+    // seed → owned + mmap run identical queries.
+    let n_posting_lists = owned.inverted_index().n_posting_lists();
+    let n_docs = owned.len();
+    let token_map = owned.token_to_id_map();
+    let all_tokens: Vec<String> = token_map.keys().cloned().collect();
+    eprintln!("  token map size: {}, n_posting_lists: {}", all_tokens.len(), n_posting_lists);
+    let mut rng = ChaCha8Rng::seed_from_u64(20260627);
+    let mut workload = QueryWorkload { tokens: Vec::new(), values: Vec::new() };
+    for _ in 0..args.n_queries {
+        // SPLADE queries use ~8 to query_cut terms; pick a subset of real tokens.
+        let n_terms = 8 + rng.random_range(0..(args.query_cut.saturating_sub(8).max(1)));
+        let n_terms = n_terms.min(all_tokens.len());
+        let mut qtoks: Vec<String> = Vec::with_capacity(n_terms);
+        let mut qvals: Vec<f32> = Vec::with_capacity(n_terms);
+        let mut chosen: std::collections::HashSet<usize> = std::collections::HashSet::new();
+        while qtoks.len() < n_terms {
+            let idx = rng.random_range(0..all_tokens.len());
+            if chosen.insert(idx) {
+                qtoks.push(all_tokens[idx].clone());
+                qvals.push(rng.random_range(0.1..2.0));
+            }
+        }
+        workload.tokens.push(qtoks);
+        workload.values.push(qvals);
+    }
+    eprintln!("  built {} deterministic queries from real tokens", args.n_queries);
+
+    // Run the owned reference queries (warm timing).
+    eprintln!("[Phase 1] Running {} reference queries through owned search_raw...", args.n_queries);
+    let owned_results: Vec<Vec<ScoredVectorDotProduct>> = workload.tokens.iter().zip(workload.values.iter())
+        .map(|(toks, vals)| owned.search_raw(
+            toks, vals, args.k, args.query_cut, args.heap_factor, args.n_knn, args.first_sorted,
+        ))
+        .collect();
+
+    // Owned warm latency (warmup + timed).
+    let mut owned_warm: Vec<f64> = Vec::new();
+    for _ in 0..args.warm_iters {
+        for (toks, vals) in workload.tokens.iter().zip(workload.values.iter()) {
+            let t0 = Instant::now();
+            let _ = owned.search_raw(toks, vals, args.k, args.query_cut, args.heap_factor, args.n_knn, args.first_sorted);
+            owned_warm.push(t0.elapsed().as_secs_f64() * 1e3);
+        }
+    }
+    let owned_p50 = pct(&owned_warm, 50.0);
+    let owned_p95 = pct(&owned_warm, 95.0);
+    eprintln!("  owned warm p50={:.2}ms p95={:.2}ms ({} samples)", owned_p50, owned_p95, owned_warm.len());
+
+    // ---- Phase 2: write the mmap flat layout ----
+    eprintln!("\n[Phase 2] write_mmap_index -> {}...", args.mmap_dir.display());
+    let write_start = Instant::now();
+    let _manifest = write_mmap_index(&owned, &args.mmap_dir)
+        .expect("failed to write mmap index");
+    let write_secs = write_start.elapsed().as_secs_f64();
+    let mmap_disk_bytes: u64 = std::fs::read_dir(&args.mmap_dir).unwrap()
+        .filter_map(|e| e.ok())
+        .map(|e| e.metadata().map(|m| m.len()).unwrap_or(0))
+        .sum();
+    eprintln!("  wrote in {:.2}s, total on-disk {:.3} GB", write_secs, mmap_disk_bytes as f64 / 1e9);
+
+    // ---- Phase 1.5 (C1a floor-fix): drop the owned index AFTER the write (which
+    // needs it) but BEFORE building the mmap index, so the mmap floor is measured
+    // against a real post-owned baseline — the §6 measurement (anon delta from
+    // baseline ≈ 0), NOT "mmap on top of the still-resident owned floor", which
+    // the original C1a wrongly did (it kept owned alive through phase 3+).
+    // `owned_results` + the workload are the parity reference; we no longer need
+    // the live owned index.
+    eprintln!("\n[Phase 1.5] Dropping owned index + malloc_trim to free Path-A anon...");
+    drop(owned);
+    for _ in 0..5 { unsafe { libc::malloc_trim(0); } }
+    std::thread::sleep(std::time::Duration::from_millis(200));
+    for _ in 0..5 { unsafe { libc::malloc_trim(0); } }
+    let (mmap_base_anon_kb, mmap_base_file_kb) = read_rss_kb();
+    eprintln!("  post-drop baseline: RssAnon={:.3} GB  RssFile={:.3} GB",
+        mmap_base_anon_kb as f64 / 1e6, mmap_base_file_kb as f64 / 1e6);
+
+    // ---- Phase 3: build the mmap index ----
+    eprintln!("\n[Phase 3] MmapSeismicIndex::from_mmap -> {}...", args.mmap_dir.display());
+    let mmap_start = Instant::now();
+    let mmap_idx = MmapSeismicIndex::from_mmap(&args.mmap_dir)
+        .expect("failed to build MmapSeismicIndex");
+    eprintln!("  built in {:.2}s", mmap_start.elapsed().as_secs_f64());
+
+    // Fault in every page of the four mmap'd components BEFORE the floor +
+    // latency measurement, so RssFile reflects actual index residency (the §6
+    // cure = file cache carries the index) and the latency measures the real
+    // page-cache path, not anon-resident data with the slab never read (the
+    // original C1a left RssFile at 2 MB = never faulted).
+    eprintln!("  faulting in the mmap slab (touch_slab)...");
+    let touch_start = Instant::now();
+    let _touch_acc = mmap_idx.touch_slab();
+    eprintln!("  fault-in scan: {:.2}s", touch_start.elapsed().as_secs_f64());
+
+    let (after_mmap_anon_kb, after_mmap_file_kb) = read_rss_kb();
+    eprintln!("  RssAnon after mmap (post-fault-in): {:.3} GB ({:.0} KB)", after_mmap_anon_kb as f64 / 1e6, after_mmap_anon_kb);
+    eprintln!("  RssFile after mmap (post-fault-in): {:.3} GB ({:.0} KB)", after_mmap_file_kb as f64 / 1e6, after_mmap_file_kb);
+
+    // ---- Phase 4: parity + latency + verdict ----
+    eprintln!("\n[Phase 4] Parity + latency...");
+    // Run mmap queries and compare to owned reference.
+    let mmap_results: Vec<Vec<ScoredVectorDotProduct>> = workload.tokens.iter().zip(workload.values.iter())
+        .map(|(toks, vals)| {
+            // The mmap index doesn't carry the token_to_id_map; the workload
+            // tokens are numeric IDs that map 1:1 to component IDs in the
+            // persona index. We build the query components directly as u16.
+            // search_raw resolves via the token map; to mirror exactly, we pass
+            // through search_raw (token map set to identity below).
+            mmap_idx.search_raw(
+                toks, vals, args.k, args.query_cut, args.heap_factor, args.n_knn, args.first_sorted,
+            )
+        })
+        .collect();
+
+    // Parity: doc_ids identical + scores within epsilon.
+    let mut parity_ok = true;
+    let mut parity_failures = Vec::new();
+    for (i, (o, m)) in owned_results.iter().zip(mmap_results.iter()).enumerate() {
+        if o.len() != m.len() {
+            parity_ok = false;
+            parity_failures.push(format!("q{}: length mismatch (owned={}, mmap={})", i, o.len(), m.len()));
+            continue;
+        }
+        for (j, (or, mr)) in o.iter().zip(m.iter()).enumerate() {
+            if or.vector != mr.vector {
+                parity_ok = false;
+                parity_failures.push(format!("q{}[{}]: doc_id mismatch (owned={}, mmap={})", i, j, or.vector, mr.vector));
+                break;
+            }
+            let score_diff = (or.distance.distance() - mr.distance.distance()).abs();
+            if score_diff > 1e-4 {
+                parity_ok = false;
+                parity_failures.push(format!("q{}[{}]: score mismatch (owned={:.6}, mmap={:.6}, diff={:.2e})", i, j, or.distance.distance(), mr.distance.distance(), score_diff));
+                break;
+            }
+        }
+    }
+    if parity_ok {
+        eprintln!("  PARITY OK — mmap results == owned results (doc_ids identical, scores within 1e-4 epsilon)");
+    } else {
+        eprintln!("  PARITY FAILED — {} mismatches:", parity_failures.len());
+        for f in parity_failures.iter().take(5) { eprintln!("    {}", f); }
+    }
+
+    // mmap warm latency.
+    let mut mmap_warm: Vec<f64> = Vec::new();
+    for _ in 0..args.warm_iters {
+        for (toks, vals) in workload.tokens.iter().zip(workload.values.iter()) {
+            let t0 = Instant::now();
+            let _ = mmap_idx.search_raw(toks, vals, args.k, args.query_cut, args.heap_factor, args.n_knn, args.first_sorted);
+            mmap_warm.push(t0.elapsed().as_secs_f64() * 1e3);
+        }
+    }
+    let mmap_p50 = pct(&mmap_warm, 50.0);
+    let mmap_p95 = pct(&mmap_warm, 95.0);
+    eprintln!("  mmap warm p50={:.2}ms p95={:.2}ms ({} samples)", mmap_p50, mmap_p95, mmap_warm.len());
+
+    // ---- Floor deltas + verdict (§6-honest, post C1a floor-fix) ----
+    // The §6 cure test: (a) RssAnon delta from the POST-OWNED-DROP baseline ≈ 0
+    // (the mmap index didn't re-materialize the floor into anon — only the small
+    // doc_mapping/token_map metadata should remain) AND (b) RssFile above the
+    // baseline ≈ index size (the slab is faulted into reclaimable file cache,
+    // which proves "mmap'd ≠ fast" hazard is avoided on the cold-faulted path).
+    let floor_anon_delta_vs_base_gb = (after_mmap_anon_kb as i64 - mmap_base_anon_kb as i64) as f64 / 1e6;
+    let floor_file_resident_gb = (after_mmap_file_kb as i64 - mmap_base_file_kb as i64) as f64 / 1e6;
+    let index_size_gb = mmap_disk_bytes as f64 / 1e9;
+    // anon delta < max(5% of index, 0.1GB)  → floor cured (anon≈baseline).
+    let floor_anon_ok = floor_anon_delta_vs_base_gb.abs() < (index_size_gb * 0.05).max(0.1);
+    // file resident > 50% of index → slab actually carried by file cache.
+    let floor_file_ok = floor_file_resident_gb > 0.5 * index_size_gb;
+    let floor_ok = floor_anon_ok && floor_file_ok;
+
+    let mmap_latency_x = if owned_p50 > 1e-9 { mmap_p50 / owned_p50 } else { f64::NAN };
+    let latency_ok = mmap_latency_x <= args.latency_budget_mult;
+
+    let verdict = if parity_ok && floor_ok && latency_ok {
+        format!("C1a KEEPS_GATE — parity OK; floor cured: anon Δ vs baseline {:+.3} GB (≈0), file-resident {:.3} GB vs {:.2} GB index (slab in reclaimable file cache); mmap p50 {:.2}ms = {:.2}x path_a ({:.2}ms), within {:.1}x budget. Proceed to C2.",
+            floor_anon_delta_vs_base_gb, floor_file_resident_gb, index_size_gb, mmap_p50, mmap_latency_x, owned_p50, args.latency_budget_mult)
+    } else {
+        let axis = if !parity_ok { "PARITY (results diverge — a borrow path is secretly copying or an offset cast is wrong)" }
+            else if !floor_ok {
+                if !floor_anon_ok { "FLOOR/ANON (RssAnon did not drop to baseline — a borrow path re-materializes the floor into anon: likely the leaked mmap doc_mapping/token_map metadata, or a slice being copied)" }
+                else { "FLOOR/FILE (slab not faulted into file cache — RssFile < 50% index; the cold/cache path isn't carrying the index as §6 requires)" }
+            }
+            else { "LATENCY (mmap p50 exceeds budget — FORMAT-WALL re-emerged in integration)" };
+        format!("C1a FAILS_GATE — failing axis: {}. anon Δ vs base={:+.3}GB, file-resident={:.3}GB vs {:.2}GB index, mmap p50 {:.2}ms = {:.2}x path_a ({:.2}ms, budget {:.1}x), parity_ok={}. Re-examine before C2; 07 §4 routes to Step D (Path B) on floor/latency fail.",
+            axis, floor_anon_delta_vs_base_gb, floor_file_resident_gb, index_size_gb, mmap_p50, mmap_latency_x, owned_p50, args.latency_budget_mult, parity_ok)
+    };
+
+    let result = json!({
+        "meta": {
+            "engine": "seismic-pyseismic-lsr-0.4.0 (C1a mmap fork: toolkit+vectorium *View/*Mmap* borrow views)",
+            "built_utc": "2026-06-27",
+            "purpose": "G3 Path C / Step C1a: mmap integration gate. C0+C0.5 de-risked the format; C1a measures the integration (RssAnon→0 anon + latency held end-to-end over the real 2M persona index).",
+            "doc_refs": [
+                "07_G3_RAM_FIX_PLAN.md §4.3 (C1a) + §6 (exit criteria: anon≈0, latency held)",
+                "spike/seismic_upstream/src/mmap_index.rs (MmapQuantizedSummary/PostingList/InvertedIndex borrow structs)",
+                "spike/seismic_upstream/src/mmap_io.rs (write_mmap_index + MmapSeismicIndex reader)",
+                "spike/toolkit_fork (DArrayView/EliasFanoView/InventoriesView), spike/vectorium_fork (MmapSparseStorage)"
+            ],
+            "index_provenance": format!("real persona bincode index: {} (produced by build_persona_seismic.py; the same index seismic_ram_floor_persona_2m.json measured at 912 B/doc anon)",
+                args.index_book.display())
+        },
+        "config": {
+            "index_book": args.index_book.display().to_string(),
+            "n_queries": args.n_queries, "k": args.k, "query_cut": args.query_cut,
+            "heap_factor": args.heap_factor, "n_knn": args.n_knn, "first_sorted": args.first_sorted,
+            "warm_iters": args.warm_iters, "latency_budget_mult": args.latency_budget_mult,
+            "n_docs": n_docs,
+            "n_posting_lists": n_posting_lists,
+            "mmap_disk_gb": index_size_gb,
+        },
+        "rss_kb": {
+            "path_a_anon_after_load": path_a_anon_kb,
+            "path_a_file_after_load": path_a_file_kb,
+            "mmap_baseline_anon_after_owned_drop": mmap_base_anon_kb,
+            "mmap_baseline_file_after_owned_drop": mmap_base_file_kb,
+            "after_mmap_anon_post_fault_in": after_mmap_anon_kb,
+            "after_mmap_file_post_fault_in": after_mmap_file_kb,
+            "floor_anon_delta_vs_baseline_gb": (floor_anon_delta_vs_base_gb * 1000.0).round() / 1000.0,
+            "floor_file_resident_gb": (floor_file_resident_gb * 1000.0).round() / 1000.0
+        },
+        "floor_anon_ok": floor_anon_ok,
+        "floor_file_ok": floor_file_ok,
+        "latency_ms": {
+            "path_a": {"warm_p50": owned_p50, "warm_p95": owned_p95, "n_samples": owned_warm.len()},
+            "mmap":   {"warm_p50": mmap_p50, "warm_p95": mmap_p95, "n_samples": mmap_warm.len()},
+        },
+        "parity_ok": parity_ok,
+        "parity_failures": parity_failures,
+        "floor_delta_anon_gb": (floor_anon_delta_vs_base_gb * 1000.0).round() / 1000.0,
+        "floor_ok": floor_ok,
+        "mmap_vs_path_a_lat_x": (mmap_latency_x * 1000.0).round() / 1000.0,
+        "latency_ok": latency_ok,
+        "c1a_verdict": verdict
+    });
+    println!("{}", serde_json::to_string_pretty(&result).unwrap());
+    eprintln!("\n=== C1a VERDICT ===\n{}", verdict);
+}
