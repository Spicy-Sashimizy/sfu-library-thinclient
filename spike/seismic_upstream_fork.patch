+
+        let (filtered_components, filtered_values) = resolve_query_tokens::<u16>(
+            query_components_original,
+            query_values,
+            &self.token_to_id_map,
+        );
+        let query = SparseVectorView::new(
+            filtered_components.as_slice(),
+            filtered_values.as_slice(),
+        );
+        let query_components = query.components();
+        let query_values_slice = query.values();
+        assert!(query_components.is_sorted());
+
+        let query_for_eval = <EncoderFor<MmapForward<'static>> as VectorEncoder>::QueryVector::from(query);
+        let mut evaluator = self.forward.encoder().query_evaluator(query_for_eval);
+
+        let mut heap = KHeap::new(k);
+        let mut visited = FxHashSet::with_capacity_and_hasher(
+            query_cut.min(query_components.len()) * 5000,
+            Default::default(),
+        );
+        let mut block_stats: Vec<usize> = Vec::new();
+
+        let mut iter = query_components
+            .iter()
+            .zip(query_values_slice)
+            .k_largest_by(query_cut, |a, b| a.1.total_cmp(b.1));
+        if first_sorted {
+            if let Some((&component_id, _value)) = iter.next() {
+                let component_idx: usize = component_id.as_();
+                self.posting_lists[component_idx].sort_and_search(
+                    &mut evaluator, &query, k, heap_factor, &mut heap, &mut visited,
+                    &self.forward, Some(&mut block_stats),
+                );
+            }
+        }
+        for (&component_id, _value) in iter {
+            let component_idx: usize = component_id.as_();
+            self.posting_lists[component_idx].search(
+                &mut evaluator, &query, k, heap_factor, &mut heap, &mut visited,
+                &self.forward, Some(&mut block_stats),
+            );
+        }
+        if n_knn > 0
+            && let Some(knn) = self.knn.as_ref()
+        {
+            knn.refine(
+                &mut evaluator, &mut heap, &mut visited, &self.forward, n_knn,
+            );
+        }
+
+        let visited_starts: Vec<usize> = visited.into_iter().collect();
+        (
+            heap.into_sorted_vec()
+                .into_iter()
+                .map(|scored| ScoredVectorDotProduct {
+                    distance: scored.distance,
+                    vector: self.forward.id_from_range(scored.range),
+                })
+                .collect(),
+            visited_starts,
+            block_stats,
+        )
+    }
+
+    /// The mmap'd forward index (read access; used by tests/bins).
+    pub fn forward(&self) -> &MmapForward<'static> { &self.forward }
+    /// The mmap'd posting lists.
+    pub fn posting_lists(&self) -> &[MmapPostingList<'static>] { &self.posting_lists }
+
+    /// C2 floor measurement: dense, file-by-file fault-in of the whole mmap
+    /// footprint. C1a's per-list stride scan only achieved ~43% RssFile because
+    /// the kernel evicted early pages while later ones were being touched.
+    /// Here we `madvise(WILLNEED|SEQUENTIAL)` each file and then walk it once
+    /// sequentially at page granularity, so pages stay resident long enough to
+    /// be counted as `RssFile`.
+    pub fn touch_slab(&self) -> u64 {
+        use std::sync::atomic::Ordering;
+        // Cross-file counter; Atomic ensures loads are not DCE'd.
+        let counter = AtomicUsize::new(0);
+
+        // Forward index via its storage slices.
+        use vectorium::SparseStorage as _;
+        let st = self.forward.storage();
+        touch_bytes(cast_pod_bytes(st.offsets().as_ref()), &counter);
+        touch_bytes(cast_pod_bytes(st.components().as_ref()), &counter);
+
+        let vals = st.values().as_ref();
+        // SAFETY: f16 is Pod; reinterpretation is sound for a reducing read.
+        let val_bytes = unsafe {
+            std::slice::from_raw_parts(vals.as_ptr() as *const u8, std::mem::size_of_val(vals))
+        };
+        touch_bytes(val_bytes, &counter);
+
+        // Posting lists: one dense pass over the concatenated posting_lists.bin.
+        touch_bytes(self._postings_mmap, &counter);
+
+        // Doc mapping metadata (C2): fault in the flat string slab and offsets.
+        if let Some(m) = self.doc_mapping {
+            touch_bytes(m.strings, &counter);
+            touch_bytes(cast_pod_bytes(m.offsets), &counter);
+        }
+
+        counter.load(Ordering::Relaxed) as u64
+    }
+
+    /// SEISMIC sequential serving mechanism (B): release the resident pages of
+    /// every file-backed slab this index holds, via `madvise(MADV_DONTNEED)`.
+    /// `MADV_DONTNEED` immediately drops the resident set for each range (the
+    /// clean file-backed pages are discarded; the virtual mapping is kept) so the
+    /// next access re-faults from the backing file. This turns the sequential
+    /// serving "~1 shard resident" bound from a kernel-reclaim-timing heuristic
+    /// into a HARD guarantee: after a shard's search, its pages are evicted before
+    /// the next shard is touched (called by `SequentialSeismicBackend` after each
+    /// shard; the parallel path never calls this).
+    ///
+    /// Safe because `madvise` does not write, and each slab is a read-only
+    /// `mmap`'d `&'static [u8]` (see `leak_mmap`). Returns the bytes covered (a
+    /// checksum-style accumulator; non-zero ⇒ the ranges were real, mirroring
+    /// `touch_slab`'s contract). The next `search_raw` re-faults and returns
+    /// identical data — asserted by `test_seismic_sequential.py`'s re-fault test.
+    /// See `docs/seismic_sequential_serving/01_ARCHITECTURE.md` mechanism (B).
+    pub fn release_pages(&self) -> u64 {
+        let counter = AtomicUsize::new(0);
+        release_bytes(self._forward_offsets_mmap, &counter);
+        // E7 Fix #4: also evict the two forward elephant slabs (previously leaked
+        // but un-retained, so never released). See the struct-field note.
+        release_bytes(self._forward_components_mmap, &counter);
+        release_bytes(self._forward_values_mmap, &counter);
+        release_bytes(self._postings_mmap, &counter);
+        if let Some(s) = self._doc_strings_mmap {
+            release_bytes(s, &counter);
+        }
+        if let Some(o) = self._doc_offsets_mmap {
+            release_bytes(o, &counter);
+        }
+        counter.load(std::sync::atomic::Ordering::Relaxed) as u64
+    }
+
+    /// E7 Fix #4 (2026-07-03): prefault only the *floor* slabs — the posting-list
+    /// index and the doc-mapping strings/offsets — leaving the forward-codec
+    /// files (offsets/components/values) to be faulted by the actual search.
+    ///
+    /// Gate c's bar (`dv.majflt_cold / f16.majflt_cold ≤ 0.55`) models the
+    /// **forward-codec** fault advantage of the denser dotvbyte layout. But the
+    /// whole-process `majflt_cold` measured around `release_pages → cold search`
+    /// also charges the **constant** posting-list + doc-mapping floor (≈1.36 GB
+    /// that faults identically for both codecs). That floor inflates BOTH the
+    /// numerator and denominator by the same constant, dragging the ratio toward
+    /// 1.0 and burying the forward-codec delta the gate is meant to expose (the
+    /// measured 0.591 vs the modeled-forward-only 0.55).
+    ///
+    /// Calling `prefault_floor()` *after* `release_pages()` but *before* the
+    /// cold-pass majflt baseline strips that constant floor from the delta — the
+    /// remaining faults are the forward-codec reads, which is exactly what the
+    /// 0.55 bar was calibrated on. This is a measurement-calibration fix, not a
+    /// dv-preferring optimization: it removes the same floor bytes from both
+    /// codecs symmetrically.
+    ///
+    /// Safe: the reads are over read-only mmap'd `&'static [u8]` slabs; the
+    /// AtomicUsize accumulator mirrors `touch_bytes` so loads are not DCE'd.
+    /// Returns bytes touched (non-zero ⇒ real floor slabs were faulted).
+    /// E7 Fix #5B (2026-07-03): `include_forward_offsets` extends the floor to
+    /// `forward_offsets.bin`. That slab is NOT part of the per-candidate codec
+    /// read the gate-c 0.55 bar models (candidates are read via posting-pack
+    /// ranges; the offsets array is touched only by the per-winner
+    /// `id_from_range` binary searches) and it is byte-for-byte the same size
+    /// with the same access pattern in both layouts — i.e. a symmetric constant,
+    /// like the posting lists and doc mapping. `false` preserves the Fix #4
+    /// footing exactly.
+    pub fn prefault_floor(&self, include_forward_offsets: bool) -> u64 {
+        let counter = AtomicUsize::new(0);
+        // Posting-list index (the 17% packed_postings + 1% block_offsets + 44%
+        // summaries elephant — all formulae that fault identically per codec).
+        touch_bytes(self._postings_mmap, &counter);
+        // Doc-mapping strings + offsets (the C2 zero-copy-id floor).
+        if let Some(s) = self._doc_strings_mmap {
+            touch_bytes(s, &counter);
+        }
+        if let Some(o) = self._doc_offsets_mmap {
+            touch_bytes(cast_pod_bytes(o), &counter);
+        }
+        if include_forward_offsets {
+            touch_bytes(self._forward_offsets_mmap, &counter);
+        }
+        counter.load(std::sync::atomic::Ordering::Relaxed) as u64
+    }
+
+    /// F4 (2026-07-14, disk-streaming Phase 2): f16 twin of the dotvbyte
+    /// `mlock_floor`. Locks the floor slabs (postings + doc-mapping + optional
+    /// forward_offsets). The f16 path is the rollback/quality baseline, not the
+    /// served dv2 path; included for parity so the same Python wiring works on
+    /// either codec. Returns bytes locked (0 ⇒ mlock denied — no-op, not crash).
+    pub fn mlock_floor(&self, include_forward_offsets: bool) -> u64 {
+        let counter = AtomicUsize::new(0);
+        mlock_bytes(self._postings_mmap, &counter);
+        if let Some(s) = self._doc_strings_mmap {
+            mlock_bytes(s, &counter);
+        }
+        if let Some(o) = self._doc_offsets_mmap {
+            mlock_bytes(cast_pod_bytes(o), &counter);
+        }
+        if include_forward_offsets {
+            mlock_bytes(self._forward_offsets_mmap, &counter);
+        }
+        counter.load(std::sync::atomic::Ordering::Relaxed) as u64
+    }
+
+    /// F3 (2026-07-14, disk-streaming Phase 3): f16 twin. Extents are pinned
+    /// against `_forward_values_mmap` (the f16 codec slab; the dv analog is
+    /// `_fwd_data_mmap`). NOTE: f16's `search_visited` returns component
+    /// indices, not word offsets, so the F2 sidecar's page coord system for f16
+    /// differs from dv — the served dv2 path is the primary consumer; this hook
+    /// exists for parity, not for a measured f16 A/B. T1-untouched (residency).
+    pub fn mlock_ranges(&self, extents: &[(usize, usize)]) -> u64 {
+        let counter = AtomicUsize::new(0);
+        for &(page_start, page_len) in extents {
+            let off = page_start.saturating_mul(4096);
+            let len = page_len.saturating_mul(4096);
+            if off >= self._forward_values_mmap.len() || len == 0 {
+                continue;
+            }
+            let end = (off + len).min(self._forward_values_mmap.len());
+            mlock_bytes(&self._forward_values_mmap[off..end], &counter);
+        }
+        counter.load(std::sync::atomic::Ordering::Relaxed) as u64
+    }
+
+    /// F5 (2026-07-14, disk-streaming Phase 4): f16 twin — DONTNEED the mapped
+    /// slabs except the pinned extents. Sequential/cold arm only. T1-untouched
+    /// (residency only). SCOPE FIX 2026-08-31: see the dotvbyte twin's docstring
+    /// — as built this released only `_forward_values_mmap`, leaving the whole
+    /// structural residue resident.
+    ///
+    /// f16 note: `_forward_components_mmap` is forward-codec data, but f16's
+    /// `search_visited` returns component indices, not word offsets, so the F2
+    /// sidecar's page coords cannot name a page in it (see `mlock_ranges`). It
+    /// therefore rides with the (B) group and is released whole.
+    pub fn release_pages_except(&self, pinned_extents: &[(usize, usize)],
+                                keep_structural: bool) -> u64 {
+        self.release_pages_except_by_slab(pinned_extents, keep_structural)
+            .iter()
+            .map(|(_, n)| *n)
+            .sum()
+    }
+
+    /// F5 scope fix (2026-08-31): f16 twin of the per-slab breakdown.
+    pub fn release_pages_except_by_slab(&self, pinned_extents: &[(usize, usize)],
+                                        keep_structural: bool)
+                                        -> Vec<(&'static str, u64)> {
+        let mut out: Vec<(&'static str, u64)> = Vec::with_capacity(6);
+        let counter = AtomicUsize::new(0);
+        out.push(("forward_values",
+                  release_bytes_except(self._forward_values_mmap, pinned_extents, &counter)));
+        out.push(("forward_components",
+                  release_bytes(self._forward_components_mmap, &counter)));
+        if !keep_structural {
+            out.push(("forward_offsets", release_bytes(self._forward_offsets_mmap, &counter)));
+            out.push(("postings", release_bytes(self._postings_mmap, &counter)));
+            if let Some(s) = self._doc_strings_mmap {
+                out.push(("doc_strings", release_bytes(s, &counter)));
+            }
+            if let Some(o) = self._doc_offsets_mmap {
+                out.push(("doc_offsets", release_bytes(o, &counter)));
+            }
+        }
+        out
+    }
+
+    /// F3/F5 helper (2026-07-14): the f16 codec slab's byte length (analog of
+    /// the dotvbyte `forward_data_len`).
+    pub fn forward_data_len(&self) -> usize {
+        self._forward_values_mmap.len()
+    }
+
+    /// F6 (2026-07-14, disk-streaming Phase 6): f16 twin of the dotvbyte
+    /// `prefault_ranges` — Q9-style fault-in of the hot forward extents into
+    /// the page cache (NOT mlock — reclaimable). See the dotvbyte twin's
+    /// docstring. f16 is the rollback/quality baseline; the served dv2 path is
+    /// the primary consumer. T1-untouched (residency only).
+    pub fn prefault_ranges(&self, extents: &[(usize, usize)]) -> u64 {
+        let counter = AtomicUsize::new(0);
+        for &(page_start, page_len) in extents {
+            let off = page_start.saturating_mul(4096);
+            let len = page_len.saturating_mul(4096);
+            if off >= self._forward_values_mmap.len() || len == 0 {
+                continue;
+            }
+            let end = (off + len).min(self._forward_values_mmap.len());
+            touch_bytes(&self._forward_values_mmap[off..end], &counter);
+        }
+        counter.load(std::sync::atomic::Ordering::Relaxed) as u64
+    }
+
+    /// C2: number of documents in the optional doc-mapping slab.
+    pub fn n_doc_mapping(&self) -> usize {
+        self.doc_mapping.map(|m| m.len()).unwrap_or(0)
+    }
+
+    /// C2: return a doc ID as a zero-copy string slice, if a mapping exists.
+    pub fn doc_id(&self, doc_idx: usize) -> Option<&'static str> {
+        self.doc_mapping.as_ref().and_then(|m| m.get(doc_idx))
+    }
+}
+
+/// C2 helper: dense fault-in of one mmap'd byte range. Applies `MADV_WILLNEED`
+/// and `MADV_SEQUENTIAL` then reads the first byte of every page so the kernel
+/// actually faults the pages in. Uses an `AtomicU64` counter so the loads are
+/// observable and cannot be optimized away (C2 first attempt saw 0.01s over
+/// 1.7 GB — DCE). Returns the accumulated checksum.
+fn touch_bytes(bytes: &[u8], counter: &AtomicUsize) -> u64 {
+    if bytes.is_empty() {
+        return 0;
+    }
+    // SAFETY: `bytes` is a read-only mmap'd slice; madvise does not write and is
+    // safe to call on the mapping base address.
+    unsafe {
+        let ptr = bytes.as_ptr() as *mut core::ffi::c_void;
+        let _ = os_madvise(ptr, bytes.len(), Advice::WillNeed);
+        let _ = os_madvise(ptr, bytes.len(), Advice::Sequential);
+    }
+    // Use an atomic to guarantee the reads happen; plain u64 accumulator was
+    // compiled out on the first C2 run (fault-in appeared instant, RssFile unchanged).
+    let local = AtomicU64::new(0);
+    for chunk in bytes.chunks(4096) {
+        local.fetch_add(chunk[0] as u64, Ordering::Relaxed);
+    }
+    let sum = local.load(Ordering::Relaxed);
+    // Add the file-level checksum to the cross-file counter so callers observe it.
+    counter.fetch_add(sum as usize, Ordering::Relaxed);
+    sum
+}
+
+/// C2 helper: reinterpret a Pod slice as its underlying byte slice for the dense
+/// fault-in pass. No copy; only used for reducing reads.
+fn cast_pod_bytes<T: Pod>(slice: &[T]) -> &[u8] {
+    bytemuck::cast_slice(slice)
+}
+
+/// Sequential mechanism (B) helper: `madvise(MADV_DONTNEED)` one mmap'd byte
+/// range to drop its resident pages (re-faulted from file on next access).
+/// Mirrors `touch_bytes` minus the fault-in read (DONTNEED evicts; it does not
+/// need to touch pages). Adds the range length to the counter so callers can
+/// confirm the call covered real ranges (checksum-style, like `touch_bytes`).
+///
+/// F5 fix 2026-08-31: the length is added **only if `madvise` returned 0**.
+/// `MADV_DONTNEED` fails with EINVAL over `mlock`ed ranges (doc 02 §4), and the
+/// pre-fix accounting credited those bytes anyway — producing "released N GB"
+/// logs that no RssFile drop corroborated.
+fn release_bytes(bytes: &[u8], counter: &AtomicUsize) -> u64 {
+    if bytes.is_empty() {
+        return 0;
+    }
+    // SAFETY: `bytes` is a read-only mmap'd slice; madvise does not write and is
+    // safe to call on the mapping base address (same reasoning as `touch_bytes`).
+    let rc = unsafe {
+        let ptr = bytes.as_ptr() as *mut core::ffi::c_void;
+        os_madvise(ptr, bytes.len(), Advice::DontNeed)
+    };
+    if rc != 0 {
+        return 0;
+    }
+    let n = bytes.len() as u64;
+    counter.fetch_add(n as usize, Ordering::Relaxed);
+    n
+}
+
+/// F3/F4 (2026-07-14, disk-streaming Phase 2/3): lock one mmap'd byte range
+/// into RAM via `mlock(2)` so the kernel can never evict it (the colibrì `pin`
+/// analog over our mmap substrate). Pages are faulted-in first (mlock on an
+/// un-faulted mapping faults it in, but an explicit `touch_bytes`-style pass is
+/// left to the caller's `prefault_floor`/`prefault_ranges` — this fn only
+/// guarantees residency ONCE faulted). Returns bytes locked (checksum-style).
+///
+/// Safe enough: `mlock` does not write and the slab is a read-only mmap'd
+/// `&'static [u8]` (same reasoning as `release_bytes`). `mlock` may require
+/// `CAP_IPC_LOCK` (ulimit -l); a permission failure is reported in the counter
+/// (caller surfaces it) rather than panicking — a non-locking fallback keeps
+/// the served path working unprivileged (the pin tier degrades to no-op, NOT
+/// a crash). Mirrors `touch_bytes`/`release_bytes`'s counter contract.
+fn mlock_bytes(bytes: &[u8], counter: &AtomicUsize) -> u64 {
+    if bytes.is_empty() {
+        return 0;
+    }
+    // SAFETY: `bytes` is a read-only mmap'd slice; mlock does not write and is
+    // safe to call on the mapping base address (the pages become wired, but
+    // the data is read-only identical). A permission failure returns EPERM/
+    // ENOMEM without corrupting the mapping — we swallow it and report 0 locked.
+    let locked = unsafe {
+        let ptr = bytes.as_ptr() as *const core::ffi::c_void;
+        os_mlock(ptr, bytes.len())
+    };
+    let n = if locked == 0 {
+        bytes.len() as u64
+    } else {
+        0 // EPERM (no CAP_IPC_LOCK) or ENOMEM (over ulimit -l) → no-op, not fatal.
+    };
+    counter.fetch_add(n as usize, Ordering::Relaxed);
+    n
+}
+
+/// F5 (2026-07-14, disk-streaming Phase 4): `madvise(MADV_DONTNEED)` every page
+/// range in `bytes` EXCEPT the ones covered by `keep_extents` (sorted, asc,
+/// `(page_start, page_len)` page-id extents within `bytes`). Plain DONTNEED
+/// **EINVALs on mlocked ranges** (doc 02 §4), and even where it succeeds it
+/// would evict exactly the hot pages F3 just pinned — so the split keeps the
+/// pinned extents resident and evicts only the unpinned remainder. Returns bytes
+/// advised (the released remainder, not the kept extents). Mirrors
+/// `release_bytes`'s counter contract.
+///
+/// SAFETY: same as `release_bytes` (read-only mmap'd `&'static [u8]`).
+fn release_bytes_except(bytes: &[u8], keep_extents: &[(usize, usize)],
+                        counter: &AtomicUsize) -> u64 {
+    if bytes.is_empty() {
+        return 0;
+    }
+    let page = 4096usize;
+    let total_pages = bytes.len().div_ceil(page);
+    // Build a page-aligned keep-set clamped to [0, total_pages).
+    let mut keep: Vec<bool> = vec![false; total_pages];
+    for &(start, len) in keep_extents {
+        // Clamp the (page_start, page_len) extent to [0, total_pages); a
+        // sidecar from a different layout / stale shard could reference pages
+        // past this slab's end — clamp rather than panic (loader key-mismatch
+        // is the primary guard; this is the defense-in-depth).
+        let s = start.min(total_pages);
+        let e = start.saturating_add(len).min(total_pages);
+        if s < e {
+            for p in s..e {
+                keep[p] = true;
+            }
+        }
+    }
+    let mut released: u64 = 0;
+    let base = bytes.as_ptr() as *mut core::ffi::c_void;
+    // Walk page-by-page; DONTNEED the gaps between kept extents. Coalescing
+    // contiguous release runs into one madvise call (fewer syscalls) but
+    // keeping it page-granular is simplest and correct; the DV forward slab is
+    // ~1M pages so the syscall count is acceptable for the cold arm.
+    let mut gap_start: Option<usize> = None;
+    for p in 0..total_pages {
+        if keep[p] {
+            if let Some(s) = gap_start {
+                let off = (s * page) as usize;
+                let len = (p - s) * page;
+                if len > 0 {
+                    // F5 fix 2026-08-31: only count what madvise accepted
+                    // (EINVAL over mlocked ranges ⇒ nothing was released).
+                    let rc = unsafe { os_madvise(base.add(off), len, Advice::DontNeed) };
+                    if rc == 0 {
+                        released += len as u64;
+                    }
+                }
+                gap_start = None;
+            }
+        } else if gap_start.is_none() {
+            gap_start = Some(p);
+        }
+    }
+    if let Some(s) = gap_start {
+        let off = (s * page) as usize;
+        let len = (total_pages - s) * page;
+        let len = len.min(bytes.len() - off);
+        if len > 0 {
+            let rc = unsafe { os_madvise(base.add(off), len, Advice::DontNeed) };
+            if rc == 0 {
+                released += len as u64;
+            }
+        }
+    }
+    counter.fetch_add(released as usize, Ordering::Relaxed);
+    released
+}
+
+fn leak_mmap(path: std::path::PathBuf) -> std::io::Result<&'static [u8]> {
+    leak_mmap_advise(path, false)
+}
+
+/// `leak_mmap` with an optional `MADV_RANDOM` hint (E7 Fix #2, the audit's E2).
+/// `random=true` tells the kernel to disable readahead for this mapping — the
+/// forward-index candidate reads are ~200 B random bursts (one per scored doc),
+/// so default speculative readahead faults extra pages around each burst that are
+/// never reused, inflating the cold-pass majflt. `MADV_RANDOM` suppresses that
+/// overshoot. `MADV_DONTNEED` from `release_pages` evicts residency but does NOT
+/// clear this advice hint, so RANDOM persists across the gate's cold cycles.
+///
+/// Applied to the forward files ONLY (offsets/components or offsets/data);
+/// posting lists + doc-mapping slabs keep default advice (more sequential access).
+/// Safe: `madvise` does not write and the slab is a read-only `mmap`'d `&'static`.
+fn leak_mmap_advise(path: std::path::PathBuf, random: bool) -> std::io::Result<&'static [u8]> {
+    let file = File::open(path)?;
+    // SAFETY: read-only mmap of an immutable file. The Mmap is leaked for the
+    // spike (see module docs: a wired-in serve path uses owning_ref instead).
+    let mmap = unsafe { Mmap::map(&file)? };
+    // Leak the Mmap (it owns the mapping) into a &'static. The Mmap implements
+    // Deref<Target = [u8]>, so we leak the Box<Mmap> and take a &'static slice
+    // from it. The bytes live for the process lifetime (spike-only).
+    let leaked: &'static mut Mmap = Box::leak(Box::new(mmap));
+    // SAFETY: the Mmap is 'static now (leaked), and Deref gives &[u8] borrowing
+    // from it. Extend the borrow to 'static — sound because the Mmap is never
+    // freed (leaked) and is never mutated (read-only mmap).
+    let bytes: &'static [u8] = unsafe {
+        std::slice::from_raw_parts(leaked.as_ptr(), leaked.len())
+    };
+    if random && !bytes.is_empty() {
+        // SAFETY: `bytes` is a read-only mmap'd slice; madvise does not write and
+        // is safe on the mapping base address (same reasoning as `touch_bytes`).
+        unsafe {
+            let ptr = bytes.as_ptr() as *mut core::ffi::c_void;
+            let _ = os_madvise(ptr, bytes.len(), Advice::Random);
+        }
+    }
+    Ok(bytes)
+}
+
+fn slice_pod<T: Pod>(bytes: &[u8]) -> &[T] {
+    // Guard alignment + length: the slice must be a whole number of T with the
+    // right alignment. We trust the manifest here (writer+reader are co-built).
+    assert!(
+        bytes.as_ptr() as usize % std::mem::align_of::<T>() == 0,
+        "alignment violation in mmap slice cast"
+    );
+    assert!(
+        bytes.len() % std::mem::size_of::<T>() == 0,
+        "length not a whole number of elements"
+    );
+    bytemuck::cast_slice(bytes)
+}
+
+/// C1a (2026-06-27): align the cursor to T's natural alignment, then read a
+/// `&[T]` of `n` elements from the mmap bytes, advancing the cursor. Mirrors
+/// the writer's `extend_pod` padding so mixed-type back-to-back slices stay
+/// naturally aligned (e.g. a u16 slice following a u64 region).
+fn read_pod<T: Pod>(bytes: &'static [u8], cursor: &mut usize, n: usize) -> &'static [T] {
+    let align = std::mem::align_of::<T>();
+    let cur = *cursor;
+    let pad = (align - (cur % align)) % align;
+    let start = cur + pad;
+    let nbytes = n * std::mem::size_of::<T>();
+    let slice = slice_pod(&bytes[start..start + nbytes]);
+    *cursor = start + nbytes;
+    slice
+}
+
+/// C1a: read a raw `&[u8]` (alignment-1) of `n` bytes.
+fn read_bytes(bytes: &'static [u8], cursor: &mut usize, n: usize) -> &'static [u8] {
+    let start = *cursor;
+    let slice = &bytes[start..start + n];
+    *cursor = start + n;
+    slice
+}
+
+// ---------------------------------------------------------------------------
+// E7 (2026-07-02) — compressed (DotVByteFixedU8) forward: reader + converter.
+// docs/seismic_150m_testbed/10_FORWARD_COMPRESSION_DESIGN.md. The posting
+// lists / summaries / block-skip math are IDENTICAL to the f16 path (shared
+// `read_posting_lists`); only the forward record format changes: interleaved
+// Stream-VByte gaps + FixedU8Q values in one `forward_data.bin`, so a scored
+// candidate faults ~1 page instead of ~2 (09 audit §3.2) and the forward
+// shrinks ~40%+. Value quality gate measured 2026-07-02: overlap@10 0.995
+// (seismic_e6b_fixedu8_quality_20260702.json).
+// ---------------------------------------------------------------------------
+
+/// The compressed mmap forward dataset (borrowed offsets/data over mmap).
+pub type MmapPackedForward<'a> = MmapPackedSparseDataset<'a, DotVByteFixedU8Encoder>;
+
+/// Mmap-backed whole index with the DotVByteFixedU8 compressed forward.
+/// Mirrors `MmapSeismicIndex` exactly except the forward type; the posting
+/// lists are reconstructed by the same `read_posting_lists` walk (byte layout
+/// unchanged — the converter rewrites only packed-posting words).
+pub struct MmapSeismicIndexDotVByte {
+    _fwd_offsets_mmap: &'static [u8],
+    _fwd_data_mmap: &'static [u8],
+    _postings_mmap: &'static [u8],
+    _doc_strings_mmap: Option<&'static [u8]>,
+    _doc_offsets_mmap: Option<&'static [u8]>,
+    forward: MmapPackedForward<'static>,
+    posting_lists: Box<[MmapPostingList<'static>]>,
+    #[allow(dead_code)]
+    config: Configuration,
+    doc_mapping: Option<MmapDocMapping<'static>>,
+    token_to_id_map: HashMap<String, usize>,
+}
+
+impl MmapSeismicIndexDotVByte {
+    /// Build from a directory written by `convert_f16_dir_to_dotvbyte`.
+    pub fn from_mmap(dir: &Path) -> Result<Self, std::io::Error> {
+        let manifest_json = std::fs::read_to_string(dir.join("manifest.json"))?;
+        let manifest: MmapManifest = serde_json::from_str(&manifest_json)
+            .map_err(|e| std::io::Error::new(std::io::ErrorKind::InvalidData, e))?;
+        if !manifest.is_dotvbyte() {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::InvalidData,
+                "manifest has no forward_format=dotvbyte_fixedu8 — load via MmapSeismicIndex",
+            ));
+        }
+        // Q1 E8: cross-version rejection. This reader understands record
+        // envelopes v1 (FixedU8Q 1/64) and v2 (per-doc f16 vmax). Anything
+        // newer must fail loudly — silent mis-decode is the failure mode the
+        // version field exists to prevent.
+        let version = manifest.forward_format_version();
+        if version != 1 && version != 2 {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::InvalidData,
+                format!(
+                    "dotvbyte dir has forward_format_version {version}; this reader \
+                     supports 1 (FixedU8Q) and 2 (per-doc scale) — rebuild the reader"
+                ),
+            ));
+        }
+        if manifest.has_knn {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::InvalidData,
+                "knn refine is not supported on the dotvbyte forward (none of the 150M shards carry one)",
+            ));
+        }
+
+        // ---- forward: word offsets + packed u64 data + owned encoder ----
+        // E7 Fix #2 REFUTED 2026-07-03 (Arm C + D): MADV_RANDOM quadruples dv's
+        // absolute faults (69k->236k) and worsens cold latency; the gate-c ratio
+        // "win" in Arm C (0.54) was an artifact of MADV_RANDOM hurting f16
+        // *worse* (3.74x) than dv (3.41x), not a genuine dv benefit — proven by
+        // Arm D (dv-only): ratio jumps to 2.017 (dv twice f16's faults). Fix #2
+        // is therefore DISABLED (random=false everywhere); `leak_mmap_advise`
+        // kept as infrastructure. See docs 10 §7 amendment.
+        let fwd_offsets_mmap = leak_mmap_advise(dir.join("forward_offsets.bin"), false)?;
+        let fwd_offsets: &'static [usize] = bytemuck::cast_slice(fwd_offsets_mmap);
+        debug_assert_eq!(fwd_offsets.len(), manifest.forward_offsets_len);
+        let fwd_data_mmap = leak_mmap_advise(dir.join("forward_data.bin"), false)?;
+        let fwd_data: &'static [u64] = bytemuck::cast_slice(fwd_data_mmap);
+        debug_assert_eq!(fwd_data.len(), manifest.forward_data_words);
+
+        let enc_bytes = std::fs::read(dir.join("forward_encoder.bin"))?;
+        let bin_cfg = bincode::config::standard()
+            .with_fixed_int_encoding()
+            .with_little_endian();
+        let (mut encoder, _): (DotVByteFixedU8Encoder, _) =
+            bincode::serde::decode_from_slice(&enc_bytes, bin_cfg)
+                .map_err(|e| std::io::Error::new(std::io::ErrorKind::InvalidData, e))?;
+        // Q1 E8: the value-scale mode is serde(skip) on the encoder (bincode is
+        // non-self-describing; a serialized field would break every v1
+        // forward_encoder.bin). The manifest version is the authority.
+        encoder.set_per_doc_scale(version == 2);
+
+        let forward: MmapPackedForward<'static> =
+            MmapPackedForward::from_raw_parts(fwd_offsets, fwd_data, encoder, manifest.forward_nnz);
+
+        // ---- posting lists: identical walk to the f16 reader ----
+        let pl_mmap = leak_mmap(dir.join("posting_lists.bin"))?;
+        let posting_lists = read_posting_lists(pl_mmap, &manifest);
+
+        let config: Configuration = serde_json::from_str(&manifest.config_json)
+            .map_err(|e| std::io::Error::new(std::io::ErrorKind::InvalidData, e))?;
+        let token_to_id_map = read_token_map(dir);
+        let (doc_mapping, doc_strings_mmap, doc_offsets_mmap) = read_doc_mapping(dir)?;
+
+        Ok(Self {
+            _fwd_offsets_mmap: fwd_offsets_mmap,
+            _fwd_data_mmap: fwd_data_mmap,
+            _postings_mmap: pl_mmap,
+            _doc_strings_mmap: doc_strings_mmap,
+            _doc_offsets_mmap: doc_offsets_mmap,
+            forward,
+            posting_lists: posting_lists.into_boxed_slice(),
+            config,
+            doc_mapping,
+            token_to_id_map,
+        })
+    }
+
+    /// Q1 E8: true when this dir carries the v2 per-doc-scale record envelope
+    /// (`forward_format_version == 2`, mirrored onto the encoder at load).
+    pub fn per_doc_scale(&self) -> bool {
+        self.forward.encoder().per_doc_scale()
+    }
+
+    /// Mirror of `MmapSeismicIndex::search_raw` with the compressed forward.
+    /// Concrete (no generics): `EncoderFor<MmapPackedForward>` is
+    /// `DotVByteFixedU8Encoder`, whose `QueryVector<'q>` IS
+    /// `SparseVectorView<'q, u16, f32>` and whose evaluator densifies the
+    /// query (including the trained component remap) — so candidates decode +
+    /// dot in one SIMD pass. Traversal body verbatim from the f16 twin. No knn
+    /// arm (rejected at load).
+    pub fn search_raw(
+        &self,
+        query_components_original: &[String],
+        query_values: &[f32],
+        k: usize,
+        query_cut: usize,
+        heap_factor: f32,
+        first_sorted: bool,
+    ) -> Vec<ScoredVectorDotProduct> {
+        self.search_raw_visited(
+            query_components_original, query_values, k, query_cut, heap_factor,
+            first_sorted,
+        ).0
+    }
+
+    /// Q6/E5 (2026-07-09): mirror of the f16 twin's `search_raw_visited` —
+    /// results + the traversal's scored-candidate range starts (word offsets
+    /// into `forward_data.bin` for this layout). See the f16 doc comment.
+    pub fn search_raw_visited(
+        &self,
+        query_components_original: &[String],
+        query_values: &[f32],
+        k: usize,
+        query_cut: usize,
+        heap_factor: f32,
+        first_sorted: bool,
+    ) -> (Vec<ScoredVectorDotProduct>, Vec<usize>) {
+        use crate::utils::KHeap;
+        use rustc_hash::FxHashSet;
+        use vectorium::dataset::ScoredRange;
+
+        let (filtered_components, filtered_values) = resolve_query_tokens::<u16>(
+            query_components_original,
+            query_values,
+            &self.token_to_id_map,
+        );
+        let query = SparseVectorView::new(
+            filtered_components.as_slice(),
+            filtered_values.as_slice(),
+        );
+
+        let query_components = query.components();
+        let query_values_slice = query.values();
+
+        assert!(
+            query_components.is_sorted(),
+            "Query components must be sorted in ascending order."
+        );
+
+        let mut evaluator = self.forward.encoder().query_evaluator(query);
+
+        let mut heap = KHeap::new(k);
+        let mut visited = FxHashSet::with_capacity_and_hasher(
+            query_cut.min(query_components.len()) * 5000,
+            Default::default(),
+        );
+
+        let mut iter = query_components
+            .iter()
+            .zip(query_values_slice)
+            .k_largest_by(query_cut, |a, b| a.1.total_cmp(b.1));
+        if first_sorted {
+            if let Some((&component_id, _value)) = iter.next() {
+                let component_idx: usize = component_id.as_();
+                self.posting_lists[component_idx].sort_and_search(
+                    &mut evaluator, &query, k, heap_factor, &mut heap, &mut visited,
+                    &self.forward, None,
+                );
+            }
+        }
+        for (&component_id, _value) in iter {
+            let component_idx: usize = component_id.as_();
+            self.posting_lists[component_idx].search(
+                &mut evaluator, &query, k, heap_factor, &mut heap, &mut visited,
+                &self.forward, None,
+            );
+        }
+
+        let visited_starts: Vec<usize> = visited.into_iter().collect();
+        (
+            heap.into_sorted_vec()
+                .into_iter()
+                .map(|scored| ScoredVectorDotProduct {
+                    distance: scored.distance,
+                    vector: self.forward.id_from_range(scored.range),
+                })
+                .collect(),
+            visited_starts,
+        )
+    }
+
+    /// Q3/M8 instrument (2026-07-10): `search_raw_visited` + the per-query
+    /// survivors-per-posting-block distribution. Returns (results, visited,
+    /// block_stats) where `block_stats[i]` = the number of candidate packs the
+    /// i-th surviving posting block contributed. The M8 register-blocked
+    /// kernel batches the candidates inside one `evaluate_posting_block` call;
+    /// if the typical surviving block contributes <2 candidates there is
+    /// nothing to batch (M8 dies on paper); >=4 → GO for the kernel (math
+    /// optimization 08 §M8). Quality-free: results are bit-identical to
+    /// `search_raw_visited` (the instrument only OBSERVES the count, it does
+    /// not change the traversal). The block_stats accumulator is threaded as
+    /// `Some(&mut)` only here; the served path passes None (zero overhead).
+    pub fn search_raw_block_stats(
+        &self,
+        query_components_original: &[String],
+        query_values: &[f32],
+        k: usize,
+        query_cut: usize,
+        heap_factor: f32,
+        first_sorted: bool,
+    ) -> (Vec<ScoredVectorDotProduct>, Vec<usize>, Vec<usize>) {
+        use crate::utils::KHeap;
+        use rustc_hash::FxHashSet;
+        use vectorium::dataset::ScoredRange;
+
+        let (filtered_components, filtered_values) = resolve_query_tokens::<u16>(
+            query_components_original,
+            query_values,
+            &self.token_to_id_map,
+        );
+        let query = SparseVectorView::new(
+            filtered_components.as_slice(),
+            filtered_values.as_slice(),
+        );
+
+        let query_components = query.components();
+        let query_values_slice = query.values();
+        assert!(query_components.is_sorted());
+
+        let mut evaluator = self.forward.encoder().query_evaluator(query);
+        let mut heap = KHeap::new(k);
+        let mut visited = FxHashSet::with_capacity_and_hasher(
+            query_cut.min(query_components.len()) * 5000,
+            Default::default(),
+        );
+        let mut block_stats: Vec<usize> = Vec::new();
+
+        let mut iter = query_components
+            .iter()
+            .zip(query_values_slice)
+            .k_largest_by(query_cut, |a, b| a.1.total_cmp(b.1));
+        if first_sorted {
+            if let Some((&component_id, _value)) = iter.next() {
+                let component_idx: usize = component_id.as_();
+                self.posting_lists[component_idx].sort_and_search(
+                    &mut evaluator, &query, k, heap_factor, &mut heap, &mut visited,
+                    &self.forward, Some(&mut block_stats),
+                );
+            }
+        }
+        for (&component_id, _value) in iter {
+            let component_idx: usize = component_id.as_();
+            self.posting_lists[component_idx].search(
+                &mut evaluator, &query, k, heap_factor, &mut heap, &mut visited,
+                &self.forward, Some(&mut block_stats),
+            );
+        }
+
+        let visited_starts: Vec<usize> = visited.into_iter().collect();
+        (
+            heap.into_sorted_vec()
+                .into_iter()
+                .map(|scored| ScoredVectorDotProduct {
+                    distance: scored.distance,
+                    vector: self.forward.id_from_range(scored.range),
+                })
+                .collect(),
+            visited_starts,
+            block_stats,
+        )
+    }
