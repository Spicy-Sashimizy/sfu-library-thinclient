+// In-place v3 A2b test support (2026-09-29): read a list's content back as
+// owned per-block data, so a fixture can rewrite a list into a heap unit.
+impl<'a> MmapQuantizedSummary<'a, u16> {
+    /// Per-block summary vectors (component ascending, dequantised value),
+    /// exactly the values `distances` multiplies by the query.
+    pub fn per_block_vectors(&self) -> Vec<(Vec<u16>, Vec<f32>)> {
+        let mut out: Vec<(Vec<u16>, Vec<f32>)> = vec![(Vec::new(), Vec::new()); self.n_summaries];
+        let mut emit = |c: u16, lo: usize, hi: usize| {
+            for pos in lo..hi {
+                let s_id = self.summaries_ids.get(pos).unwrap() as usize;
+                let v = self.values[pos] as f32 * self.quants[s_id] + self.minimums[s_id];
+                out[s_id].0.push(c);
+                out[s_id].1.push(v);
+            }
+        };
+        if let Some(cids) = self.component_ids {
+            for (i, &c) in cids.iter().enumerate() {
+                let lo = self.offsets.select(i).unwrap();
+                let hi = self.offsets.select(i + 1).unwrap();
+                emit(c, lo, hi);
+            }
+        } else if self.n_summaries > 0 {
+            for c in 0..self.dim {
+                let lo = self.offsets.select(c).unwrap() - c;
+                let hi = self.offsets.select(c + 1).unwrap() - (c + 1);
+                emit(c as u16, lo, hi);
+            }
+        }
+        out
+    }
+}
+
+impl<'a> MmapPostingList<'a> {
+    /// Raw posting words (v2/v3 bit layout), for fixtures.
+    pub fn posting_words(&self) -> Vec<u64> {
+        self.packed_postings.iter().map(v3_load_word).collect()
+    }
+
+    /// The summary view, for fixtures.
+    pub fn summary_view(&self) -> &MmapQuantizedSummary<'a, u16> {
+        &self.summaries
+    }
+}
