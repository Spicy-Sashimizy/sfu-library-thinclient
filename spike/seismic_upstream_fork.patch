+        // Query: tokens t1, t2 (component ids 1, 2) with values 3.0, 1.0.
+        let toks: Vec<String> = vec!["t1".to_string(), "t2".to_string()];
+        let vals: Vec<f32> = vec![3.0, 1.0];
+        let k = 3;
+        let query_cut = 2;
