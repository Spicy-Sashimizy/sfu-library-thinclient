+/// Heartbeat refresh interval (FORMAT_V3.md revision 4).
+pub const HEARTBEAT_NS: u64 = 10_000_000_000;
+
+/// A registered reader-table slot; cleared (epoch idle, then pid 0) on drop.
+pub struct ReaderGuard {
+    slot: Option<&'static [AtomicU64]>,
+    gen: u64,
+    pid: u64,
+    last: std::cell::Cell<u64>,
+}
+
+impl ReaderGuard {
+    /// Refresh the heartbeat if >= 10 s old; fail if the slot was reclaimed.
+    #[inline]
+    pub fn refresh(&self) -> Result<(), String> {
+        let Some(slot) = self.slot else { return Ok(()) };
+        let now = monotonic_ns();
+        if now.wrapping_sub(self.last.get()) < HEARTBEAT_NS {
+            return Ok(());
+        }
+        if slot[0].load(Ordering::SeqCst) != self.pid || slot[7].load(Ordering::SeqCst) != self.gen {
+            return Err("reader-table slot reclaimed as stale during the query".into());
+        }
+        slot[3].store(now, Ordering::SeqCst);
+        self.last.set(now);
+        Ok(())
+    }
+}
+
+impl Drop for ReaderGuard {
+    fn drop(&mut self) {
+        if let Some(slot) = self.slot {
+            if slot[0].load(Ordering::SeqCst) == self.pid && slot[7].load(Ordering::SeqCst) == self.gen {
+                slot[1].store(READER_IDLE, Ordering::SeqCst);
+                slot[0].store(0, Ordering::SeqCst);
+            }
+        }
+    }
+}
