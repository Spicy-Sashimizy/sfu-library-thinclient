+/// Test fixture (A2b read path, 2026-09-29): rewrite list `t` of a zero-patch
+/// v3 dir into a heap unit with block `drop_block` removed (postings of that
+/// block dropped, summary rebuilt from the dequantised per-block vectors of
+/// the remaining blocks), publish it in BOTH list_dir banks at epoch 0, and
+/// write `oracle_dir`: a dv-v2 dir whose posting_lists.bin carries the SAME
+/// list body natively (spliced in place of list t, manifest entry replaced;
+/// other files hard-linked). The v3 decoder serving the unit and the v2
+/// decoder serving the oracle must return identical results. With
+/// `poison_native_inflation` the active bank's codes of list t's native
+/// blocks are set to 255 (they must be ignored for a unit list). Offline
+/// fixture: written with pwrite before any reader maps the dir.
+pub fn a2b_fixture_rewrite_list(
+    v3_dir: &Path,
+    t: usize,
+    drop_block: usize,
+    oracle_dir: &Path,
+    poison_native_inflation: bool,
+) -> std::io::Result<serde_json::Value> {
+    use std::os::unix::fs::FileExt;
+    use vectorium::DatasetGrowable as _;
+    let r = MmapSeismicIndexInplaceV3::from_mmap(v3_dir)?;
+    let e = r.published_epoch().ok_or_else(|| inval("no header".into()))?;
+    if e != 0 || r.non_native_lists() != Some(0) {
+        return Err(inval("fixture needs a zero-patch v3 dir at epoch 0".into()));
+    }
+    let list = &r.inner.posting_lists_slice()[t];
+    let nb = list.n_blocks();
+    if nb < 2 || drop_block >= nb {
+        return Err(inval(format!("list {t} has {nb} blocks; cannot drop block {drop_block}")));
+    }
+    let words = list.posting_words();
+    let bo: Vec<usize> = list.block_offsets().to_vec();
+    let vecs = list.summary_view().per_block_vectors();
+    let mut new_words: Vec<u64> = Vec::new();
+    let mut new_bo: Vec<usize> = vec![0];
+    let mut new_vecs: Vec<(Vec<u16>, Vec<f32>)> = Vec::new();
+    for b in 0..nb {
+        if b == drop_block {
+            continue;
+        }
+        new_words.extend_from_slice(&words[bo[b]..bo[b + 1]]);
+        new_bo.push(new_words.len());
+        new_vecs.push(vecs[b].clone());
+    }
+    let dim = crate::mmap_io::manifest_list_scalars(v3_dir, t)?[3] as usize;
+    let q = vectorium::PlainSparseQuantizer::<u16, f32, vectorium::DotProduct>::new(dim, dim);
+    let mut g = vectorium::SparseDatasetGrowable::new(q);
+    for (c, v) in &new_vecs {
+        g.push(SparseVectorView::new(c.as_slice(), v.as_slice()));
+    }
+    let summary: QuantizedSummary<u16> = QuantizedSummary::from(vectorium::SparseDataset::from(g));
+    let mut body: Vec<u8> = Vec::new();
+    let m = extend_list_bytes(&mut body, &new_words, &new_bo, &summary);
+    while body.len() % 8 != 0 {
+        body.push(0);
+    }
+    let sc = m.to_scalars();
+    let mut hdr = vec![0u8; UNIT_HEADER];
+    hdr[0..8].copy_from_slice(&UNIT_MAGIC.to_le_bytes());
+    hdr[8..12].copy_from_slice(&(t as u32).to_le_bytes());
+    hdr[12..16].copy_from_slice(&(e as u32).to_le_bytes());
+    hdr[16..24].copy_from_slice(&(body.len() as u64).to_le_bytes());
+    for (i, x) in sc.iter().enumerate() {
+        hdr[24 + 8 * i..32 + 8 * i].copy_from_slice(&x.to_le_bytes());
+    }
+    let ck = fnv1a64_update(fnv1a64(&hdr[0..UNIT_CKSUM_AT]), &body);
+    hdr[UNIT_CKSUM_AT..UNIT_HEADER].copy_from_slice(&ck.to_le_bytes());
+    let unit_off = r.pl_len;
+    {
+        let f = std::fs::OpenOptions::new().write(true).open(v3_dir.join("posting_heap.bin"))?;
+        f.write_all_at(&hdr, 0)?;
+        f.write_all_at(&body, UNIT_HEADER as u64)?;
+        f.sync_all()?;
+        let d = std::fs::OpenOptions::new().write(true).open(v3_dir.join("list_dir.bin"))?;
+        d.write_all_at(&unit_off.to_le_bytes(), (8 * t) as u64)?;
+        d.write_all_at(&unit_off.to_le_bytes(), (8 * (r.n_lists + t)) as u64)?;
+        d.sync_all()?;
+        if poison_native_inflation {
+            let bi = std::fs::OpenOptions::new().write(true).open(v3_dir.join("block_inflation.bin"))?;
+            let n = r.block_base[t + 1] - r.block_base[t];
+            bi.write_all_at(&vec![255u8; n], r.block_base[t] as u64)?;
+            bi.sync_all()?;
+        }
+    }
+    std::fs::create_dir_all(oracle_dir)?;
+    for f in ["config.json", "forward_offsets.bin", "forward_data.bin", "forward_encoder.bin",
+              "token_to_id_map.bin", "document_mapping_strings.bin", "document_mapping_offsets.bin"] {
+        std::fs::hard_link(v3_dir.join(f), oracle_dir.join(f))?;
+    }
+    let pl = std::fs::read(v3_dir.join("posting_lists.bin"))?;
+    let pp_t = r.native_off[t] as usize;
+    let pp_next = if t + 1 < r.n_lists { r.native_off[t + 1] as usize } else { pl.len() };
+    let mut spliced = Vec::with_capacity(pl.len() + body.len());
+    spliced.extend_from_slice(&pl[..pp_t]);
+    spliced.extend_from_slice(&body);
+    spliced.extend_from_slice(&pl[pp_next..]);
+    write_all(&oracle_dir.join("posting_lists.bin"), &spliced)?;
+    let man_s = std::fs::read_to_string(v3_dir.join("manifest.json"))?;
+    let new_s = manifest_with_list_replaced(&man_s, t, &sc).map_err(inval)?;
+    let mut v: serde_json::Value = serde_json::from_str(&new_s).map_err(|e| inval(e.to_string()))?;
+    v.as_object_mut().unwrap().insert("forward_format_version".into(), serde_json::json!(2));
+    write_all(&oracle_dir.join("manifest.json"), &serde_json::to_vec_pretty(&v).map_err(|e| inval(e.to_string()))?)?;
+    Ok(serde_json::json!({
+        "list": t, "drop_block": drop_block, "old_blocks": nb, "new_blocks": nb - 1,
+        "old_postings": words.len(), "new_postings": new_words.len(),
+        "unit_offset": unit_off, "unit_body_bytes": body.len(), "unit_header_bytes": UNIT_HEADER,
+        "native_list_bytes": pp_next - pp_t, "poison_native_inflation": poison_native_inflation,
+        "oracle_dir": oracle_dir.to_string_lossy(),
+    }))
+}
