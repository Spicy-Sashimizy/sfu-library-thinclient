+/// E7: advance a walk cursor past `n` elements of `T` with the same alignment
+/// rule as `read_pod` (align to `T` first). Used by the converter to locate
+/// each list's packed-posting words without materializing the tail slices.
+fn skip_pod<T>(cursor: usize, n: usize) -> usize {
+    let align = std::mem::align_of::<T>();
+    let start = cursor + (align - (cursor % align)) % align;
+    start + n * std::mem::size_of::<T>()
+}
+
+/// E7 Fix #5 (2026-07-03): page-boundary-aware record placement for the packed
+/// dotvbyte forward. Gate c measured the dv forward at ~1.05 pages/candidate —
+/// the 5% excess over the modeled ~1 page/candidate is records straddling a
+/// 4 KiB boundary (pack-weighted straddle fraction 0.0501, measured over all
+/// 40.36M shard0 posting packs, 2026-07-03). This pass re-lays the records so
+/// no record straddles a page unless it is longer than a page.
+///
+/// Mechanism — the pad must not create dead bytes OUTSIDE records (every
+/// consumer derives record extents from `offsets[i]..offsets[i+1]`, and
+/// `id_from_range` asserts the searched range matches those bounds exactly).
+/// Instead, when the NEXT record would straddle, the gap up to the boundary is
+/// absorbed INSIDE the previous record as zero words inserted before its SIMD
+/// values tail. The DotVByte record format locates that tail from the slice
+/// END (`values_start = slice.len() - n_packs * 8` bytes; the dgap byte stream
+/// is walked from the front for exactly `n_packs` entries), so a mid-record
+/// zero run between the dgap bytes and the values tail is never read — decode
+/// is bit-identical. The padded record's page span is also unchanged: its new
+/// end is the next page boundary after its old end, i.e. the same last page.
+///
+/// Returns `(padded_data, padded_offsets, pad_words)`.
+fn page_align_packed_forward(
+    data: &[u64],
+    offsets: &[usize],
+) -> (Vec<u64>, Vec<usize>, usize) {
+    const PAGE_WORDS: usize = 4096 / std::mem::size_of::<u64>(); // 512
+
+    let n_docs = offsets.len() - 1;
+    let mut padded: Vec<u64> = Vec::with_capacity(data.len() + data.len() / 16);
+    let mut new_offsets: Vec<usize> = Vec::with_capacity(offsets.len());
+    new_offsets.push(0);
+    let mut pad_words_total = 0usize;
+
+    for i in 0..n_docs {
+        let rec = &data[offsets[i]..offsets[i + 1]];
+        let len = rec.len();
+        let w = padded.len();
+        let rem = w % PAGE_WORDS;
+        if rem != 0 && len > PAGE_WORDS - rem {
+            // Would straddle the next boundary. Compare spans: place at `w`
+            // vs place at the boundary (pad absorbed by the previous record).
+            let room = PAGE_WORDS - rem;
+            let span_at_w = 1 + (len - room).div_ceil(PAGE_WORDS);
+            let span_at_boundary = len.div_ceil(PAGE_WORDS);
+            if span_at_boundary < span_at_w {
+                // Insert `room` zero words into the PREVIOUS record, before its
+                // end-anchored values tail. n_packs = (first u16 of the record,
+                // its original component count) / 8; the values tail is n_packs
+                // Simd<u8,8> lanes = n_packs u64 words at the record's end.
+                let prev_start = new_offsets[i - 1]; // i >= 1: record 0 starts at w=0, rem=0
+                let orig_len = (padded[prev_start] & 0xFFFF) as usize; // first u16, little-endian
+                let n_packs = orig_len / 8;
+                let end = padded.len();
+                let tail_start = end - n_packs;
+                padded.resize(end + room, 0);
+                padded.copy_within(tail_start..end, tail_start + room);
+                for wd in &mut padded[tail_start..tail_start + room] {
+                    *wd = 0;
+                }
+                // The previous record's end (= this record's start) moved.
+                *new_offsets.last_mut().unwrap() += room;
+                pad_words_total += room;
+            }
+        }
+        padded.extend_from_slice(rec);
+        new_offsets.push(padded.len());
+    }
+    (padded, new_offsets, pad_words_total)
+}
