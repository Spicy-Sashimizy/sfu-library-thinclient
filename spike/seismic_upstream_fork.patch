+/// E7 (2026-07-02): convert an f16 flat `.mmap` dir (the C2 layout) into the
+/// compressed dotvbyte layout, entirely at the FILE level — no
+/// `.index.seismic` source needed (the K=8 sources are gone from /tmp; the
+/// persistent converted dirs are the artifact of record):
+///
+/// 1. forward: mmap the f16 forward, encode every doc via the existing
+///    `From<SparseDatasetGeneric<…>> for PackedSparseDataset<DotVByteFixedU8Encoder>`
+///    (trains the component remap on a 5% sample, then Stream-VByte-packs
+///    gaps + FixedU8Q values) → `forward_data.bin` + word `forward_offsets.bin`
+///    + bincode'd `forward_encoder.bin`.
+/// 2. posting lists: byte-copy `posting_lists.bin`, rewriting ONLY each packed
+///    posting's u64 — old (element-offset:48 | nnz:16) → new (word-offset:48 |
+///    word-len:16), doc resolved by binary search over the old offsets. Block
+///    offsets, summaries, EliasFano — untouched bytes, so the block-skip math
+///    is bit-identical to the f16 shard.
+/// 3. copy config/token map/doc mapping verbatim; write the updated manifest.
+///
+/// Q1 E8 (2026-07-10): the doc-value quantization scale of the produced dir.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum ValueScale {
+    /// v1: global FixedU8Q 1/64 (`forward_format_version` 1) — the served format.
+    Fixed,
+    /// v2: per-doc linear u8 + record-head f16 vmax (`forward_format_version` 2).
+    PerDocLinear,
+}
+
+/// Returns a JSON report (sizes, timings, sanity-decode stats). `sample_check`
+/// docs are decode-verified: components must round-trip EXACTLY; values within
+/// the quantization step (`Fixed`: the global 1/64; `PerDocLinear`: the
+/// per-doc `vmax/255`).
+pub fn convert_f16_dir_to_dotvbyte(
+    src: &Path,
+    dst: &Path,
+    sample_check: usize,
+    page_align: bool,
+    value_scale: ValueScale,
+) -> Result<serde_json::Value, std::io::Error> {
+    use std::time::Instant;
+    use vectorium::vector_encoder::SparseDataEncoder as _;
+    let inval = |m: String| std::io::Error::new(std::io::ErrorKind::InvalidData, m);
+
+    let manifest_json = std::fs::read_to_string(src.join("manifest.json"))?;
+    let mut manifest: MmapManifest = serde_json::from_str(&manifest_json)
+        .map_err(|e| inval(e.to_string()))?;
+    if manifest.is_dotvbyte() {
+        return Err(inval("source dir is already dotvbyte".into()));
+    }
+    if manifest.has_knn {
+        return Err(inval("knn-carrying index unsupported by the dotvbyte converter".into()));
+    }
+    std::fs::create_dir_all(dst)?;
+
+    // ---- 1. forward encode (mmap-read source, owned packed output) ----
+    let fwd_offsets_mmap = leak_mmap(src.join("forward_offsets.bin"))?;
+    let old_offsets: &'static [usize] = bytemuck::cast_slice(fwd_offsets_mmap);
+    let comps_mmap = leak_mmap(src.join("forward_components.bin"))?;
+    let comps: &'static [u16] = bytemuck::cast_slice(comps_mmap);
+    let vals_mmap = leak_mmap(src.join("forward_values.bin"))?;
+    let vals: &'static [f16] = bytemuck::cast_slice(vals_mmap);
+
+    let storage = MmapSparseStorage::<IndexQuantizer>::from_raw_parts(old_offsets, comps, vals);
+    let dim = manifest.posting_lists.first().map(|m| m.dim).unwrap_or(0);
+    let encoder = ScalarSparseQuantizer::<u16, f32, f16, DotProduct>::new(dim, dim);
+    let fwd: MmapForward<'static> =
+        SparseDatasetGeneric::from_raw_parts(storage, manifest.n_docs, encoder);
+
+    let t_enc = Instant::now();
+    let packed: PackedSparseDataset<DotVByteFixedU8Encoder> = match value_scale {
+        ValueScale::Fixed => fwd.into(),
+        // Q1 E8 v2: per-doc scale needs the ORIGINAL f16 values (the v1 From
+        // routes through the global 1/64 quantizer and loses them).
+        ValueScale::PerDocLinear => PackedSparseDataset::from_per_doc_scale(fwd),
+    };
+    let encode_s = t_enc.elapsed().as_secs_f64();
+    let new_offsets: &[usize] = packed.offsets();
+    assert_eq!(new_offsets.len(), manifest.n_docs + 1, "packed offsets cardinality");
+
+    // ---- sanity: decode-compare a doc sample against the f16 source ----
+    let mut max_val_absdiff = 0f32;
+    let n_docs = manifest.n_docs;
+    let step = (n_docs / sample_check.max(1)).max(1);
+    let mut checked = 0usize;
+    for i in (0..n_docs).step_by(step) {
+        let dec = packed.encoder().decode_vector(packed.get(i as u64));
+        let s = old_offsets[i];
+        let e = old_offsets[i + 1];
+        if dec.components() != &comps[s..e] {
+            return Err(inval(format!("sanity FAIL: components mismatch at doc {i}")));
+        }
+        let mut doc_max_absdiff = 0f32;
+        for (dv, sv) in dec.values().iter().zip(&vals[s..e]) {
+            let d = (dv - sv.to_f32()).abs();
+            if d > doc_max_absdiff {
+                doc_max_absdiff = d;
+            }
+        }
+        if doc_max_absdiff > max_val_absdiff {
+            max_val_absdiff = doc_max_absdiff;
+        }
+        // Q1 E8 v2: the quantization step is per-doc (vmax/255), so the bound
+        // must be checked per doc, not globally.
+        if value_scale == ValueScale::PerDocLinear {
+            let vmax_src = vals[s..e].iter().fold(0f32, |a, &b| a.max(b.to_f32()));
+            let vmax = if vmax_src > 0.0 { vmax_src } else { 1.0 }; // encoder's all-zero rule
+            let doc_step = f16::from_f32(vmax).to_f32() / 255.0;
+            if doc_max_absdiff > doc_step + 1e-6 {
+                return Err(inval(format!(
+                    "sanity FAIL: doc {i} value absdiff {doc_max_absdiff} exceeds \
+                     its per-doc step {doc_step}"
+                )));
+            }
+        }
+        checked += 1;
+    }
+    if value_scale == ValueScale::Fixed && max_val_absdiff > 1.0 / 64.0 + 1e-6 {
+        return Err(inval(format!(
+            "sanity FAIL: value absdiff {max_val_absdiff} exceeds the FixedU8Q step 1/64"
+        )));
+    }
+
+    // ---- E7 Fix #5: optional page-boundary-aware re-layout ----
+    // Must happen BEFORE the posting-pack rewrite (which bakes the final word
+    // offsets/lens into the packed postings). The padded offsets/data replace
+    // the packed ones everywhere below.
+    let (data_final, offsets_final, pad_words): (
+        std::borrow::Cow<[u64]>,
+        std::borrow::Cow<[usize]>,
+        usize,
+    ) = if page_align {
+        let (pd, po, pw) = page_align_packed_forward(packed.data(), new_offsets);
+        (std::borrow::Cow::Owned(pd), std::borrow::Cow::Owned(po), pw)
+    } else {
+        (
+            std::borrow::Cow::Borrowed(packed.data()),
+            std::borrow::Cow::Borrowed(new_offsets),
+            0,
+        )
+    };
+    let new_offsets: &[usize] = &offsets_final;
+
+    // Post-padding decode-verify: the padded records must still decode exactly
+    // (components lossless vs the f16 source; the pad is inside the record, so
+    // this exercises the real read path over the padded extents).
+    if page_align {
+        let padded_view: MmapPackedForward<'_> = MmapPackedForward::from_raw_parts(
+            new_offsets,
+            &data_final,
+            packed.encoder().clone(),
+            manifest.forward_components_len,
+        );
+        for i in (0..n_docs).step_by(step) {
+            let dec = padded_view.encoder().decode_vector(padded_view.get(i as u64));
+            let s = old_offsets[i];
+            let e = old_offsets[i + 1];
+            if dec.components() != &comps[s..e] {
+                return Err(inval(format!(
+                    "page-align sanity FAIL: components mismatch at doc {i} after padding"
+                )));
+            }
+        }
+        // No record may straddle a 4 KiB boundary unless longer than a page.
+        const PAGE_WORDS: usize = 512;
+        for i in 0..n_docs {
+            let (s, e) = (new_offsets[i], new_offsets[i + 1]);
+            let span = (e - 1) / PAGE_WORDS - s / PAGE_WORDS + 1;
+            let min_span = (e - s).div_ceil(PAGE_WORDS);
+            if span > min_span {
+                return Err(inval(format!(
+                    "page-align sanity FAIL: doc {i} spans {span} pages (min {min_span})"
+                )));
+            }
+        }
+    }
+
+    write_pod_slice(&dst.join("forward_offsets.bin"), new_offsets)?;
+    write_pod_slice(&dst.join("forward_data.bin"), &data_final)?;
+    {
+        let bin_cfg = bincode::config::standard()
+            .with_fixed_int_encoding()
+            .with_little_endian();
+        let bytes = bincode::serde::encode_to_vec(packed.encoder(), bin_cfg)
+            .map_err(|e| inval(e.to_string()))?;
+        write_file(&dst.join("forward_encoder.bin"), &bytes)?;
+    }
+
+    // ---- 2. posting lists: in-place word rewrite on a byte copy ----
+    let t_pl = Instant::now();
+    let mut pl = std::fs::read(src.join("posting_lists.bin"))?;
+    let mut cursor = 0usize;
+    let mut rewritten: u64 = 0;
+    for plm in &manifest.posting_lists {
+        // packed_postings — align exactly like read_pod::<u64>, then rewrite.
+        let start = {
+            let align = std::mem::align_of::<u64>();
+            cursor + (align - (cursor % align)) % align
+        };
+        for w in 0..plm.packed_postings_words {
+            let p = start + w * 8;
+            let word = u64::from_ne_bytes(pl[p..p + 8].try_into().unwrap());
+            let elem_start = (word >> 16) as usize;
+            let len = (word & (u16::MAX as u64)) as usize;
+            // Doc lookup: offsets are strictly increasing; the pack start IS
+            // a doc's element offset (posting_list.rs pack contract).
+            let doc = old_offsets.partition_point(|&o| o <= elem_start) - 1;
+            if old_offsets[doc] != elem_start || old_offsets[doc + 1] - elem_start != len {
+                return Err(inval(format!(
+                    "pack word does not match a doc boundary (elem_start={elem_start} len={len})"
+                )));
+            }
+            let ns = new_offsets[doc];
+            let nlen = new_offsets[doc + 1] - ns;
+            assert!(ns < (1u64 << 48) as usize, "word offset exceeds 48-bit pack");
+            assert!(nlen <= u16::MAX as usize, "word len exceeds 16-bit pack");
+            let new_word = ((ns as u64) << 16) | (nlen as u64);
+            pl[p..p + 8].copy_from_slice(&new_word.to_ne_bytes());
+            rewritten += 1;
+        }
+        cursor = start + plm.packed_postings_words * 8;
+        // Skip the untouched tail slices with the reader's alignment walk.
+        cursor = skip_pod::<usize>(cursor, plm.block_offsets_len);
+        cursor = skip_pod::<u64>(cursor, plm.ef_high_bits_n_words);
+        cursor = skip_pod::<i64>(cursor, plm.inv_block_inventory_len);
+        cursor = skip_pod::<u16>(cursor, plm.inv_subblock_inventory_len);
+        cursor = skip_pod::<usize>(cursor, plm.inv_overflow_positions_len);
+        cursor = skip_pod::<u64>(cursor, plm.ef_low_bits_n_words);
+        cursor = skip_pod::<u64>(cursor, plm.summaries_ids_n_words);
+        cursor += plm.values_len; // u8 run — read_bytes does not align
+        cursor = skip_pod::<f32>(cursor, plm.minimums_len);
+        cursor = skip_pod::<f32>(cursor, plm.quants_len);
+        if plm.has_component_ids {
+            cursor = skip_pod::<u16>(cursor, plm.component_ids_len);
+        }
+    }
+    if cursor > pl.len() || pl.len() - cursor >= 8 {
+        return Err(inval(format!(
+            "posting walk desync: cursor {cursor} vs file {} — layout drift?",
+            pl.len()
+        )));
+    }
+    write_file(&dst.join("posting_lists.bin"), &pl)?;
+    let postings_s = t_pl.elapsed().as_secs_f64();
+
+    // ---- 3. verbatim copies + manifest ----
+    for f in ["config.json", "token_to_id_map.bin",
+              "document_mapping_strings.bin", "document_mapping_offsets.bin"] {
+        if src.join(f).exists() {
+            std::fs::copy(src.join(f), dst.join(f))?;
+        }
+    }
+    let forward_nnz = manifest.forward_components_len;
+    manifest.forward_format = Some("dotvbyte_fixedu8".to_string());
+    // Q1 E8: the record-envelope version is the load-bearing tag the reader
+    // branches on (v1 = FixedU8Q 1/64; v2 = per-doc f16 vmax at the record head).
+    manifest.forward_format_version = match value_scale {
+        ValueScale::Fixed => 1,
+        ValueScale::PerDocLinear => 2,
+    };
+    manifest.forward_data_words = data_final.len();
+    manifest.forward_nnz = forward_nnz;
+    manifest.forward_offsets_len = new_offsets.len();
+    manifest.forward_components_len = 0;
+    manifest.forward_values_len = 0;
+    manifest.forward_page_aligned = page_align;
+    let manifest_json = serde_json::to_string_pretty(&manifest)
+        .map_err(|e| inval(e.to_string()))?;
+    write_file(&dst.join("manifest.json"), manifest_json.as_bytes())?;
+
+    let old_fwd_bytes = (comps.len() + vals.len()) * 2 + old_offsets.len() * 8;
+    let new_fwd_bytes = data_final.len() * 8 + new_offsets.len() * 8;
+    Ok(serde_json::json!({
+        "n_docs": n_docs,
+        "nnz": forward_nnz,
+        "encode_seconds": encode_s,
+        "postings_rewrite_seconds": postings_s,
+        "packs_rewritten": rewritten,
+        "sanity_docs_checked": checked,
+        "sanity_max_value_absdiff": max_val_absdiff,
+        "forward_bytes": {"f16": old_fwd_bytes, "dotvbyte": new_fwd_bytes,
+                           "ratio": old_fwd_bytes as f64 / new_fwd_bytes as f64},
+        "component_mapping_trained": packed.encoder().component_mapping().is_some(),
+        "value_scale": match value_scale {
+            ValueScale::Fixed => "fixed_1_64",
+            ValueScale::PerDocLinear => "per_doc_linear",
+        },
+        "forward_format_version": manifest.forward_format_version,
+        "page_align": {"enabled": page_align, "pad_words": pad_words,
+                        "growth_pct": 100.0 * (pad_words * 8) as f64
+                            / (data_final.len() * 8 - pad_words * 8).max(1) as f64},
+    }))
+}
+
+// ---------------------------------------------------------------------------
+// E5 (2026-07-09): reorder_mmap_dir — forward-locality permutation converter.
+// Design: docs/seismic_150m_testbed/13_E5_FORWARD_REORDER_DESIGN.md §2.
+// ---------------------------------------------------------------------------
+
+/// Rewrite an mmap shard dir (f16 OR dotvbyte) with its forward index permuted
+/// into a supplied doc order, remapping every packed posting's 48-bit range.
+/// Records move verbatim (byte-exact, NO padding — E7 Fix #5A refuted padding);
+/// summaries / block_offsets / EF structures are order-transparent and are
+/// carried inside the posting_lists.bin byte copy untouched. The doc-mapping
+/// slabs ARE permuted (rows are positional — the known E5 trap, doc 13 §2.1).
+///
+/// `perm_file`: u64[n_docs] little-endian, `perm[new_row] = old_row`, validated
+/// as a bijection. `order_name` lands in the manifest as `forward_reordered`
+/// provenance. `sample_check`: step-sampled byte-compare of moved records +
+/// doc-mapping strings (0 disables).
+pub fn reorder_mmap_dir(
+    src: &Path,
+    dst: &Path,
+    perm_file: &Path,
+    order_name: &str,
+    sample_check: usize,
+) -> Result<serde_json::Value, std::io::Error> {
+    use std::time::Instant;
+    let inval = |m: String| std::io::Error::new(std::io::ErrorKind::InvalidData, m);
+
+    let manifest_json = std::fs::read_to_string(src.join("manifest.json"))?;
+    let mut manifest: MmapManifest = serde_json::from_str(&manifest_json)
+        .map_err(|e| inval(e.to_string()))?;
+    if manifest.has_knn {
+        return Err(inval("knn-carrying index unsupported by the reorder converter".into()));
+    }
+    if manifest.forward_page_aligned {
+        return Err(inval("page-aligned source unsupported (reorder would break the \
+                          alignment invariant; re-run the dv convert without --page-align)".into()));
+    }
+    let n_docs = manifest.n_docs;
+    let is_dv = manifest.is_dotvbyte();
+    std::fs::create_dir_all(dst)?;
+
+    // ---- 0. permutation: read + validate bijection, build inverse ----
+    let perm_bytes = std::fs::read(perm_file)?;
+    if perm_bytes.len() != n_docs * 8 {
+        return Err(inval(format!(
+            "perm file carries {} u64s, index has {n_docs} docs", perm_bytes.len() / 8)));
+    }
+    let perm: &[u64] = bytemuck::cast_slice(&perm_bytes);
+    let mut inv_perm = vec![u64::MAX; n_docs];
+    for (new_row, &old_row) in perm.iter().enumerate() {
+        let o = old_row as usize;
+        if o >= n_docs || inv_perm[o] != u64::MAX {
+            return Err(inval(format!("perm is not a bijection at new_row {new_row}")));
+        }
+        inv_perm[o] = new_row as u64;
+    }
+
+    // ---- 1. forward permute (offsets + payload, entry units per layout) ----
+    let t_fwd = Instant::now();
+    let old_offsets_mmap = leak_mmap(src.join("forward_offsets.bin"))?;
+    let old_offsets: &'static [usize] = bytemuck::cast_slice(old_offsets_mmap);
+    if old_offsets.len() != n_docs + 1 {
+        return Err(inval("forward_offsets cardinality != n_docs + 1".into()));
+    }
+    let mut new_offsets = Vec::with_capacity(n_docs + 1);
+    new_offsets.push(0usize);
+    for &old_row in perm.iter() {
+        let o = old_row as usize;
+        let len = old_offsets[o + 1] - old_offsets[o];
+        new_offsets.push(new_offsets.last().unwrap() + len);
+    }
+    if *new_offsets.last().unwrap() != old_offsets[n_docs] {
+        return Err(inval("permuted offsets do not preserve total length".into()));
+    }
+    write_pod_slice(&dst.join("forward_offsets.bin"), &new_offsets)?;
+
+    // Payload copy in new order. Entry width differs per layout; both payload
+    // kinds are POD byte runs, so one generic byte-level pass per file.
+    let permute_payload = |src_file: &str, dst_file: &str, entry_bytes: usize|
+        -> Result<u64, std::io::Error> {
+        let src_mmap = leak_mmap(src.join(src_file))?;
+        let mut out = std::io::BufWriter::with_capacity(
+            8 << 20, std::fs::File::create(dst.join(dst_file))?);
+        let mut moved: u64 = 0;
+        for &old_row in perm.iter() {
+            let o = old_row as usize;
+            let (s, e) = (old_offsets[o] * entry_bytes, old_offsets[o + 1] * entry_bytes);
+            std::io::Write::write_all(&mut out, &src_mmap[s..e])?;
+            moved += (e - s) as u64;
+        }
+        std::io::Write::flush(&mut out)?;
+        Ok(moved)
+    };
+    let payload_bytes = if is_dv {
+        permute_payload("forward_data.bin", "forward_data.bin", 8)?
+    } else {
+        permute_payload("forward_components.bin", "forward_components.bin", 2)?
+            + permute_payload("forward_values.bin", "forward_values.bin", 2)?
+    };
+    let forward_s = t_fwd.elapsed().as_secs_f64();
+
+    // ---- 2. posting lists: the E7 in-place pack rewrite, permutation-driven ----
+    let t_pl = Instant::now();
+    let mut pl = std::fs::read(src.join("posting_lists.bin"))?;
+    let mut cursor = 0usize;
+    let mut rewritten: u64 = 0;
+    for plm in &manifest.posting_lists {
+        let start = {
+            let align = std::mem::align_of::<u64>();
+            cursor + (align - (cursor % align)) % align
+        };
+        for w in 0..plm.packed_postings_words {
+            let p = start + w * 8;
+            let word = u64::from_ne_bytes(pl[p..p + 8].try_into().unwrap());
+            let elem_start = (word >> 16) as usize;
+            let len = (word & (u16::MAX as u64)) as usize;
+            let doc = old_offsets.partition_point(|&o| o <= elem_start) - 1;
+            if old_offsets[doc] != elem_start || old_offsets[doc + 1] - elem_start != len {
+                return Err(inval(format!(
+                    "pack word does not match a doc boundary (elem_start={elem_start} len={len})"
+                )));
+            }
+            let new_row = inv_perm[doc] as usize;
+            let ns = new_offsets[new_row];
+            let nlen = new_offsets[new_row + 1] - ns;
+            if nlen != len {
+                return Err(inval(format!("length drift for doc {doc}: {len} -> {nlen}")));
+            }
+            assert!(ns < (1u64 << 48) as usize, "offset exceeds 48-bit pack");
+            let new_word = ((ns as u64) << 16) | (nlen as u64);
+            pl[p..p + 8].copy_from_slice(&new_word.to_ne_bytes());
+            rewritten += 1;
+        }
+        cursor = start + plm.packed_postings_words * 8;
+        cursor = skip_pod::<usize>(cursor, plm.block_offsets_len);
+        cursor = skip_pod::<u64>(cursor, plm.ef_high_bits_n_words);
+        cursor = skip_pod::<i64>(cursor, plm.inv_block_inventory_len);
+        cursor = skip_pod::<u16>(cursor, plm.inv_subblock_inventory_len);
+        cursor = skip_pod::<usize>(cursor, plm.inv_overflow_positions_len);
+        cursor = skip_pod::<u64>(cursor, plm.ef_low_bits_n_words);
+        cursor = skip_pod::<u64>(cursor, plm.summaries_ids_n_words);
+        cursor += plm.values_len;
+        cursor = skip_pod::<f32>(cursor, plm.minimums_len);
+        cursor = skip_pod::<f32>(cursor, plm.quants_len);
+        if plm.has_component_ids {
+            cursor = skip_pod::<u16>(cursor, plm.component_ids_len);
+        }
+    }
+    if cursor > pl.len() || pl.len() - cursor >= 8 {
+        return Err(inval(format!(
+            "posting walk desync: cursor {cursor} vs file {} — layout drift?", pl.len())));
+    }
+    write_file(&dst.join("posting_lists.bin"), &pl)?;
+    let postings_s = t_pl.elapsed().as_secs_f64();
+
+    // ---- 3. doc mapping PERMUTED (rows are positional — doc 13 §2.1 trap) ----
+    let (map_strings, map_offsets) = (src.join("document_mapping_strings.bin"),
+                                      src.join("document_mapping_offsets.bin"));
+    let had_mapping = map_strings.exists() && map_offsets.exists();
+    if had_mapping {
+        let old_blob = std::fs::read(&map_strings)?;
+        let off_bytes = std::fs::read(&map_offsets)?;
+        let old_moff: &[usize] = bytemuck::cast_slice(&off_bytes);
+        if old_moff.len() != n_docs + 1 {
+            return Err(inval("doc-mapping offsets cardinality != n_docs + 1".into()));
+        }
+        let mut new_blob = Vec::with_capacity(old_blob.len());
+        let mut new_moff = Vec::with_capacity(n_docs + 1);
+        new_moff.push(0usize);
+        for &old_row in perm.iter() {
+            let o = old_row as usize;
+            new_blob.extend_from_slice(&old_blob[old_moff[o]..old_moff[o + 1]]);
+            new_moff.push(new_blob.len());
+        }
+        write_file(&dst.join("document_mapping_strings.bin"), &new_blob)?;
+        write_pod_slice(&dst.join("document_mapping_offsets.bin"), &new_moff)?;
+    }
+
+    // ---- 4. verbatim copies + manifest provenance ----
+    for f in ["config.json", "token_to_id_map.bin", "forward_encoder.bin"] {
+        if src.join(f).exists() {
+            std::fs::copy(src.join(f), dst.join(f))?;
+        }
+    }
+    manifest.forward_reordered = Some(order_name.to_string());
+    let manifest_json = serde_json::to_string_pretty(&manifest)
+        .map_err(|e| inval(e.to_string()))?;
+    write_file(&dst.join("manifest.json"), manifest_json.as_bytes())?;
+
+    // ---- 5. sample verify: moved records byte-exact against the source ----
+    let mut checked = 0usize;
+    if sample_check > 0 {
+        let entry_bytes: &[(&str, usize)] = if is_dv {
+            &[("forward_data.bin", 8)]
+        } else {
+            &[("forward_components.bin", 2), ("forward_values.bin", 2)]
+        };
+        let step = (n_docs / sample_check.max(1)).max(1);
+        for (fname, eb) in entry_bytes {
+            let old_m = leak_mmap(src.join(fname))?;
+            let new_m = leak_mmap(dst.join(fname))?;
+            for new_row in (0..n_docs).step_by(step) {
+                let o = perm[new_row] as usize;
+                let old = &old_m[old_offsets[o] * eb..old_offsets[o + 1] * eb];
+                let new = &new_m[new_offsets[new_row] * eb..new_offsets[new_row + 1] * eb];
+                if old != new {
+                    return Err(inval(format!(
+                        "verify FAIL: {fname} record mismatch at new_row {new_row}")));
+                }
+            }
+        }
+        checked = n_docs.div_ceil(step);
+    }
+
+    Ok(serde_json::json!({
+        "n_docs": n_docs,
+        "layout": if is_dv { "dotvbyte_fixedu8" } else { "f16" },
+        "order_name": order_name,
+        "forward_seconds": forward_s,
+        "postings_rewrite_seconds": postings_s,
+        "packs_rewritten": rewritten,
+        "forward_payload_bytes_moved": payload_bytes,
+        "doc_mapping_permuted": had_mapping,
+        "verify_docs_checked": checked,
+    }))
+}
