new file mode 100644
index 0000000..526b5cd
--- /dev/null
+++ b/src/mmap_index.rs
@@ -0,0 +1,592 @@
+//! C1a (2026-06-27) — Path-C mmap validation structures for the SEISMIC index.
+//!
+//! This module is the *integration* piece C0.5 deferred (07_G3_RAM_FIX_PLAN.md
+//! §4.2 → §4.3): "can the mmap file-cache swap be wired into `SeismicIndex`
+//! without breaking the search path?" C0 (page-fault axis) + C0.5 (compressed-
+//! decode axis) proved the *format* holds; C1a wires the *borrow* path over a
+//! real index and measures the floor.
+//!
+//! **Concrete, persona-typed (a validation spike, not a wired-in serve path).**
+//! The persona `SeismicIndex` (standard, dim<65K) is, per `pylib/mod.rs:1209` +
+//! `:27-28`:
+//!   `SeismicIndex<SparseDataset<ScalarSparseQuantizer<u16, f32, f16, DotProduct>>>`
+//! so component type `C = u16`, value type `V = f16`, encoder `E = ScalarSparse-
+//! Quantizer<u16, f32, f16, DotProduct>`, owned storage `ImmutableSparseStorage`.
+//! The structures below are written for THIS type. Every per-query arithmetic
+//! body is copied VERBATIM from the owned structs so the mmap path and the owned
+//! path are arithmetic twins — that is the parity argument (R3-v2 G1 / C0.5).
+//!
+//! The three fork pieces these depend on (07 §4.3):
+//!   * toolkit fork: `EliasFanoView<'a>` + `DArrayView<'a>` (borrow-backed, the
+//!     only structurally-hard piece — `EliasFano.high_bits: DArray` was pinned
+//!     to owned `BitVector` upstream).
+//!   * vectorium fork: `MmapSparseStorage<'a, E>` (borrow-backed forward index,
+//!     38% of the floor; `SparseStorage` trait already pluggable, only owned
+//!     impls shipped upstream).
+//!   * this module: `MmapQuantizedSummary`, `MmapPostingList`, `MmapInverted-
+//!     Index`, the flat-file `write_mmap_index` writer + `MmapSeismicIndex`
+//!     reader. The owned `InvertedIndexBase::search` path is UNTOUCHED.
+
+use itertools::Itertools;
+use num_traits::AsPrimitive;
+use toolkit::{
+    BitFieldSlice, BitSlice, DArrayView, EliasFanoView, InventoriesView,
+};
+use vectorium::datasets::sparse_dataset::SparseDatasetGeneric;
+use vectorium::{
+    ComponentType, Dataset, Distance, DotProduct, MmapSparseStorage, QueryEvaluator,
+    ScalarSparseQuantizer, SparseDataset, SparseVectorView, VectorEncoder,
+};
+use vectorium::dataset::ScoredRange;
+
+// `ScoredVectorDotProduct` is re-exported at the vectorium crate root (not in
+// the `dataset` submodule), so bring it in by alias.
+use vectorium::ScoredVectorDotProduct;
+
+use crate::index_traits::{ComponentFor, EncoderFor, SeismicSearchDataset};
+use crate::posting_list::{M8_BATCH_WIDTH, PackedPostingBlock, m8_batch_enabled};
+use crate::utils::KHeap;
+use crate::inverted_index::Knn;
+use crate::configurations::Configuration;
+
+use rustc_hash::FxHashSet;
+
+/// The persona encoder quantizer (concrete, see module docs).
+pub type IndexQuantizer = ScalarSparseQuantizer<u16, f32, half::f16, DotProduct>;
+/// The persona owned forward-index dataset (= `SparseDataset<IndexQuantizer>`).
+pub type OwnedForward = SparseDataset<IndexQuantizer>;
+/// The persona mmap-backed forward index (borrow-storage; `Dataset`+`SparseData`
+/// are generic over storage, so this satisfies the trait methods — but the
+/// `SeismicSearchDataset` *marker* is impl'd concretely below).
+pub type MmapForward<'a> = SparseDatasetGeneric<IndexQuantizer, MmapSparseStorage<'a, IndexQuantizer>>;
+
+// ===========================================================================
+// MmapQuantizedSummary — the 44% summaries slab, borrowed.
+// ===========================================================================
+
+/// Borrowed twin of [`QuantizedSummary`]`<u16>`. Every field is a borrow over an
+/// external mmap slab; the `distances()` body is copied verbatim from
+/// `QuantizedSummary::distances` (quantized_summary.rs:64-160) so the two are
+/// arithmetic twins (the C0.5 parity, lifted from a faithful-shape slab to the
+/// real per-posting-list summary struct).
+#[derive(Clone)]
+pub struct MmapQuantizedSummary<'a, C: ComponentType> {
+    n_summaries: usize,
+    dim: usize,
+    component_ids: Option<&'a [C]>,
+    offsets: EliasFanoView<'a>,
+    summaries_ids: BitFieldSlice<'a>,
+    values: &'a [u8],
+    minimums: &'a [f32],
+    quants: &'a [f32],
+}
+
+impl<'a, C: ComponentType> MmapQuantizedSummary<'a, C> {
+    /// Build from raw borrowed parts (the C1a reader casts an mmap region into
+    /// these via `bytemuck::cast_slice` + `EliasFanoView::from_raw_parts`).
+    #[must_use]
+    pub const fn from_raw_parts(
+        n_summaries: usize,
+        dim: usize,
+        component_ids: Option<&'a [C]>,
+        offsets: EliasFanoView<'a>,
+        summaries_ids: BitFieldSlice<'a>,
+        values: &'a [u8],
+        minimums: &'a [f32],
+        quants: &'a [f32],
+    ) -> Self {
+        Self { n_summaries, dim, component_ids, offsets, summaries_ids, values, minimums, quants }
+    }
+
+    /// C1a floor measurement: force page faults on every page of this summary's
+    /// mmap'd slab so the §6 RssFile measurement reflects actual index residency
+    /// (not a slab that was mapped but never read). A cheap sequential reducing
+    /// read over each borrowed slice. Called once per posting list at fault-in.
+    #[inline]
+    pub fn touch_slab(&self) -> u64 {
+        // Reduce each borrowed slice to a checksum-ish u64 so the reads aren't
+        // optimized away, but the work is dominated by touching the pages.
+        let mut acc: u64 = 0;
+        // values is the 44% elephant; summaries_ids + minimums + quants the rest.
+        for chunk in self.values.chunks(4096) {
+            acc = acc.wrapping_add(chunk[0] as u64);
+        }
+        // Touch summaries_ids backing words (BitFieldSlice via its bitvector).
+        for w in self.summaries_ids.bitvector().words().chunks(512) {
+            acc = acc.wrapping_add(w[0]);
+        }
+        for v in self.minimums.chunks(1024) {
+            acc = acc.wrapping_add(v[0].to_bits() as u64);
+        }
+        for v in self.quants.chunks(1024) {
+            acc = acc.wrapping_add(v[0].to_bits() as u64);
+        }
+        if let Some(cids) = self.component_ids {
+            for c in cids.chunks(2048) {
+                acc = acc.wrapping_add(c[0].as_() as u64);
+            }
+        }
+        // Touch the EliasFano high/low-backed words via the view's inventories.
+        // (EliasFanoView exposes select only; touch its underlying slices via
+        // the owned-free helpers below is not available, so a select-prefix scan
+        // suffices to fault in high_bits/low_bits.)
+        for i in 0..self.offsets.len().min(64) {
+            let _ = self.offsets.select(i);
+        }
+        acc
+    }
+
+    /// THE upstream hot loop. Body copied VERBATIM from
+    /// `QuantizedSummary::distances` (quantized_summary.rs:64-160). Only the
+    /// field accesses differ (borrowed vs owned); the arithmetic is identical
+    /// so mmap and owned paths produce bit-identical accumulators (parity).
+    pub fn distances<V>(&self, query: &SparseVectorView<'_, C, V>) -> Vec<f32>
+    where
+        V: vectorium::ValueType,
+    {
+        let query_components = query.components();
+        let query_values = query.values();
+
+        let mut accumulator = vec![0_f32; self.n_summaries];
+
+        if let Some(component_ids) = self.component_ids.as_ref() {
+            let mut i = 0; // index for component_ids
+            let mut j = 0; // index for query_components
+
+            while i < component_ids.len() && j < query_components.len() {
+                // TODO: dont do casting here once both are of type C::ComponentType
+                let comp_id = component_ids[i].as_();
+                let query_comp = query_components[j].as_();
+
+                if comp_id == query_comp {
+                    // Found matching component, process it
+                    let qv = query_values[j];
+                    let current_offset = self.offsets.select(i).unwrap();
+                    let next_offset = self.offsets.select(i + 1).unwrap();
+
+                    debug_assert!(current_offset <= next_offset);
+                    debug_assert!(next_offset <= self.values.len());
+                    // SAFETY: offsets are monotonic and within values bounds (validated via debug asserts).
+                    let current_values =
+                        unsafe { self.values.get_unchecked(current_offset..next_offset) };
+
+                    for (pos, &v) in (current_offset..next_offset).zip(current_values) {
+                        debug_assert!(pos < self.summaries_ids.len());
+                        // SAFETY: pos is within summaries_ids bounds (validated via debug assert).
+                        let s_id = unsafe { self.summaries_ids.get_unchecked(pos) } as usize;
+                        let dequantized_val = unsafe {
+                            // SAFETY: s_id comes from summaries_ids and must be < minimums/quants len.
+                            v as f32 * self.quants.get_unchecked(s_id)
+                                + self.minimums.get_unchecked(s_id)
+                        };
+                        debug_assert!(s_id < accumulator.len());
+                        // SAFETY: s_id is within accumulator bounds (validated via debug assert).
+                        *unsafe { accumulator.get_unchecked_mut(s_id) } +=
+                            dequantized_val * qv.to_f32().unwrap();
+                    }
+
+                    i += 1;
+                    j += 1;
+                } else if comp_id < query_comp {
+                    i += 1;
+                } else {
+                    j += 1;
+                }
+            }
+        } else {
+            // If there are no component_ids, we use the query_components directly
+            // This is the case when we have a dense offset vector
+
+            for (&qc, &qv) in query_components
+                .iter()
+                .zip(query_values)
+                .take_while(|(qc, _)| (qc.as_()) < self.dim)
+            {
+                let current_offset = self.offsets.select(qc.as_()).unwrap() - qc.as_();
+                let next_offset = self.offsets.select(qc.as_() + 1).unwrap() - (qc.as_() + 1);
+
+                debug_assert!(current_offset <= next_offset);
+                debug_assert!(next_offset <= self.values.len());
+                // SAFETY: offsets are monotonic and within values bounds (validated via debug asserts).
+                let current_values =
+                    unsafe { self.values.get_unchecked(current_offset..next_offset) };
+
+                for (pos, &v) in (current_offset..next_offset).zip(current_values) {
+                    debug_assert!(pos < self.summaries_ids.len());
+                    // SAFETY: pos is within summaries_ids bounds (validated via debug assert).
+                    let s_id = unsafe { self.summaries_ids.get_unchecked(pos) } as usize;
+                    let dequantized_val = unsafe {
+                        // SAFETY: s_id comes from summaries_ids and must be < minimums/quants len.
+                        v as f32 * self.quants.get_unchecked(s_id)
+                            + self.minimums.get_unchecked(s_id)
+                    };
+                    debug_assert!(s_id < accumulator.len());
+                    // SAFETY: s_id is within accumulator bounds (validated via debug assert).
+                    *unsafe { accumulator.get_unchecked_mut(s_id) } +=
+                        dequantized_val * qv.to_f32().unwrap();
+                }
+            }
+        }
+
+        accumulator
+    }
+}
+
+// ===========================================================================
+// MmapPostingList — packed_postings (17%) + block_offsets (1%) + summary.
+// ===========================================================================
+
+/// Borrowed twin of [`PostingList`]`<u16>`. `search`/`sort_and_search`/
+/// `evaluate_posting_block` bodies copied verbatim from `posting_list.rs`
+/// (115-215). The forward index is accessed only via `Dataset`/`SparseData`
+/// methods (`get_with_range`, `prefetch_with_range`, `id_from_range`,
+/// `range_from_id`), which are generic over storage — so an `MmapForward`
+/// forward index works without the `SeismicSearchDataset` marker here.
+#[derive(Clone)]
+pub struct MmapPostingList<'a> {
+    packed_postings: &'a [PackedPostingBlock],
+    block_offsets: &'a [usize],
+    summaries: MmapQuantizedSummary<'a, u16>,
+}
+
+impl<'a> MmapPostingList<'a> {
+    #[must_use]
+    pub const fn from_raw_parts(
+        packed_postings: &'a [PackedPostingBlock],
+        block_offsets: &'a [usize],
+        summaries: MmapQuantizedSummary<'a, u16>,
+    ) -> Self {
+        Self { packed_postings, block_offsets, summaries }
+    }
+
+    #[inline]
+    pub const fn packed_postings(&self) -> &[PackedPostingBlock] {
+        self.packed_postings
+    }
+    #[inline]
+    pub const fn block_offsets(&self) -> &[usize] {
+        self.block_offsets
+    }
+
+    /// C1a floor measurement: fault-in this list's packed_postings (17%) +
+    /// block_offsets (1%) slabs + delegate to the summary (44%). Cheap reducing
+    /// read; the work is the page faults, not the arithmetic.
+    #[inline]
+    pub fn touch_slab(&self) -> u64 {
+        let mut acc: u64 = 0;
+        for p in self.packed_postings.chunks(2048) {
+            acc = acc.wrapping_add(p[0].unpack().start as u64);
+        }
+        for o in self.block_offsets.chunks(1024) {
+            acc = acc.wrapping_add(o[0] as u64);
+        }
+        acc.wrapping_add(self.summaries.touch_slab())
+    }
+    /// Range of `packed_postings` for block `block_id` — verbatim from
+    /// `PostingList::search` (posting_list.rs:134-136).
+    #[inline]
+    fn block_slice(&self, block_id: usize) -> &[PackedPostingBlock] {
+        let bo = self.block_offsets;
+        &self.packed_postings[bo[block_id]..bo[block_id + 1]]
+    }
+
+    /// Verbatim from `PostingList::search` (posting_list.rs:115-146). Generic over
+    /// `S: SeismicSearchDataset` (exactly like the owned); the evaluator type is
+    /// derived from `S` via `EncoderFor<S>`. When `S = MmapForward<'a>`,
+    /// `EncoderFor<S> = IndexQuantizer`, so the evaluator is the persona's.
+    #[allow(clippy::too_many_arguments)]
+    pub fn search<'e, 'q, S>(
+        &self,
+        evaluator: &mut <EncoderFor<S> as VectorEncoder>::Evaluator<'e>,
+        query: &SparseVectorView<'q, u16, f32>,
+        k: usize,
+        heap_factor: f32,
+        heap: &mut KHeap<ScoredRange<DotProduct>>,
+        visited: &mut FxHashSet<usize>,
+        forward_index: &'e S,
+        mut block_stats: Option<&mut Vec<usize>>,
+    ) where
+        S: SeismicSearchDataset,
+    {
+        let dots = self.summaries.distances(query);
+
+        // M8: read the batch gate once per posting-list scan. This is the
+        // SERVED path's read point — `MmapSeismicIndex::search_raw_visited`
+        // (mmap_io.rs) inlines the index-level traversal and calls this method
+        // directly, so hoisting any higher would miss it.
+        let m8_batch = m8_batch_enabled();
+
+        for (block_id, dot) in dots.into_iter().enumerate() {
+            if heap.len() == k && dot < heap_factor * heap.peek().distance.distance() {
+                continue;
+            }
+            let scored = self.evaluate_posting_block(self.block_slice(block_id), evaluator, heap, visited, forward_index, m8_batch);
+            if let Some(acc) = block_stats.as_deref_mut() {
+                // Q3/M8 instrument (2026-07-10): per surviving posting block,
+                // record how many candidate packs it contributed. None ⇒ the
+                // served path (no overhead).
+                acc.push(scored);
+            }
+        }
+    }
+
+    /// Verbatim from `PostingList::evaluate_posting_block` (posting_list.rs:245-330),
+    /// including the M8 two-phase restructure and its `SFU_SEISMIC_M8_BATCH`
+    /// fallback. THIS is the loop the served `MmapSeismicIndex` /
+    /// `MmapSeismicIndexDotVByte` queries run.
+    #[allow(clippy::too_many_arguments)]
+    fn evaluate_posting_block<'e, S>(
+        &self,
+        packed_posting_block: &[PackedPostingBlock],
+        evaluator: &<EncoderFor<S> as VectorEncoder>::Evaluator<'e>,
+        heap: &mut KHeap<ScoredRange<DotProduct>>,
+        visited: &mut FxHashSet<usize>,
+        forward_index: &'e S,
+        m8_batch: bool,
+    ) -> usize
+    where
+        S: SeismicSearchDataset,
+    {
+        for pack in packed_posting_block.iter() {
+            let range = pack.unpack();
+            if visited.contains(&range.start) {
+                continue;
+            }
+            forward_index.prefetch_with_range(range);
+        }
+
+        // Q3/M8 instrument (2026-07-10): count the candidate packs this block
+        // scored (the survivors-per-block distribution M8 batches over). Both
+        // paths below return the same count (= candidates pushed to the heap).
+        if !m8_batch {
+            // ---- pre-M8 single-pass path (SFU_SEISMIC_M8_BATCH=0/false) ----
+            let mut scored_in_block = 0usize;
+            for pack in packed_posting_block.iter() {
+                let range = pack.unpack();
+
+                if visited.insert(range.start) {
+                    let vector = forward_index.get_with_range(range.clone());
+                    let distance = evaluator.compute_distance(vector);
+                    heap.push(ScoredRange { distance, range });
+                    scored_in_block += 1;
+                }
+            }
+            return scored_in_block;
+        }
+
+        // ---- M8 phase 1: survivor filter (same predicate + same order) ----
+        let mut survivors: Vec<std::ops::Range<usize>> =
+            Vec::with_capacity(packed_posting_block.len());
+        for pack in packed_posting_block.iter() {
+            let range = pack.unpack();
+            if visited.insert(range.start) {
+                survivors.push(range);
+            }
+        }
+
+        // ---- M8 phase 2: score survivors 6 at a time ----------------------
+        // Chunks in survivor order, lanes consumed 0..5 in order ⇒ heap pushes
+        // land in EXACTLY the single-pass candidate order. <6 tail = scalar.
+        let mut chunks = survivors.chunks_exact(M8_BATCH_WIDTH);
+        for chunk in chunks.by_ref() {
+            let vectors = [
+                forward_index.get_with_range(chunk[0].clone()),
+                forward_index.get_with_range(chunk[1].clone()),
+                forward_index.get_with_range(chunk[2].clone()),
+                forward_index.get_with_range(chunk[3].clone()),
+                forward_index.get_with_range(chunk[4].clone()),
+                forward_index.get_with_range(chunk[5].clone()),
+            ];
+            let distances = evaluator.compute_distances_batch6_exact(vectors);
+            for (distance, range) in distances.into_iter().zip(chunk.iter()) {
+                heap.push(ScoredRange {
+                    distance,
+                    range: range.clone(),
+                });
+            }
+        }
+        for range in chunks.remainder() {
+            let vector = forward_index.get_with_range(range.clone());
+            let distance = evaluator.compute_distance(vector);
+            heap.push(ScoredRange {
+                distance,
+                range: range.clone(),
+            });
+        }
+
+        survivors.len()
+    }
+}
+
+// ===========================================================================
+// MmapInvertedIndex — the four components, borrowed; search mirrors search_inner.
+// ===========================================================================
+
+/// The borrowed whole index. `forward` is the mmap-backed dataset; `posting_lists`
+/// owns the list array but each list's bytes are borrowed. Search body mirrors
+/// `InvertedIndexBase::search_inner` (inverted_index.rs:199-282) verbatim in its
+/// traversal; `first_sorted` sorts the first query term's dots by descending dot
+/// before scanning (matches `sort_and_search`). No G4 candidate-count return here
+/// (C1a is a parity+floor+latency spike, not a G4 re-measure).
+pub struct MmapInvertedIndex<'a> {
+    forward_index: &'a MmapForward<'a>,
+    posting_lists: &'a [MmapPostingList<'a>],
+    #[allow(dead_code)]
+    config: &'a Configuration,
+    knn: Option<&'a Knn>,
+}
+
+impl<'a> MmapInvertedIndex<'a> {
+    #[must_use]
+    pub const fn new(
+        forward_index: &'a MmapForward<'a>,
+        posting_lists: &'a [MmapPostingList<'a>],
+        config: &'a Configuration,
+        knn: Option<&'a Knn>,
+    ) -> Self {
+        Self { forward_index, posting_lists, config, knn }
+    }
+
+    /// C1a floor measurement: fault-in every page of the four mmap'd components
+    /// (forward index + all posting lists' packed_postings/block_offsets/summaries)
+    /// so the §6 RssFile measurement reflects actual slab residency, not a slab
+    /// that was mapped but never read. Cheap reducing scan; dominated by faults.
+    pub fn touch_slab(&self) -> u64 {
+        let mut acc: u64 = 0;
+        // Forward index: touch offsets (via SparseStorage) + components + values.
+        // `MmapForward = SparseDatasetGeneric<E, MmapSparseStorage<E>>`; access the
+        // storage's borrowed slices via the SparseStorage trait.
+        use vectorium::SparseStorage as _SparseStorage;
+        let st = self.forward_index.storage();
+        for o in st.offsets().as_ref().chunks(1024) {
+            acc = acc.wrapping_add(o[0] as u64);
+        }
+        let comps = st.components().as_ref();
+        for c in comps.chunks(4096) {
+            // ComponentType::as_ is inferrable when bound to a concrete usize.
+            let cv: usize = num_traits::AsPrimitive::as_(c[0]);
+            acc = acc.wrapping_add(cv as u64);
+        }
+        let vals = st.values().as_ref();
+        // values are f16 (2 bytes). Touch in 8KB strides.
+        let val_bytes = unsafe {
+            std::slice::from_raw_parts(vals.as_ptr() as *const u8, std::mem::size_of_val(vals))
+        };
+        for b in val_bytes.chunks(8192) {
+            acc = acc.wrapping_add(b[0] as u64);
+        }
+        // Posting lists: delegate to each list's touch_slab.
+        for pl in self.posting_lists.iter() {
+            acc = acc.wrapping_add(pl.touch_slab());
+        }
+        acc
+    }
+
+    /// Mirrors `InvertedIndexBase::search` (inverted_index.rs:153-174). The
+    /// forward index is `MmapForward<'a>`, whose encoder is `IndexQuantizer`, so
+    /// `EncoderFor<MmapForward<'a>>` = `IndexQuantizer` and the bounds below are
+    /// the persona's.
+    #[allow(clippy::too_many_arguments)]
+    pub fn search<'q>(
+        &'q self,
+        query: SparseVectorView<'q, u16, f32>,
+        k: usize,
+        query_cut: usize,
+        heap_factor: f32,
+        n_knn: usize,
+        first_sorted: bool,
+    ) -> Vec<ScoredVectorDotProduct>
+    where
+        MmapForward<'a>: SeismicSearchDataset,
+        EncoderFor<MmapForward<'a>>: VectorEncoder<Distance = DotProduct>,
+        <EncoderFor<MmapForward<'a>> as VectorEncoder>::QueryVector<'q>:
+            From<SparseVectorView<'q, u16, f32>>,
+    {
+        let query_components = query.components();
+        let query_values = query.values();
+
+        assert!(
+            query_components.is_sorted(),
+            "Query components must be sorted in ascending order."
+        );
+
+        let query_for_eval: <EncoderFor<MmapForward<'a>> as VectorEncoder>::QueryVector<'q> = query.into();
+        let mut evaluator = self.forward_index.encoder().query_evaluator(query_for_eval);
+
+        let mut heap = KHeap::new(k);
+        let mut visited = FxHashSet::with_capacity_and_hasher(
+            query_cut.min(query_components.len()) * 5000,
+            Default::default(),
+        );
+
+        let mut iter = query_components
+            .iter()
+            .zip(query_values)
+            .k_largest_by(query_cut, |a, b| a.1.total_cmp(b.1));
+        if first_sorted {
+            if let Some((&component_id, _value)) = iter.next() {
+                let component_idx: usize = component_id.as_();
+                self.posting_lists[component_idx].sort_and_search(
+                    &mut evaluator, &query, k, heap_factor, &mut heap, &mut visited,
+                    self.forward_index, None,
+                );
+            }
+        }
+        for (&component_id, _value) in iter {
+            let component_idx: usize = component_id.as_();
+            self.posting_lists[component_idx].search(
+                &mut evaluator, &query, k, heap_factor, &mut heap, &mut visited,
+                self.forward_index, None,
+            );
+        }
+        if n_knn > 0 && let Some(knn) = self.knn.as_ref() {
+            knn.refine(&mut evaluator, &mut heap, &mut visited, self.forward_index, n_knn);
+        }
+
+        heap.into_sorted_vec().into_iter()
+            .map(|scored| ScoredVectorDotProduct {
+                distance: scored.distance,
+                vector: self.forward_index.id_from_range(scored.range),
+            })
+            .collect()
+    }
+}
+
+// `sort_and_search` on MmapPostingList — copied verbatim from
+// `PostingList::sort_and_search` (posting_list.rs:148-185). Implemented as a
+// trait method on `MmapPostingList` (kept here for proximity).
+impl<'a> MmapPostingList<'a> {
+    #[allow(clippy::too_many_arguments)]
+    pub(crate) fn sort_and_search<'e, 'q, S>(
+        &self,
+        evaluator: &mut <EncoderFor<S> as VectorEncoder>::Evaluator<'e>,
+        query: &SparseVectorView<'q, u16, f32>,
+        k: usize,
+        heap_factor: f32,
+        heap: &mut KHeap<ScoredRange<DotProduct>>,
+        visited: &mut FxHashSet<usize>,
+        forward_index: &'e S,
+        mut block_stats: Option<&mut Vec<usize>>,
+    ) where
+        S: SeismicSearchDataset,
+    {
+        let dots = self.summaries.distances(query);
+        let dots: Vec<_> = dots.into_iter().enumerate()
+            .sorted_unstable_by(|&(_, a), &(_, b)| b.total_cmp(&a))
+            .collect();
+
+        // M8: read the batch gate once per posting-list scan (served path —
+        // `first_sorted` sends the top query term through here).
+        let m8_batch = m8_batch_enabled();
+
+        for (block_id, dot) in dots {
+            if heap.len() == k && dot < heap_factor * heap.peek().distance.distance() {
+                continue;
+            }
+            let scored = self.evaluate_posting_block(self.block_slice(block_id), evaluator, heap, visited, forward_index, m8_batch);
+            if let Some(acc) = block_stats.as_deref_mut() {
+                acc.push(scored);
+            }
+        }
+    }
+}
