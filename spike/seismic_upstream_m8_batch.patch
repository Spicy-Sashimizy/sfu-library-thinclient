+        assert!(crate::posting_list::m8_batch_enabled());
+        unsafe { std::env::remove_var("SFU_SEISMIC_M8_BATCH") };
+        assert!(crate::posting_list::m8_batch_enabled(), "unset must default to batch ON");
+
+        let _ = std::fs::remove_dir_all(&base);
+        eprintln!("m8_env_gate_is_live_and_covers_multi_term_queries OK: block_stats={stats:?}");
+    }
