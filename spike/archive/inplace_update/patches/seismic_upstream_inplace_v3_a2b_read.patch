+    /// Begin a query: snapshot E and, if enabled, register it in readers.bin
+    /// (FORMAT_V3.md revision 4: claim a slot, store E, SeqCst fence, re-read
+    /// the header, repeat until stable). The guard clears the slot on drop.
+    pub fn begin_query(&self) -> Result<(u64, ReaderGuard), String> {
+        if !self.reg_enabled.load(Ordering::Relaxed) {
+            let e = self.published_epoch().ok_or_else(|| "no valid header slot at query time".to_string())?;
+            return Ok((e, ReaderGuard { slot: None, gen: 0, pid: 0, last: std::cell::Cell::new(0) }));
+        }
+        let start = (self.pid as usize).wrapping_mul(2654435761) % READER_SLOTS;
+        let mut claimed = None;
+        for k in 0..READER_SLOTS {
+            let i = (start + k) % READER_SLOTS;
+            let slot = self.reader_slot(i);
+            if slot[0]
+                .compare_exchange(0, self.pid, Ordering::SeqCst, Ordering::SeqCst)
+                .is_ok()
+            {
+                claimed = Some(slot);
+                break;
+            }
+        }
+        let slot = claimed.ok_or_else(|| "reader table full".to_string())?;
+        let gen = slot[7].load(Ordering::SeqCst).wrapping_add(1);
+        slot[1].store(READER_IDLE, Ordering::SeqCst);
+        slot[4].store(self.pidns, Ordering::SeqCst);
+        slot[5].store(0, Ordering::SeqCst);
+        slot[6].store(self.boot, Ordering::SeqCst);
+        slot[7].store(gen, Ordering::SeqCst);
+        let t = monotonic_ns();
+        slot[2].store(t, Ordering::SeqCst);
+        slot[3].store(t, Ordering::SeqCst);
+        let guard = ReaderGuard { slot: Some(slot), gen, pid: self.pid, last: std::cell::Cell::new(t) };
+        let mut e = self.published_epoch().ok_or_else(|| "no valid header slot at query time".to_string())?;
+        loop {
+            slot[1].store(e, Ordering::SeqCst);
+            std::sync::atomic::fence(Ordering::SeqCst);
+            let e2 = self.published_epoch().ok_or_else(|| "no valid header slot at query time".to_string())?;
+            if e2 == e {
+                break;
+            }
+            e = e2;
         }
+        Ok((e, guard))
     }
 
