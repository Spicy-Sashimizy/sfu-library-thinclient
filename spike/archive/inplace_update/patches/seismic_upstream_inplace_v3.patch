+//! In-place format v3 (2026-09-29): encoder (dv-v2 -> v3, zero patches) and
+//! reader (`MmapSeismicIndexInplaceV3`). Byte-level spec:
+//! `spike/inplace_update/FORMAT_V3.md` in the main repo. The bit updater
+//! (slot writes, eviction, epoch publish) is NOT here.
+
+use std::collections::HashMap;
+use std::fs::File;
+use std::io::Write;
+use std::path::Path;
+use std::sync::atomic::{AtomicU64, AtomicU8, Ordering};
+
+use itertools::Itertools;
+use memmap2::Mmap;
+use num_traits::AsPrimitive;
+use rayon::prelude::*;
+use rustc_hash::FxHashSet;
+use vectorium::dataset::ScoredRange;
+use vectorium::vector_encoder::SparseDataEncoder as _;
+use vectorium::{
+    Dataset, Distance, DotVByteFixedU8Encoder, ScoredVectorDotProduct, SparseVectorView,
+    VectorEncoder,
+};
+
+use crate::inverted_index_wrapper::resolve_query_tokens;
+use crate::mmap_index::{v3_range, V3_START_MASK, V3_TAG_MASK};
+use crate::mmap_io::{MmapPackedForward, MmapSeismicIndexDotVByte};
+use crate::utils::KHeap;
+
+/// Header magic `b"SFUIPV3\0"` as a little-endian u64.
+pub const HEADER_MAGIC: u64 = u64::from_le_bytes(*b"SFUIPV3\0");
+/// Free-list magic `b"SFUFFL3\0"` as a little-endian u64.
+pub const FREE_MAGIC: u64 = u64::from_le_bytes(*b"SFUFFL3\0");
+/// Format version carried in the header and the manifest.
+pub const FORMAT_VERSION: u32 = 3;
+/// Header file size: two 4 KiB pages, one slot each.
+pub const HEADER_BYTES: usize = 8192;
+/// Page size separating the two header slots.
+pub const HEADER_PAGE: usize = 4096;
+/// Free-list size classes (inclusive word ranges).
+pub const FREE_CLASSES: [(u32, u32); 16] = [
+    (1, 8), (9, 12), (13, 16), (17, 20), (21, 24), (25, 28), (29, 32), (33, 40),
+    (41, 48), (49, 64), (65, 96), (97, 128), (129, 192), (193, 256), (257, 512),
+    (513, 65535),
+];
+/// Free-list file size with zero entries: 64 B header + 16 x 32 B class table.
+pub const FREE_EMPTY_BYTES: usize = 64 + 16 * 32;
+/// Posting-heap free-list magic `b"SFUPFL3\0"` (reserved for A2b).
+pub const PFREE_MAGIC: u64 = u64::from_le_bytes(*b"SFUPFL3\0");
+/// Posting-heap free-list size with zero entries (64 B header only).
+pub const PFREE_EMPTY_BYTES: usize = 64;
+/// Reader table (FORMAT_V3.md R3, reserved, DESIGN): slots x 64 B.
+pub const READER_SLOTS: usize = 256;
+/// Header record length inside each 4 KiB slot page.
+pub const HEADER_RECORD: usize = 128;
+
+/// Index files copied verbatim by the encoder.
+pub const COPIED_FILES: [&str; 8] = [
+    "config.json",
+    "forward_offsets.bin",
+    "forward_data.bin",
+    "forward_encoder.bin",
+    "posting_lists.bin",
+    "token_to_id_map.bin",
+    "document_mapping_strings.bin",
+    "document_mapping_offsets.bin",
+];
+
+/// FNV-1a 64 over a byte slice.
+pub fn fnv1a64(bytes: &[u8]) -> u64 {
+    let mut h: u64 = 0xcbf2_9ce4_8422_2325;
+    for &b in bytes {
+        h ^= b as u64;
+        h = h.wrapping_mul(0x0000_0100_0000_01b3);
+    }
+    h
+}
+
+fn inval(m: String) -> std::io::Error {
+    std::io::Error::new(std::io::ErrorKind::InvalidData, m)
+}
+
+fn leak_map(path: &Path) -> std::io::Result<&'static [u8]> {
+    let f = File::open(path)?;
+    let m = unsafe { Mmap::map(&f)? };
+    let leaked: &'static Mmap = Box::leak(Box::new(m));
+    Ok(unsafe { std::slice::from_raw_parts(leaked.as_ptr(), leaked.len()) })
+}
+
+fn align_up(cur: usize, a: usize) -> usize {
+    cur + (a - cur % a) % a
+}
+
+fn mget(v: &serde_json::Value, k: &str) -> std::io::Result<usize> {
+    v.get(k)
+        .and_then(|x| x.as_u64())
+        .map(|x| x as usize)
+        .ok_or_else(|| inval(format!("manifest field {k} missing or not an integer")))
+}
+
+/// Per-list location of the packed postings inside `posting_lists.bin`.
+#[derive(Debug, Clone)]
+struct ListLoc {
+    pp_byte: usize,
+    pp_words: usize,
+    bo_byte: usize,
+    bo_len: usize,
+    n_blocks: usize,
+    end_byte: usize,
+}
+
+/// Walk the manifest exactly like `read_posting_lists` (alignment per slice).
+fn list_locations(man: &serde_json::Value, file_len: usize) -> std::io::Result<Vec<ListLoc>> {
+    let lists = man
+        .get("posting_lists")
+        .and_then(|x| x.as_array())
+        .ok_or_else(|| inval("manifest has no posting_lists".into()))?;
+    let mut out = Vec::with_capacity(lists.len());
+    let mut cur = 0usize;
+    for p in lists {
+        let pp_words = mget(p, "packed_postings_words")?;
+        let pp_byte = align_up(cur, 8);
+        cur = pp_byte + 8 * pp_words;
+        let bo_len = mget(p, "block_offsets_len")?;
+        let bo_byte = align_up(cur, 8);
+        cur = bo_byte + 8 * bo_len;
+        cur = align_up(cur, 8) + 8 * mget(p, "ef_high_bits_n_words")?;
+        cur = align_up(cur, 8) + 8 * mget(p, "inv_block_inventory_len")?;
+        cur = align_up(cur, 2) + 2 * mget(p, "inv_subblock_inventory_len")?;
+        cur = align_up(cur, 8) + 8 * mget(p, "inv_overflow_positions_len")?;
+        cur = align_up(cur, 8) + 8 * mget(p, "ef_low_bits_n_words")?;
+        cur = align_up(cur, 8) + 8 * mget(p, "summaries_ids_n_words")?;
+        cur += mget(p, "values_len")?;
+        cur = align_up(cur, 4) + 4 * mget(p, "minimums_len")?;
+        cur = align_up(cur, 4) + 4 * mget(p, "quants_len")?;
+        if p.get("has_component_ids").and_then(|x| x.as_bool()).unwrap_or(false) {
+            cur = align_up(cur, 2) + 2 * mget(p, "component_ids_len")?;
+        }
+        out.push(ListLoc {
+            pp_byte, pp_words, bo_byte, bo_len, n_blocks: mget(p, "n_summaries")?, end_byte: cur,
+        });
+    }
+    if cur > file_len || file_len - cur >= 8 {
+        return Err(inval(format!("posting walk desync: cursor {cur} vs file {file_len}")));
+    }
+    Ok(out)
+}
+
+fn bits_needed(x: u64) -> u32 {
+    64 - x.leading_zeros()
+}
+
+fn header_record(slot: u32, epoch: u64, n_docs: u64, n_lists: u64, n_blocks: u64, man_fnv: u64) -> [u8; HEADER_RECORD] {
+    let mut r = [0u8; HEADER_RECORD];
+    r[0..8].copy_from_slice(&HEADER_MAGIC.to_le_bytes());
+    r[8..12].copy_from_slice(&FORMAT_VERSION.to_le_bytes());
+    r[12..16].copy_from_slice(&slot.to_le_bytes());
+    r[16..24].copy_from_slice(&epoch.to_le_bytes());
+    r[24..32].copy_from_slice(&n_docs.to_le_bytes());
+    r[32..40].copy_from_slice(&n_lists.to_le_bytes());
+    r[40..48].copy_from_slice(&n_blocks.to_le_bytes());
+    r[48..56].copy_from_slice(&man_fnv.to_le_bytes());
+    let ck = fnv1a64(&r[0..HEADER_RECORD - 8]);
+    r[HEADER_RECORD - 8..HEADER_RECORD].copy_from_slice(&ck.to_le_bytes());
+    r
+}
+
+fn write_all(path: &Path, bytes: &[u8]) -> std::io::Result<()> {
+    let mut f = File::create(path)?;
+    f.write_all(bytes)?;
+    f.sync_all()
+}
+
+/// Encoder: convert a dv-v2 shard dir (a local COPY) into a v3 dir with zero
+/// patches (FORMAT_V3.md §5). `dst` must not exist or be empty. Returns a
+/// JSON report incl. the measured spare-bit facts.
+pub fn convert_dv_v2_to_inplace_v3(src: &Path, dst: &Path) -> std::io::Result<serde_json::Value> {
+    convert_dv_v2_to_inplace_v3_with(src, dst, None)
+}
+
+/// As [`convert_dv_v2_to_inplace_v3`] with an explicit A2b posting-heap
+/// reserve in bytes (None = the size of `posting_lists.bin` rounded up to
+/// 4 KiB; the file is sparse, so the reserve allocates no blocks).
+pub fn convert_dv_v2_to_inplace_v3_with(
+    src: &Path,
+    dst: &Path,
+    heap_reserve: Option<u64>,
+) -> std::io::Result<serde_json::Value> {
+    use std::time::Instant;
+    let t0 = Instant::now();
+    let man_bytes = std::fs::read(src.join("manifest.json"))?;
+    let mut man: serde_json::Value =
+        serde_json::from_slice(&man_bytes).map_err(|e| inval(e.to_string()))?;
+    if man.get("forward_format").and_then(|x| x.as_str()) != Some("dotvbyte_fixedu8") {
+        return Err(inval("source is not a dotvbyte_fixedu8 dir".into()));
+    }
+    if mget(&man, "forward_format_version")? != 2 {
+        return Err(inval("source is not dv-v2 (forward_format_version != 2)".into()));
+    }
+    if man.get("has_knn").and_then(|x| x.as_bool()).unwrap_or(false) {
+        return Err(inval("knn-carrying source unsupported".into()));
+    }
+    if dst.exists() && std::fs::read_dir(dst)?.next().is_some() {
+        return Err(inval(format!("destination {dst:?} exists and is not empty")));
+    }
+    std::fs::create_dir_all(dst)?;
+
+    let t_copy = Instant::now();
+    let mut copied: Vec<(String, u64)> = Vec::new();
+    for f in COPIED_FILES {
+        let n = std::fs::copy(src.join(f), dst.join(f))?;
+        copied.push((f.to_string(), n));
+    }
+    let copy_s = t_copy.elapsed().as_secs_f64();
+
+    let n_docs = mget(&man, "n_docs")?;
+    let n_lists = mget(&man, "n_posting_lists")?;
+    let fdw = mget(&man, "forward_data_words")?;
+    let nnz = mget(&man, "forward_nnz")?;
+
+    let t_scan = Instant::now();
+    let pl: &'static [u8] = leak_map(&dst.join("posting_lists.bin"))?;
+    let locs = list_locations(&man, pl.len())?;
+    if locs.len() != n_lists {
+        return Err(inval("posting_lists length != n_posting_lists".into()));
+    }
+    let words_of = move |l: &ListLoc| -> &'static [u64] {
+        bytemuck::cast_slice(&pl[l.pp_byte..l.pp_byte + 8 * l.pp_words])
+    };
+    let mut max_start: u64 = 0;
+    let mut max_len: u64 = 0;
+    let mut max_end: u64 = 0;
+    let mut min_len: u64 = u64::MAX;
+    let mut high_nonzero: u64 = 0;
+    let mut n_words: u64 = 0;
+    let mut max_list_len: usize = 0;
+    let mut n_blocks_total: usize = 0;
+    let mut len_bits_hist = [0u64; 17];
+    for (t, l) in locs.iter().enumerate() {
+        let bo: &[u64] = bytemuck::cast_slice(&pl[l.bo_byte..l.bo_byte + 8 * l.bo_len]);
+        if l.pp_words == 0 {
+            if l.bo_len != 0 || l.n_blocks != 0 {
+                return Err(inval(format!("list {t}: empty postings but {} block offsets", l.bo_len)));
+            }
+        } else {
+            if l.bo_len != l.n_blocks + 1 || bo[0] != 0 || bo[l.bo_len - 1] as usize != l.pp_words
+                || !bo.windows(2).all(|w| w[0] <= w[1])
+            {
+                return Err(inval(format!("list {t}: block offsets inconsistent")));
+            }
+        }
+        n_blocks_total += l.n_blocks;
+        max_list_len = max_list_len.max(l.pp_words);
+        for &w in words_of(l) {
+            n_words += 1;
+            if (w >> 48) != 0 {
+                high_nonzero += 1;
+            }
+            let start = w >> 16;
+            let len = w & 0xFFFF;
+            max_start = max_start.max(start);
+            max_len = max_len.max(len);
+            min_len = min_len.min(len);
+            max_end = max_end.max(start + len);
+            len_bits_hist[bits_needed(len) as usize] += 1;
+        }
+    }
+    if high_nonzero != 0 {
+        return Err(inval(format!("{high_nonzero} posting words have bits 48..63 set (START >= 2^32)")));
+    }
+    if max_end as usize > fdw {
+        return Err(inval(format!("posting range end {max_end} beyond forward_data_words {fdw}")));
+    }
+    if max_list_len >= 65536 {
+        return Err(inval(format!("list of {max_list_len} slots does not fit list_min's 16-bit slot")));
+    }
+    let scan_s = t_scan.elapsed().as_secs_f64();
+
+    let t_min = Instant::now();
+    let offs: &'static [usize] = bytemuck::cast_slice(leak_map(&dst.join("forward_offsets.bin"))?);
+    let data: &'static [u64] = bytemuck::cast_slice(leak_map(&dst.join("forward_data.bin"))?);
+    if offs.len() != n_docs + 1 || data.len() != fdw {
+        return Err(inval("forward offsets/data length mismatch with manifest".into()));
+    }
+    let enc_bytes = std::fs::read(dst.join("forward_encoder.bin"))?;
+    let bin_cfg = bincode::config::standard().with_fixed_int_encoding().with_little_endian();
+    let (mut encoder, _): (DotVByteFixedU8Encoder, _) =
+        bincode::serde::decode_from_slice(&enc_bytes, bin_cfg).map_err(|e| inval(e.to_string()))?;
+    encoder.set_per_doc_scale(true);
+    let fwd: MmapPackedForward<'static> = MmapPackedForward::from_raw_parts(offs, data, encoder, nnz);
+    let mins: Vec<Result<u64, String>> = (0..n_lists)
+        .into_par_iter()
+        .map(|t| -> Result<u64, String> {
+            let words = words_of(&locs[t]);
+            if words.is_empty() {
+                return Ok(1u64 << 63);
+            }
+            let mut best_v = f32::INFINITY;
+            let mut best_i = 0usize;
+            for (i, &w) in words.iter().enumerate() {
+                let dec = fwd.encoder().decode_vector(fwd.get_with_range(v3_range(w)));
+                let comps = dec.components();
+                let pos = comps
+                    .binary_search(&(t as u16))
+                    .map_err(|_| format!("list {t} slot {i}: component absent from its record"))?;
+                let v = dec.values()[pos];
+                if v < best_v {
+                    best_v = v;
+                    best_i = i;
+                }
+            }
+            Ok((best_v.to_bits() as u64) | ((best_i as u64) << 32))
+        })
+        .collect();
+    let mut list_min: Vec<u64> = Vec::with_capacity(n_lists);
+    for m in mins {
+        list_min.push(m.map_err(inval)?);
+    }
+    let min_s = t_min.elapsed().as_secs_f64();
+
+    let t_ids = Instant::now();
+    let strings: &'static [u8] = leak_map(&dst.join("document_mapping_strings.bin"))?;
+    let soffs: &'static [usize] =
+        bytemuck::cast_slice(leak_map(&dst.join("document_mapping_offsets.bin"))?);
+    if soffs.len() != n_docs + 1 {
+        return Err(inval("document_mapping_offsets length != n_docs + 1".into()));
+    }
+    let mut max_id: u64 = 0;
+    let mut bad_ids: u64 = 0;
+    for r in 0..n_docs {
+        let s = &strings[soffs[r]..soffs[r + 1]];
+        let ok = s.len() >= 2 && s[0] == b'W' && s[1..].iter().all(|c| c.is_ascii_digit()) && s.len() <= 20;
+        if !ok {
+            bad_ids += 1;
+            continue;
+        }
+        let n: u64 = std::str::from_utf8(&s[1..]).unwrap().parse().unwrap_or(u64::MAX);
+        max_id = max_id.max(n);
+    }
+    if bad_ids != 0 || max_id >= (1u64 << 63) {
+        return Err(inval(format!("{bad_ids} doc ids not of the form W<digits> (max {max_id})")));
+    }
+    let ids_s = t_ids.elapsed().as_secs_f64();
+
+    let t_crc = Instant::now();
+    let list_crc: Vec<u64> = locs.par_iter().map(|l| fnv1a64(&pl[l.pp_byte..l.end_byte])).collect();
+    let native_off: Vec<u64> = locs.iter().map(|l| l.pp_byte as u64).collect();
+    let crc_s = t_crc.elapsed().as_secs_f64();
+
+    let t_side = Instant::now();
+    let heap_reserve = heap_reserve.unwrap_or(((pl.len() as u64) + 4095) / 4096 * 4096);
+    let mut dir_banks: Vec<u64> = Vec::with_capacity(2 * n_lists);
+    dir_banks.extend_from_slice(&native_off);
+    dir_banks.extend_from_slice(&native_off);
+    write_all(&dst.join("list_dir.bin"), bytemuck::cast_slice(&dir_banks))?;
+    write_all(&dst.join("list_crc.bin"), bytemuck::cast_slice(&list_crc))?;
+    {
+        let f = File::create(dst.join("posting_heap.bin"))?;
+        f.set_len(heap_reserve)?;
+        f.sync_all()?;
+    }
+    {
+        let mut buf = vec![0u8; PFREE_EMPTY_BYTES];
+        buf[0..8].copy_from_slice(&PFREE_MAGIC.to_le_bytes());
+        buf[8..12].copy_from_slice(&FORMAT_VERSION.to_le_bytes());
+        let ck = fnv1a64(&buf[0..56]);
+        buf[56..64].copy_from_slice(&ck.to_le_bytes());
+        write_all(&dst.join("posting_free.bin"), &buf)?;
+    }
+    write_all(&dst.join("block_inflation.bin"), &vec![0u8; 2 * n_blocks_total])?;
+    write_all(&dst.join("readers.bin"), &vec![0u8; 64 * READER_SLOTS])?;
+    write_all(&dst.join("list_min.bin"), bytemuck::cast_slice(&list_min))?;
+    {
+        let mut buf = vec![0u8; FREE_EMPTY_BYTES];
+        buf[0..8].copy_from_slice(&FREE_MAGIC.to_le_bytes());
+        buf[8..12].copy_from_slice(&FORMAT_VERSION.to_le_bytes());
+        buf[12..16].copy_from_slice(&(FREE_CLASSES.len() as u32).to_le_bytes());
+        let ck = fnv1a64(&buf[0..56]);
+        buf[56..64].copy_from_slice(&ck.to_le_bytes());
+        for (i, (lo, hi)) in FREE_CLASSES.iter().enumerate() {
+            let o = 64 + 32 * i;
+            buf[o..o + 4].copy_from_slice(&lo.to_le_bytes());
+            buf[o + 4..o + 8].copy_from_slice(&hi.to_le_bytes());
+            buf[o + 24..o + 32].copy_from_slice(&(FREE_EMPTY_BYTES as u64).to_le_bytes());
+        }
+        write_all(&dst.join("forward_free.bin"), &buf)?;
+    }
+    {
+        let f = File::create(dst.join("row_id_override.bin"))?;
+        f.set_len((8 * n_docs) as u64)?;
+        f.sync_all()?;
+    }
+
+    let src_fnv = fnv1a64(&man_bytes);
+    let obj = man.as_object_mut().ok_or_else(|| inval("manifest is not an object".into()))?;
+    obj.insert("forward_format_version".into(), serde_json::json!(3));
+    obj.insert(
+        "inplace_v3".into(),
+        serde_json::json!({
+            "format": "sfu_inplace_v3",
+            "version": FORMAT_VERSION,
+            "record_envelope_version": 2,
+            "posting_word": {"free_bit": 63, "tag_shift": 48, "tag_bits": 15,
+                             "start_shift": 16, "start_bits": 32, "len_bits": 16},
+            "n_blocks_total": n_blocks_total,
+            "inflation": {"file": "block_inflation.bin", "banks": 2,
+                          "code_saturated": 255, "multiplier": "1 + code/32"},
+            "side_files": ["inplace_header.bin", "block_inflation.bin", "list_min.bin",
+                           "forward_free.bin", "row_id_override.bin", "list_dir.bin",
+                           "list_crc.bin", "posting_heap.bin", "posting_free.bin"],
+            "a2b_reserved": {"list_dir": {"file": "list_dir.bin", "banks": 2,
+                                          "entry": "u64 byte offset of the list unit in the unified posting address space",
+                                          "native": "offset of the list's packed postings in posting_lists.bin"},
+                             "list_crc": {"file": "list_crc.bin", "hash": "fnv1a64 over [pp_start, list_end)"},
+                             "posting_heap": {"file": "posting_heap.bin", "reserve_bytes": heap_reserve,
+                                              "base": pl.len()},
+                             "posting_free": {"file": "posting_free.bin"},
+                             "status": "reserved for A2b, DESIGN"},
+            "reader_table": {"file": "readers.bin", "slots": READER_SLOTS, "slot_bytes": 64,
+                             "status": "reserved (FORMAT_V3.md R3), DESIGN; not read by this decoder"},
+            "source": {"dir": src.to_string_lossy(), "manifest_fnv64": format!("{src_fnv:016x}")},
+            "spec": "spike/inplace_update/FORMAT_V3.md",
+        }),
+    );
+    let new_man = serde_json::to_vec_pretty(&man).map_err(|e| inval(e.to_string()))?;
+    write_all(&dst.join("manifest.json"), &new_man)?;
+    for f in COPIED_FILES {
+        File::open(dst.join(f))?.sync_all()?;
+    }
+    File::open(dst)?.sync_all()?;
+    let side_s = t_side.elapsed().as_secs_f64();
+
+    let man_fnv = fnv1a64(&new_man);
+    let mut hdr = vec![0u8; HEADER_BYTES];
+    hdr[0..HEADER_RECORD].copy_from_slice(&header_record(
+        0, 0, n_docs as u64, n_lists as u64, n_blocks_total as u64, man_fnv,
+    ));
+    write_all(&dst.join("inplace_header.bin"), &hdr)?;
+    File::open(dst)?.sync_all()?;
+
+    let empty_lists = list_min.iter().filter(|&&m| m >> 63 == 1).count();
+    Ok(serde_json::json!({
+        "src": src.to_string_lossy(),
+        "dst": dst.to_string_lossy(),
+        "n_docs": n_docs,
+        "n_posting_lists": n_lists,
+        "n_postings": n_words,
+        "n_blocks_total": n_blocks_total,
+        "max_list_len": max_list_len,
+        "empty_lists": empty_lists,
+        "posting_words_high16_nonzero": high_nonzero,
+        "spare_bits": {
+            "forward_data_words": fdw,
+            "max_start_words": max_start,
+            "bits_max_start": bits_needed(max_start),
+            "max_len_words": max_len,
+            "min_len_words": min_len,
+            "bits_max_len": bits_needed(max_len),
+            "max_range_end_words": max_end,
+            "spare_in_offset_field_48": 48 - bits_needed(max_start),
+            "spare_in_len_field_16": 16 - bits_needed(max_len),
+            "spare_total_per_word": 64 - bits_needed(max_start) - bits_needed(max_len),
+            "used_by_v3": 16,
+            "start_headroom_bits_v3": 32 - bits_needed(max_start),
+            "len_bits_histogram": len_bits_hist.to_vec(),
+            "forward_offsets_max": offs[n_docs],
+            "bits_forward_offsets_max": bits_needed(offs[n_docs] as u64),
+            "spare_per_forward_offsets_entry": 64 - bits_needed(offs[n_docs] as u64),
+        },
+        "doc_ids": {"max_numeric_id": max_id, "bits": bits_needed(max_id)},
+        "copied_bytes": copied,
+        "side_file_bytes": {
+            "block_inflation.bin": 2 * n_blocks_total,
+            "list_min.bin": 8 * n_lists,
+            "forward_free.bin": FREE_EMPTY_BYTES,
+            "row_id_override.bin_apparent": 8 * n_docs,
+            "list_dir.bin": 16 * n_lists,
+            "list_crc.bin": 8 * n_lists,
+            "posting_heap.bin_apparent": heap_reserve,
+            "posting_free.bin": PFREE_EMPTY_BYTES,
+            "readers.bin": 64 * READER_SLOTS,
+            "inplace_header.bin": HEADER_BYTES,
+            "manifest.json": new_man.len(),
+        },
+        "manifest_fnv64": format!("{man_fnv:016x}"),
+        "source_manifest_fnv64": format!("{src_fnv:016x}"),
+        "seconds": {"copy": copy_s, "scan": scan_s, "list_min": min_s, "ids": ids_s,
+                     "list_crc": crc_s, "side_files_and_sync": side_s, "total": t0.elapsed().as_secs_f64()},
+    }))
+}
