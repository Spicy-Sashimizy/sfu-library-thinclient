 }
+
+/// mmap-first load path (P1 fork, "cheaper first probe" per FORK_BMP.md §cold).
+///
+/// Maps the whole `.bmp` read-only, then `bincode::deserialize_from` decodes the
+/// structs straight from the mapped `&[u8]`. This is the cheapest probe that:
+///   - proves the build + zero-functional-change read path (de-risks the G1
+///     correctness toolchain);
+///   - measures R2: bincode still heap-allocates owned `Vec`s for the deeply
+///     nested `BlockForwardIndex`, so G2 (RssAnon ~0) is *expected* to fail here
+///     — confirming the anonymous bytes come from deserialize, not `read()`.
+/// A true G2 cure (RssAnon ~0) needs lazy per-block decode over a flat layout,
+/// scoped as a follow-on; this probe isolates exactly where the anon bytes are.
+pub fn from_file_mmap<P: Into<PathBuf>>(
+    index_path: P,
+) -> Result<(inverted_index::Index, forward_index::BlockForwardIndex)> {
+    let file = File::open(index_path.into())?;
+    // SAFETY: the `.bmp` is an immutable build artifact; we only read from the
+    // mapping for the lifetime of the returned (owned) structs, and the file is
+    // not mutated concurrently.
+    let mmap = unsafe { memmap2::Mmap::map(&file)? };
+    Ok(bincode::deserialize_from(mmap.as_ref())?)
+}
