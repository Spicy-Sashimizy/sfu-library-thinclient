# Demo broker env — copy to demo.env on the NAS and `set -a; . ./demo.env; set +a`
# before launching uvicorn. NOTHING here is a secret in git (token is a file path).

# --- mode (KEEP dry-run until snapshot+volume exist; flip to 1 to spend) ---
DEMO_BROKER_LIVE=0

# --- cloud provider: do (default, DigitalOcean) | oci (Oracle Cloud) ---
# `oci` = ONE persistent pre-built instance, wake=START / sleep=SOFTSTOP, no
# create/destroy/re-seed (docs/infrastructure/OCI_DEMO_DEPLOYMENT.md §0/§4).
DEMO_CLOUD=do

# --- DigitalOcean (fill after Phase 1/2) ---
# DIGITALOCEAN_ACCESS_TOKEN comes from the repo .env already
DEMO_DO_REGION=tor1
DEMO_DO_SIZE=g-16vcpu-64gb
DEMO_DO_SNAPSHOT_ID=            # set after baking the image (Phase 2)
DEMO_DO_VOLUME_ID=             # set after creating+seeding the volume (Phase 1)
DEMO_DO_FIREWALL_ID=          # locks droplet :8080 to the NAS IP
DEMO_DROPLET_PORT=8080

# --- Oracle Cloud (only read when DEMO_CLOUD=oci; fill after OCI Phase 0-2) ---
# API-key signing (draft-cavage); the broker never reads ~/.oci/config implicitly.
OCI_TENANCY_OCID=
OCI_USER_OCID=
OCI_FINGERPRINT=                 # e.g. 2f:d2:...:1a  (from the API key upload)
OCI_KEY_FILE=                    # path to the PEM private key (mode 600, NOT in git)
OCI_KEY_PASSPHRASE=              # literal OR a path to a secret file; blank if unencrypted
OCI_REGION=ca-toronto-1
OCI_INSTANCE_OCID=               # the ONE persistent 150M instance (never created/destroyed)
OCI_INSTANCE_IP=                 # its stable PRIVATE ip — preferred proxy path (0 API calls)
OCI_COMPARTMENT_OCID=            # only needed for the VNIC-attachment ip fallback
OCI_STOP_ACTION=SOFTSTOP         # SOFTSTOP = ACPI shutdown then power off; STOP = hard (fallback)

# --- public + admin ---
DEMO_PUBLIC_BASE=https://demo.vancitylandscaper.com   # the Cloudflare hostname (Phase 3)
DEMO_ADMIN_TOKEN=change-me-long-random                 # gates /admin/report

# --- hot/cold schedule (9-5 weekdays hot, after-hours scale-to-zero) ---
DEMO_TZ=America/Vancouver
DEMO_BUSINESS_START_HOUR=9
DEMO_BUSINESS_END_HOUR=17
DEMO_BUSINESS_DAYS=0,1,2,3,4
DEMO_PREWARM_MINUTES=5
DEMO_IDLE_MINUTES=20
DEMO_MAX_RUNTIME_HOURS_PER_DAY=10

# --- notifications: reuse the existing NAS sfu-ntfy (verified 2026-06-19) ---
DEMO_NOTIFY_KIND=ntfy
DEMO_NOTIFY_WEBHOOK=https://<ntfy-host>/<ntfy-topic>
DEMO_NOTIFY_TOKEN=/mnt/MAIN/sfu-library-mcp/monitor/secrets/notify_token   # file path, not the literal
DEMO_NOTIFY_ON_QUERY=0

# --- per-person safety caps (protect the shared OpenAlex polite-pool) ---
DEMO_SESSION_RATE_MAX=30
DEMO_SESSION_RATE_WINDOW_S=60
DEMO_SESSION_DAILY_MAX=500
DEMO_BLOCKED_TOOLS=save_to_zotero,batch_save_to_zotero

# --- durable state/log (own dataset dir on the NAS) ---
DEMO_STATE_PATH=/mnt/MAIN/sfu-library-mcp/demo_broker/state.db
DEMO_LOG_PATH=/mnt/MAIN/sfu-library-mcp/demo_broker/broker.jsonl
DEMO_POLL_SECONDS=60
