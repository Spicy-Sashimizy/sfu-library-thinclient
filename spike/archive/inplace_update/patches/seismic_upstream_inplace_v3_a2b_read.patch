+/// Append one posting list's slices to `pl_buf` in the reader's layout and
+/// return its manifest entry. Extracted 2026-09-29 (in-place v3) from the
+/// `write_mmap_index` loop, byte-for-byte the same sequence; also used to
+/// serialise A2b unit bodies (alignment is relative to `pl_buf`'s start,
+/// which is 8-aligned in the file in both uses).
+pub(crate) fn extend_list_bytes(
+    pl_buf: &mut Vec<u8>,
+    pp: &[u64],
+    bo: &[usize],
+    summaries: &QuantizedSummary<u16>,
+) -> PostingListManifest {
+    let pp_words = pp.len();
+    extend_pod(pl_buf, pp);
+    let bo_len = bo.len();
+    extend_pod(pl_buf, bo);
+    let n_summaries = summaries.n_summaries();
+    let dim = summaries.dim();
+    let values: &[u8] = summaries.values();
+    let minimums: &[f32] = summaries.minimums();
+    let quants: &[f32] = summaries.quants();
+    let ef: &EliasFano = summaries.offsets();
+    let high: &DArray = ef.high_bits();
+    let high_bv = high.bv();
+    let high_words: &[u64] = high_bv.words();
+    let ef_high_bits_n_bits = high_bv.len();
+    let ef_high_bits_n_words = high_words.len();
+    extend_pod(pl_buf, high_words);
+    let inv: &Inventories<true> = high.ones_inventories();
+    let inv_n_sets = inv.n_sets();
+    let block_inv: &[i64] = inv.block_inventory();
+    let subblock_inv: &[u16] = inv.subblock_inventory();
+    let overflow: &[usize] = inv.overflow_positions();
+    extend_pod(pl_buf, block_inv);
+    extend_pod(pl_buf, subblock_inv);
+    extend_pod(pl_buf, overflow);
+    let low_bits = ef.low_bits();
+    let low_bv = low_bits.bitvector();
+    let low_words: &[u64] = low_bv.words();
+    let ef_low_bits_field_width = low_bits.field_width();
+    let ef_low_bits_n_bits = low_bv.len();
+    let ef_low_bits_n_words = low_words.len();
+    extend_pod(pl_buf, low_words);
+    let ef_low_len = ef.low_len();
+    let ef_universe = ef.universe();
+    let ef_num_vals = ef.num_vals();
+    let sids = summaries.summaries_ids();
+    let sids_bv = sids.bitvector();
+    let sids_words: &[u64] = sids_bv.words();
+    let summaries_ids_field_width = sids.field_width();
+    let summaries_ids_n_bits = sids_bv.len();
+    let summaries_ids_n_words = sids_words.len();
+    extend_pod(pl_buf, sids_words);
+    extend_pod(pl_buf, values);
+    extend_pod(pl_buf, minimums);
+    extend_pod(pl_buf, quants);
+    let has_component_ids = summaries.component_ids().is_some();
+    let component_ids_len = summaries.component_ids().map(|c| c.len()).unwrap_or(0);
+    if let Some(cids) = summaries.component_ids() {
+        extend_pod(pl_buf, cids);
+    }
+    PostingListManifest {
+        packed_postings_words: pp_words,
+        block_offsets_len: bo_len,
+        n_summaries,
+        dim,
+        has_component_ids,
+        component_ids_len,
+        values_len: values.len(),
+        minimums_len: minimums.len(),
+        quants_len: quants.len(),
+        summaries_ids_field_width,
+        summaries_ids_n_bits,
+        summaries_ids_n_words,
+        ef_high_bits_n_bits,
+        ef_high_bits_n_words,
+        ef_low_bits_field_width,
+        ef_low_bits_n_bits,
+        ef_low_bits_n_words,
+        ef_low_len,
+        ef_universe,
+        ef_num_vals,
+        inv_n_sets,
