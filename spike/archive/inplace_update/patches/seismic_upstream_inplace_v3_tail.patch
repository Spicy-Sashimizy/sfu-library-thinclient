+/// Test fixture (v3.1 forward tail, FORMAT_V3.md revision 6, 2026-09-30):
+/// on a zero-patch v3.1 work copy at epoch 0, append a copy of each named
+/// base doc's record to the forward tail (fresh id `W<max_base_id + 1 + j>`
+/// via `row_id_override.bin`), repoint EVERY posting word of that doc at
+/// the tail copy with TAG = 1, publish header slot 1 = epoch 1 with the
+/// tail counters, and write `oracle_dir`: a dv-v2 dir carrying the same
+/// content natively (tail records appended to the forward, N real offsets,
+/// slab extended, the same rewritten posting words with TAG cleared). The
+/// v3.1 decoder on the fixture (E = 1) and the v2 decoder on the oracle
+/// must return identical results. Offline fixture: pwrite before any
+/// reader maps the dir for queries.
+pub fn tail_fixture_append(
+    v3_dir: &Path,
+    doc_ids: &[String],
+    oracle_dir: &Path,
+) -> std::io::Result<serde_json::Value> {
+    use std::os::unix::fs::FileExt;
+    require_work_copy(v3_dir)?;
+    let oracle_canon = guard_output_dir(oracle_dir, Some(v3_dir))?;
+    if oracle_canon.exists() {
+        return Err(inval(format!("oracle dir {oracle_canon:?} exists")));
+    }
+    if doc_ids.is_empty() {
+        return Err(inval("no doc ids".into()));
+    }
+    let r = MmapSeismicIndexInplaceV3::from_mmap(v3_dir)?;
+    let st = r.published_state().ok_or_else(|| inval("no header".into()))?;
+    if st.epoch != 0 || st.tail_words != 0 || st.tail_rows != 0 || r.non_native_lists() != Some(0) {
+        return Err(inval("fixture needs a zero-patch v3.1 dir at epoch 0 with an empty tail".into()));
+    }
+    let n = r.n_docs;
+    let base = r.base_words;
+    if doc_ids.len() > r.tail_reserve_rows {
+        return Err(inval(format!("{} docs > reserve_rows {}", doc_ids.len(), r.tail_reserve_rows)));
+    }
+    let strings: &'static [u8] = leak_map(&v3_dir.join("document_mapping_strings.bin"))?;
+    let soffs: &'static [usize] = bytemuck::cast_slice(leak_map(&v3_dir.join("document_mapping_offsets.bin"))?);
+    if soffs.len() != n + 1 {
+        return Err(inval("document_mapping_offsets length != n_docs + 1".into()));
+    }
+    let want: HashMap<&str, usize> = doc_ids.iter().enumerate().map(|(i, s)| (s.as_str(), i)).collect();
+    if want.len() != doc_ids.len() {
+        return Err(inval("duplicate doc ids".into()));
+    }
+    let mut rows: Vec<Option<usize>> = vec![None; doc_ids.len()];
+    let mut max_id: u64 = 0;
+    for row in 0..n {
+        let s = &strings[soffs[row]..soffs[row + 1]];
+        let id: u64 = std::str::from_utf8(&s[1..]).ok().and_then(|x| x.parse().ok()).unwrap_or(0);
+        max_id = max_id.max(id);
+        if let Some(&i) = std::str::from_utf8(s).ok().and_then(|x| want.get(x)) {
+            rows[i] = Some(row);
+        }
+    }
+    let rows: Vec<usize> = rows
+        .into_iter()
+        .enumerate()
+        .map(|(i, r)| r.ok_or_else(|| inval(format!("doc id {} not in the slab", doc_ids[i]))))
+        .collect::<Result<_, _>>()?;
+
+    let offs = r.offsets_all;
+    let data: &[u64] = r.inner.forward().data();
+    let fd = std::fs::OpenOptions::new().write(true).open(v3_dir.join("forward_data.bin"))?;
+    let fo = std::fs::OpenOptions::new().write(true).open(v3_dir.join("forward_offsets.bin"))?;
+    let ro = std::fs::OpenOptions::new().write(true).open(v3_dir.join("row_id_override.bin"))?;
+    let mut used: usize = 0;
+    let mut start_map: HashMap<usize, usize> = HashMap::new();
+    let mut new_ids: Vec<String> = Vec::new();
+    let mut tail_offsets: Vec<u64> = Vec::new();
+    let mut tail_bytes: Vec<u8> = Vec::new();
+    let mut nnz_added: usize = 0;
+    let mut lens: Vec<usize> = Vec::new();
+    for (j, &row) in rows.iter().enumerate() {
+        let (s, e) = (offs[row], offs[row + 1]);
+        let len = e - s;
+        if len == 0 || len >= 65536 {
+            return Err(inval(format!("row {row}: record of {len} words does not fit LEN")));
+        }
+        if used + len > r.tail_reserve_words {
+            return Err(inval(format!("tail reserve of {} words exhausted at doc {j}", r.tail_reserve_words)));
+        }
+        let ts = base + used;
+        let rec: &[u8] = bytemuck::cast_slice(&data[s..e]);
+        fd.write_all_at(rec, (8 * ts) as u64)?;
+        fo.write_all_at(&((ts + len) as u64).to_le_bytes(), (8 * (n + j + 1)) as u64)?;
+        let nid = max_id + 1 + j as u64;
+        ro.write_all_at(&((1u64 << 63) | nid).to_le_bytes(), (8 * (n + j)) as u64)?;
+        if start_map.insert(s, ts).is_some() {
+            return Err(inval(format!("row {row} named twice")));
+        }
+        nnz_added += r.inner.forward().encoder().decode_vector(r.inner.forward().get_with_range(s..e)).components().len();
+        new_ids.push(format!("W{nid}"));
+        tail_offsets.push((ts + len) as u64);
+        tail_bytes.extend_from_slice(rec);
+        lens.push(len);
+        used += len;
+    }
+    fd.sync_all()?;
+    fo.sync_all()?;
+    ro.sync_all()?;
+
+    let man_s = std::fs::read_to_string(v3_dir.join("manifest.json"))?;
+    let man: serde_json::Value = serde_json::from_str(&man_s).map_err(|e| inval(e.to_string()))?;
+    let mut pl: Vec<u8> = std::fs::read(v3_dir.join("posting_lists.bin"))?;
+    let locs = list_locations(&man, pl.len())?;
+    let pw = std::fs::OpenOptions::new().write(true).open(v3_dir.join("posting_lists.bin"))?;
+    let mut repointed: Vec<usize> = vec![0; rows.len()];
+    let start_to_j: HashMap<usize, usize> = rows.iter().enumerate().map(|(j, &row)| (offs[row], j)).collect();
+    let mut n_repointed: usize = 0;
+    let mut lists_touched: usize = 0;
+    for l in &locs {
+        let mut touched = false;
+        for i in 0..l.pp_words {
+            let at = l.pp_byte + 8 * i;
+            let w = u64::from_le_bytes(pl[at..at + 8].try_into().unwrap());
