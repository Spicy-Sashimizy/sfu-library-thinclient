# Duck Library MCP Server — Production Image
# > **CLOSED SUPERSEDED 2026-10-11** — OpenSearch-era droplet+TrueNAS deploy tooling; current deployment is scripts/demo_broker/ (OCI demo) and scripts/serve_http.sh locally
# Lean image: Python 3.11
# No dev tools (no Node.js, Claude Code, ruff, mypy, pytest, etc.)

FROM python:3.11-slim-bookworm AS base

# System dependencies for health checks
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -r mcp && useradd -r -g mcp -m -s /bin/bash mcp

WORKDIR /app

# Install Python dependencies
COPY requirements.prod.txt .
RUN pip install --no-cache-dir -r requirements.prod.txt

# Copy application source
COPY src/ ./src/

# Create directories for volumes
RUN mkdir -p /app/logs /app/data \
    && chown -R mcp:mcp /app

# Switch to non-root user
USER mcp

# Environment defaults
ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    SFU_LOG_FILE=/app/logs/sfu-library-mcp.log \
    MCP_HTTP_HOST=0.0.0.0 \
    MCP_HTTP_PORT=8080

EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -sf http://localhost:8080/health || exit 1

# Default: HTTP transport for production
CMD ["python3", "src/sfu_library_mcp_http.py"]
