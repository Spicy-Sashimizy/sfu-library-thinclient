# WI-3 serve unit — docs/deprecated/oci_demo/OCI_FREE_TIER_RESIDENT_DEMO.md §3.1.
#
# serve_http.sh `exec`s the uvicorn process, so the serve inherits THIS unit's
# cgroup directly and one MemoryHigh= governs the process holding every mmap
# and its page cache (~93% of the working set is file-backed page cache).
#
# The dial: systemctl set-property --runtime sfu-serve.service \
#              MemoryHigh=12G MemoryMax=13610612736
# or through the broker: POST /admin/dial?gb=12  (scripts/demo_broker/dial.py).
#
# MemoryHigh (reclaim, never OOM) is the rung; MemoryMax is only a backstop
# ~1.5 GB above it. MemorySwapMax=0 is NOT optional: every R1/R2 ladder cell
# was measured swap-forbidden — a swap-enabled dial measures something else.
#
# Install (on the serve box):
#   sudo cp scripts/demo_broker/systemd/sfu-serve.service /etc/systemd/system/
#   edit WorkingDirectory/ExecStart paths below, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now sfu-serve

[Unit]
Description=SFU library thin-client MCP serve (dialable memory cgroup)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
# EDIT: repo checkout path on the serve box
WorkingDirectory=/opt/sfu-library-thinclient
ExecStart=/opt/sfu-library-thinclient/scripts/serve_http.sh
Restart=on-failure
RestartSec=5

# ---- the dial's home (WI-3) ----
# No MemoryHigh/MemoryMax at boot: the serve starts un-dialed and rungs are set
# live via `set-property --runtime` (they intentionally do not survive reboot).
MemorySwapMax=0

# hygiene
NoNewPrivileges=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
