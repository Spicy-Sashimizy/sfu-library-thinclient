+    /// The compressed forward dataset (read access; used by bins/gates).
+    pub fn forward(&self) -> &MmapPackedForward<'static> { &self.forward }
+
+    /// Dense fault-in of the whole footprint (mirror of the f16 twin, over the
+    /// dotvbyte slab set: forward offsets + data, postings, doc mapping).
+    pub fn touch_slab(&self) -> u64 {
+        let counter = AtomicUsize::new(0);
+        touch_bytes(self._fwd_offsets_mmap, &counter);
+        touch_bytes(self._fwd_data_mmap, &counter);
+        touch_bytes(self._postings_mmap, &counter);
+        if let Some(m) = self.doc_mapping {
+            touch_bytes(m.strings, &counter);
+            touch_bytes(cast_pod_bytes(m.offsets), &counter);
+        }
+        counter.load(Ordering::Relaxed) as u64
+    }
+
+    /// Mechanism (B) page release over the dotvbyte slab set (mirror of the
+    /// f16 twin; same `madvise(MADV_DONTNEED)` contract).
+    pub fn release_pages(&self) -> u64 {
+        let counter = AtomicUsize::new(0);
+        release_bytes(self._fwd_offsets_mmap, &counter);
+        release_bytes(self._fwd_data_mmap, &counter);
+        release_bytes(self._postings_mmap, &counter);
+        if let Some(s) = self._doc_strings_mmap {
+            release_bytes(s, &counter);
+        }
+        if let Some(o) = self._doc_offsets_mmap {
+            release_bytes(o, &counter);
+        }
+        counter.load(std::sync::atomic::Ordering::Relaxed) as u64
+    }
+
+    /// E7 Fix #4 (2026-07-03): prefault only the *floor* slabs — posting-list
+    /// index + doc-mapping strings/offsets — leaving the forward-codec files
+    /// (offsets + data) to be faulted by the actual search. Mirror of the f16
+    /// twin's `prefault_floor`. See that docstring for the gate-c calibration
+    /// rationale (strips the constant floor from both codecs' majflt_cold delta,
+    /// exposing the forward-codec delta the 0.55 bar models). Returns bytes touched.
+    /// E7 Fix #5B: see the f16 twin's docstring for the `include_forward_offsets`
+    /// rationale (the offsets slab is winner-id resolution, not the codec).
+    pub fn prefault_floor(&self, include_forward_offsets: bool) -> u64 {
+        let counter = AtomicUsize::new(0);
+        touch_bytes(self._postings_mmap, &counter);
+        if let Some(s) = self._doc_strings_mmap {
+            touch_bytes(s, &counter);
+        }
+        if let Some(o) = self._doc_offsets_mmap {
+            touch_bytes(cast_pod_bytes(o), &counter);
+        }
+        if include_forward_offsets {
+            touch_bytes(self._fwd_offsets_mmap, &counter);
+        }
+        counter.load(std::sync::atomic::Ordering::Relaxed) as u64
+    }
+
+    /// F4 (2026-07-14, disk-streaming Phase 2): lock the *floor* slabs into RAM
+    /// (the same set `prefault_floor` touches) via `mlock(2)` so kswapd can never
+    /// steal them on a capped host. Call AFTER `prefault_floor` so the pages are
+    /// faulted in (mlock on un-faulted pages faults them, but doing it post-touch
+    /// keeps the two concerns separate). `include_forward_offsets` mirrors the
+    /// prefault_floor flag (winner-id resolution slab, same size either codec).
+    /// Returns bytes locked (0 ⇒ permission denied — degrades to no-op, NOT a
+    /// crash; see `mlock_bytes`). T1-untouched (residency only).
+    pub fn mlock_floor(&self, include_forward_offsets: bool) -> u64 {
+        let counter = AtomicUsize::new(0);
+        mlock_bytes(self._postings_mmap, &counter);
+        if let Some(s) = self._doc_strings_mmap {
+            mlock_bytes(s, &counter);
+        }
+        if let Some(o) = self._doc_offsets_mmap {
+            mlock_bytes(cast_pod_bytes(o), &counter);
+        }
+        if include_forward_offsets {
+            mlock_bytes(self._fwd_offsets_mmap, &counter);
+        }
+        counter.load(std::sync::atomic::Ordering::Relaxed) as u64
+    }
+
+    /// F3 (2026-07-14, disk-streaming Phase 3): pin hot forward_data extents
+    /// into RAM. `extents` = sorted (page_start, page_len) page extents in
+    /// `forward_data.bin` coords (page = 4 KiB; the F2 sidecar's coordinate
+    /// system — `visited_start * 8 // 4096` from `search_visited`). Budget
+    /// capping is done in Python (the caller sorts extents by touch count desc
+    /// and takes the largest until `SFU_SEISMIC_PIN_BUDGET_GB` is reached);
+    /// this hook mlocks exactly the extents passed. Returns bytes locked.
+    /// T1-untouched (residency only). Degrades to no-op if mlock is denied.
+    pub fn mlock_ranges(&self, extents: &[(usize, usize)]) -> u64 {
+        let counter = AtomicUsize::new(0);
+        for &(page_start, page_len) in extents {
+            let off = page_start.saturating_mul(4096);
+            let len = page_len.saturating_mul(4096);
+            if off >= self._fwd_data_mmap.len() || len == 0 {
+                continue;
+            }
+            let end = (off + len).min(self._fwd_data_mmap.len());
+            let slice = &self._fwd_data_mmap[off..end];
+            mlock_bytes(slice, &counter);
+        }
+        counter.load(std::sync::atomic::Ordering::Relaxed) as u64
+    }
+
+    /// F5 (2026-07-14, disk-streaming Phase 4): `MADV_DONTNEED` the mapped slabs
+    /// EXCEPT the `pinned_extents` (the F3-pinned hot set, in `forward_data.bin`
+    /// page coords). Plain DONTNEED EINVALs on mlocked ranges (doc 02 §4) — the
+    /// forward slab is range-split around the pinned extents so they survive the
+    /// eviction. Sequential/cold arm only; the parallel path never calls
+    /// release_pages or this. T1-untouched (residency only).
+    ///
+    /// **SCOPE FIX 2026-08-31.** As built on 2026-07-14 this hook released ONLY
+    /// `_fwd_data_mmap`. The 2026-07-14 16 GB F5 cell was consequently a NULL
+    /// with the tell "post-release RssFile UNCHANGED (14.32 GB) despite
+    /// 'released 16.45 GB'" (`11_EXPERIMENT_BACKLOG.md`, R1 section): the load
+    /// residue that the parent claim
+    /// (`session_2026-07-14.../04_CONVERGENCE_ARTIFACT.md` §5.3, "the sorting can
+    /// be skipped entirely") wants evicted lives in the STRUCTURAL slabs —
+    /// posting lists, forward offsets, doc-mapping strings/offsets — which the
+    /// hook never touched, while the forward slab's pages were mostly
+    /// non-resident at that moment anyway. The hook now covers the same slab set
+    /// as `release_pages()`, minus the pinned extents.
+    ///
+    /// `keep_structural = true` restores a floor-preserving variant: the F4
+    /// `mlock_floor` / navigation-floor tier deliberately holds the structural
+    /// slabs resident, and releasing them would undo that pin. It is NOT the
+    /// 2026-07-14 behaviour restored (that also skipped `_fwd_offsets_mmap`);
+    /// it is the intentional "evict the forward residue, keep the floor" arm.
+    ///
+    /// Returns bytes actually released (see `release_bytes`: `madvise` failures
+    /// — e.g. EINVAL over mlocked ranges — now account 0, not the range length).
+    pub fn release_pages_except(&self, pinned_extents: &[(usize, usize)],
+                                keep_structural: bool) -> u64 {
+        self.release_pages_except_by_slab(pinned_extents, keep_structural)
+            .iter()
+            .map(|(_, n)| *n)
+            .sum()
+    }
+
+    /// F5 scope fix (2026-08-31): per-slab breakdown of `release_pages_except`.
+    /// Exists so a caller (and the eval harness) can SEE that every mapped slab
+    /// was covered — the 2026-07-14 null was only detectable by cross-checking
+    /// RssFile against a single aggregate number.
+    pub fn release_pages_except_by_slab(&self, pinned_extents: &[(usize, usize)],
+                                        keep_structural: bool)
+                                        -> Vec<(&'static str, u64)> {
+        let mut out: Vec<(&'static str, u64)> = Vec::with_capacity(5);
+        let counter = AtomicUsize::new(0);
+        // (A) the codec slab the hot-set sidecar addresses — range-split.
+        out.push(("forward_data",
+                  release_bytes_except(self._fwd_data_mmap, pinned_extents, &counter)));
+        if !keep_structural {
+            // (B) everything else the reader maps. No extent in the sidecar's
+            // coordinate system can name a page in these, so they are released
+            // whole — this is the residue the parent claim is about.
+            out.push(("forward_offsets", release_bytes(self._fwd_offsets_mmap, &counter)));
+            out.push(("postings", release_bytes(self._postings_mmap, &counter)));
+            if let Some(s) = self._doc_strings_mmap {
+                out.push(("doc_strings", release_bytes(s, &counter)));
+            }
+            if let Some(o) = self._doc_offsets_mmap {
+                out.push(("doc_offsets", release_bytes(o, &counter)));
+            }
+        }
+        out
+    }
+
+    /// F3/F5 helper (2026-07-14): the forward_data slab's byte length — so the
+    /// Python sidecar loader can clamp/sanity-check extents against the actual
+    /// slab before calling `mlock_ranges`. (The per-shard manifest already has
+    /// `forward_data_words` = bytes/8; this is the in-memory confirmation.)
+    pub fn forward_data_len(&self) -> usize {
+        self._fwd_data_mmap.len()
+    }
+
+    /// F6 (2026-07-14, disk-streaming Phase 6): PREFFAULT (not mlock) the hot
+    /// forward_data extents — Q9-style (`touch_bytes`: MADV_WILLNEED|SEQUENTIAL
+    /// + one page-stride read) over the F2 sidecar's hot extents. Faults the
+    /// pages into the kernel page cache so the first queries hit a pre-warmed
+    /// hot set WITHOUT the hard RAM commitment of mlock (the pages remain
+    /// kernel-reclaimable). The cold-p95 lever (doc 03 §3 "cold-start-sensitive"
+    /// row). `extents` = sorted (page_start, page_len) page extents in
+    /// `forward_data.bin` coords (page = 4 KiB). Returns bytes touched.
+    /// T1-untouched (residency only — a fault-in read of read-only data).
+    pub fn prefault_ranges(&self, extents: &[(usize, usize)]) -> u64 {
+        let counter = AtomicUsize::new(0);
+        for &(page_start, page_len) in extents {
+            let off = page_start.saturating_mul(4096);
+            let len = page_len.saturating_mul(4096);
+            if off >= self._fwd_data_mmap.len() || len == 0 {
+                continue;
+            }
+            let end = (off + len).min(self._fwd_data_mmap.len());
+            touch_bytes(&self._fwd_data_mmap[off..end], &counter);
+        }
+        counter.load(std::sync::atomic::Ordering::Relaxed) as u64
+    }
+
+    /// Number of documents in the optional doc-mapping slab.
+    pub fn n_doc_mapping(&self) -> usize {
+        self.doc_mapping.map(|m| m.len()).unwrap_or(0)
+    }
+
+    /// Return a doc ID as a zero-copy string slice, if a mapping exists.
+    pub fn doc_id(&self, doc_idx: usize) -> Option<&'static str> {
+        self.doc_mapping.as_ref().and_then(|m| m.get(doc_idx))
+    }
+}
