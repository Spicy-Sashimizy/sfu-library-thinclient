+fn boot_id_u64() -> u64 {
+    std::fs::read_to_string("/proc/sys/kernel/random/boot_id")
+        .ok()
+        .and_then(|s| {
+            let hex: String = s.chars().filter(|c| c.is_ascii_hexdigit()).take(16).collect();
+            u64::from_str_radix(&hex, 16).ok()
+        })
+        .unwrap_or(0)
+}
