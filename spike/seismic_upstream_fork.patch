+//! C1a (2026-06-27) — the flat-file writer + mmap reader for the SEISMIC index.
+//!
+//! This is the *integration* piece: `write_mmap_index` serializes a built
+//! in-RAM `SeismicIndex` to raw flat files (zero-decode `bytemuck::cast_slice`,
+//! NOT bincode — serde would re-materialize the anon floor the spike cures),
+//! and `MmapSeismicIndex` reads them back via a single `memmap2::Mmap` and
+//! reconstructs the borrowed-view structs from `mmap_index.rs`.
+//!
+//! The lifetime juggle uses a **spike-only leak**: the `Mmap` is `Box::leak`'d
+//! into a `&'static [u8]`, so the borrowed views can take `'static` lifetimes
+//! without self-referential `Arc<Mmap>` gymnastics. Acceptable for a validation
+//! spike (one index per process lifetime); a wired-in serve path (C2) uses
+//! `owning_ref`/`self_cell` instead — noted in 07 §4.3.
+//!
+//! See docs/seismic_150m_testbed/07_G3_RAM_FIX_PLAN.md §4.3 + the plan
+//! `.claude/plans/seismic-c1-mmap-spike.md`.
+
+use std::collections::HashMap;
+use std::fs::File;
+use std::io::Write;
+use std::path::Path;
+use std::sync::atomic::{AtomicU64, AtomicUsize, Ordering};
+
