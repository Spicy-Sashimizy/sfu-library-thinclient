+        let perm_path = base.join("perm.bin");
+        let _ = std::fs::remove_dir_all(&base);
+        std::fs::create_dir_all(&f16_dir).expect("create test dirs");
+
+        // Same synthetic geometry as the page-align test (600 docs, 2048 vocab).
+        let dim = 2048usize;
+        let mut token_to_id_map = HashMap::new();
+        for i in 0..dim {
+            token_to_id_map.insert(format!("t{}", i), i);
+        }
+        let encoder = ScalarSparseQuantizer::<u16, f32, f16, DotProduct>::new(dim, dim);
+        let mut ds = SparseDatasetGrowable::new(encoder);
+        let mut rng_state = 0xDEADBEEFCAFEF00Du64;
+        let mut next = move || {
+            rng_state ^= rng_state << 13;
+            rng_state ^= rng_state >> 7;
+            rng_state ^= rng_state << 17;
+            rng_state
+        };
+        let n_docs = 600usize;
+        for _ in 0..n_docs {
+            let nnz = 60 + (next() % 41) as usize;
+            let mut comps: Vec<u16> = (0..nnz)
+                .map(|_| (next() % dim as u64) as u16)
+                .collect();
+            comps.sort_unstable();
+            comps.dedup();
+            let vals: Vec<f32> = comps.iter().map(|_| 0.1 + (next() % 30) as f32 / 10.0).collect();
+            ds.push(SparseVectorView::new(&comps, &vals));
+        }
+        let frozen: OwnedForward = ds.into();
+        let doc_mapping: Vec<String> = (0..n_docs).map(|i| format!("doc{}", i)).collect();
+        let owned = SeismicIndex::new(
+            frozen,
+            Configuration::default(),
+            Some(doc_mapping),
+            None::<Vec<Option<String>>>,
+            token_to_id_map,
+        );
+        write_mmap_index(&owned, &f16_dir).expect("write_mmap_index");
+        convert_f16_dir_to_dotvbyte(&f16_dir, &dv_dir, n_docs, false, ValueScale::Fixed).expect("dv convert");
+
+        // Deterministic Fisher–Yates shuffle as perm[new_row] = old_row.
+        let mut perm: Vec<u64> = (0..n_docs as u64).collect();
+        for i in (1..n_docs).rev() {
+            let j = (next() % (i as u64 + 1)) as usize;
+            perm.swap(i, j);
+        }
+        let mut bytes = Vec::with_capacity(n_docs * 8);
+        for p in &perm {
+            bytes.extend_from_slice(&p.to_ne_bytes());
+        }
+        std::fs::write(&perm_path, &bytes).unwrap();
+
+        let rep_f16 = reorder_mmap_dir(&f16_dir, &f16_e5, &perm_path, "test_shuffle", n_docs)
+            .expect("reorder f16");
+        let rep_dv = reorder_mmap_dir(&dv_dir, &dv_e5, &perm_path, "test_shuffle", n_docs)
+            .expect("reorder dv");
+        assert_eq!(rep_f16["verify_docs_checked"], n_docs);
+        assert_eq!(rep_dv["doc_mapping_permuted"], true);
+
+        // Provenance landed; payload byte-counts conserved (pure permutation).
+        let man: MmapManifest = serde_json::from_str(
+            &std::fs::read_to_string(f16_e5.join("manifest.json")).unwrap()).unwrap();
+        assert_eq!(man.forward_reordered.as_deref(), Some("test_shuffle"));
+        for (a, b, f) in [(&f16_dir, &f16_e5, "forward_values.bin"),
+                          (&dv_dir, &dv_e5, "forward_data.bin")] {
+            assert_eq!(std::fs::metadata(a.join(f)).unwrap().len(),
+                       std::fs::metadata(b.join(f)).unwrap().len(), "{f} size drift");
+        }
+
+        // Search parity through the doc mapping. The E5 parity CONTRACT
+        // (doc 13 §2.3): score sequences bit-equal per rank; doc-id SETS equal
+        // within each score-tie group — `ScoredRange::cmp` tie-breaks on
+        // `range.start` (vectorium dataset.rs:52-58), which the permutation
+        // changes, so equal-score docs may legally reorder, and a tie group
+        // straddling the k-boundary may legally swap members (quality-neutral:
+        // identical scores either way). Only the boundary group's SIZE is
+        // checked; every interior group must match exactly as a set.
+        fn assert_tie_aware_parity(
+            tag: &str,
+            q: u64,
+            a: &[(String, f32)],
+            b: &[(String, f32)],
+        ) {
+            assert_eq!(a.len(), b.len(), "{tag} result count mismatch at q{q}");
+            for (i, (x, y)) in a.iter().zip(b.iter()).enumerate() {
+                assert_eq!(x.1.to_bits(), y.1.to_bits(),
+                    "{tag} score not bit-equal q{q} rank {i}");
+            }
+            let boundary_score = a.last().map(|x| x.1.to_bits());
+            let mut i = 0;
+            while i < a.len() {
+                let mut j = i + 1;
+                while j < a.len() && a[j].1.to_bits() == a[i].1.to_bits() {
+                    j += 1;
+                }
+                if Some(a[i].1.to_bits()) != boundary_score {
+                    let mut sa: Vec<&str> = a[i..j].iter().map(|x| x.0.as_str()).collect();
+                    let mut sb: Vec<&str> = b[i..j].iter().map(|x| x.0.as_str()).collect();
+                    sa.sort_unstable();
+                    sb.sort_unstable();
+                    assert_eq!(sa, sb, "{tag} tie-group doc-id set mismatch q{q} ranks {i}..{j}");
+                }
+                i = j;
+            }
+        }
+
+        let f16_a = MmapSeismicIndex::from_mmap(&f16_dir).expect("f16 from_mmap");
+        let f16_b = MmapSeismicIndex::from_mmap(&f16_e5).expect("f16_e5 from_mmap");
+        let dv_a = MmapSeismicIndexDotVByte::from_mmap(&dv_dir).expect("dv from_mmap");
+        let dv_b = MmapSeismicIndexDotVByte::from_mmap(&dv_e5).expect("dv_e5 from_mmap");
+        for q in 0..20u64 {
+            let toks: Vec<String> = (0..8)
+                .map(|j| format!("t{}", (q * 251 + j * 97) % dim as u64))
+                .collect();
+            let vals: Vec<f32> = (0..8).map(|j| 1.0 + j as f32 * 0.3).collect();
+
+            let named = |res: &[vectorium::dataset::ScoredItemGeneric<DotProduct, u64>],
+                         doc_id: &dyn Fn(usize) -> Option<&'static str>|
+                -> Vec<(String, f32)> {
+                res.iter()
+                    .map(|s| (doc_id(s.vector as usize).expect("doc id").to_string(),
+                              s.distance.distance()))
+                    .collect()
+            };
+            let ra = named(&f16_a.search_raw(&toks, &vals, 10, 8, 0.8, 0, true),
+                           &|i| f16_a.doc_id(i));
+            let rb = named(&f16_b.search_raw(&toks, &vals, 10, 8, 0.8, 0, true),
+                           &|i| f16_b.doc_id(i));
+            assert_tie_aware_parity("f16", q, &ra, &rb);
+
+            let da = named(&dv_a.search_raw(&toks, &vals, 10, 8, 0.8, true),
+                           &|i| dv_a.doc_id(i));
+            let db = named(&dv_b.search_raw(&toks, &vals, 10, 8, 0.8, true),
+                           &|i| dv_b.doc_id(i));
+            assert_tie_aware_parity("dv", q, &da, &db);
+        }
+        eprintln!("reorder_parity_both_layouts OK ({n_docs} docs, packs f16={} dv={})",
+            rep_f16["packs_rewritten"], rep_dv["packs_rewritten"]);
+    }
+
+    // =======================================================================
+    // M8 WP-B — register-blocked (batch-of-6) candidate scoring.
+    //
+    // `evaluate_posting_block` (posting_list.rs = in-RAM path, mmap_index.rs =
+    // SERVED path) now runs a survivor-filter phase followed by a scoring phase
+    // that feeds six candidates at a time to
+    // `QueryEvaluator::compute_distances_batch6`. `SFU_SEISMIC_M8_BATCH=0`
+    // restores the pre-M8 single-pass loop verbatim.
+    //
+    // The gate must be an EXACT A/B: same doc ids, same score bit patterns,
+    // same order. These tests build fixed-block-size synthetic indexes so the
+    // survivor width per block is known exactly (1, 2, 3, 6, 13, 18 — covering
+    // every remainder lane, the exact-one-batch case, and the >6 case around
+    // the measured median of 18), assert the widths really occurred via the
+    // Q3 block-stats instrument, then compare both paths.
+    //
+    // CONCURRENCY: these tests mutate a process-global env var. They serialize
+    // against each other through `M8_ENV_LOCK`, but `std::env::set_var` races
+    // with any *other* thread calling `std::env::var` — and every search in
+    // this binary now reads `SFU_SEISMIC_M8_BATCH`. Run the suite with
+    // `cargo test --no-default-features -- --test-threads=1`.
+    // =======================================================================
+
+    /// Serializes the env-mutating M8 tests against each other.
+    static M8_ENV_LOCK: std::sync::Mutex<()> = std::sync::Mutex::new(());
+
+    /// Set `SFU_SEISMIC_M8_BATCH` (or remove it when `None`), run `f`, restore.
+    ///
+    /// SAFETY: the M8 tests hold `M8_ENV_LOCK` across this call, so no other
+    /// M8 test mutates the environment concurrently; the suite is run with
+    /// `--test-threads=1` so no sibling test reads it concurrently either.
+    fn with_m8_env<R>(value: Option<&str>, f: impl FnOnce() -> R) -> R {
+        const KEY: &str = "SFU_SEISMIC_M8_BATCH";
+        let previous = std::env::var(KEY).ok();
+        unsafe {
+            match value {
+                Some(v) => std::env::set_var(KEY, v),
+                None => std::env::remove_var(KEY),
+            }
+        }
+        let out = f();
+        unsafe {
+            match previous {
+                Some(v) => std::env::set_var(KEY, v),
+                None => std::env::remove_var(KEY),
+            }
+        }
+        out
+    }
+
+    /// Build a synthetic index whose posting list for token `t0` splits into
+    /// fixed-size blocks of `block_size` docs.
+    ///
+    /// Every doc carries `t0`, so posting list 0 holds all `n_docs` docs. With
+    /// `BlockingStrategy::FixedSize` the boundaries are
+    /// `0, B, 2B, …, (n_docs/B − 1)·B, n_docs` (see
+    /// `PostingList::fixed_size_blocking`), so when `n_docs % B == 0` every
+    /// block is exactly `B` long, and otherwise the LAST block absorbs the
+    /// remainder (`B + n_docs % B`). A single-token query with `query_cut = 1`
+    /// scans only that list, and since each doc appears in it once, every block
+    /// contributes exactly its length as survivors to `evaluate_posting_block`.
+    ///
+    /// `t1` is carried by the even docs only (≈ half the corpus) so multi-term
+    /// queries can produce RAGGED survivor counts through the `visited` dedup.
+    fn build_fixed_block_index(block_size: usize, n_docs: usize) -> SeismicIndex<OwnedForward> {
+        let dim = 16usize;
+        let mut token_to_id_map = HashMap::new();
+        for i in 0..dim {
+            token_to_id_map.insert(format!("t{}", i), i);
+        }
+        let encoder = ScalarSparseQuantizer::<u16, f32, f16, DotProduct>::new(dim, dim);
+        let mut ds = SparseDatasetGrowable::new(encoder);
+        for i in 0..n_docs {
+            // t0 (shared, drives the posting list under test) + t1 on even docs
+            // + two spread tokens so the summaries are non-degenerate. Distinct
+            // t0 weights (step 0.01, distinctly representable in f16 near 1.0)
+            // keep the ranking total — no ties to make the comparison ambiguous.
+            let comps: Vec<u16> = {
+                let mut c = vec![0u16, 3 + (i % 4) as u16, 8 + (i % 5) as u16];
+                if i % 2 == 0 {
+                    c.push(1);
+                }
+                c.sort_unstable();
+                c.dedup();
+                c
+            };
+            let vals: Vec<f32> = comps
+                .iter()
+                .map(|&c| {
+                    if c == 0 {
+                        1.0 + i as f32 * 0.01
+                    } else {
+                        0.25 + (c as f32) * 0.05
+                    }
+                })
+                .collect();
+            ds.push(SparseVectorView::new(&comps, &vals));
+        }
+        let frozen: OwnedForward = ds.into();
+        let doc_mapping: Vec<String> = (0..n_docs).map(|i| format!("doc{}", i)).collect();
+        let config = Configuration::default()
+            .pruning_strategy(PruningStrategy::FixedSize { n_postings: n_docs })
+            .blocking_strategy(BlockingStrategy::FixedSize { block_size });
+        SeismicIndex::new(
+            frozen,
+            config,
+            Some(doc_mapping),
+            None::<Vec<Option<String>>>,
+            token_to_id_map,
+        )
+    }
+
+    /// (doc id, score bits) — the exact-equality projection the A/B compares.
+    fn m8_fingerprint(results: &[ScoredVectorDotProduct]) -> Vec<(u64, u32)> {
+        results
+            .iter()
+            .map(|s| (s.vector, s.distance.distance().to_bits()))
+            .collect()
+    }
+
+    /// Batch-of-6 scoring must be EXACTLY the pre-M8 single-pass path, on both
+    /// the in-RAM loop (`posting_list.rs`) and the served mmap loop
+    /// (`mmap_index.rs`), for every survivor width that exercises a different
+    /// lane of the chunked loop.
+    #[test]
+    fn m8_batch_matches_scalar_exactly() {
+        let _guard = M8_ENV_LOCK.lock().unwrap_or_else(|e| e.into_inner());
+
+        // (block_size, n_blocks): 1/2/3 = pure-remainder blocks, 6 = exactly one
+        // full batch and no remainder, 13 = two batches + 1 remainder, 18 = three
+        // full batches (the measured median survivors-per-block).
+        let cases: [(usize, usize); 6] = [(1, 8), (2, 6), (3, 5), (6, 4), (13, 3), (18, 3)];
+
+        let base = std::path::PathBuf::from(format!("/tmp/seismic_m8_test_{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&base);
+
+        for (block_size, n_blocks) in cases {
+            let n_docs = block_size * n_blocks;
+            let owned = build_fixed_block_index(block_size, n_docs);
+            let dir = base.join(format!("b{block_size}"));
+            std::fs::create_dir_all(&dir).expect("create test dir");
+            write_mmap_index(&owned, &dir).expect("write_mmap_index");
+            let mmap_idx = MmapSeismicIndex::from_mmap(&dir).expect("from_mmap");
+
+            let toks: Vec<String> = vec!["t0".to_string()];
+            let vals: Vec<f32> = vec![1.0];
+            let k = n_docs; // keep every candidate so the whole list is compared
+            let query_cut = 1; // scan ONLY posting list 0
+            let heap_factor = 0.0; // dots are ≥ 0 ⇒ no block is ever pruned
+
+            // `first_sorted = true` routes the term through `sort_and_search`,
+            // `false` through `search` — both entry points funnel into
+            // `evaluate_posting_block` and both must be covered.
+            for first_sorted in [true, false] {
+                // The block-stats instrument proves this case really produced
+                // the survivor width it claims to test — and, asserted under
+                // BOTH gate settings, that the `scored_in_block` counter
+                // semantics are unchanged by the restructure (Q3 depends on it).
+                for gate in [Some("1"), None] {
+                    let stats = with_m8_env(gate, || {
+                        mmap_idx
+                            .search_raw_block_stats(
+                                &toks, &vals, k, query_cut, heap_factor, 0, first_sorted,
+                            )
+                            .2
+                    });
+                    assert_eq!(
+                        stats,
+                        vec![block_size; n_blocks],
+                        "block_size={block_size} first_sorted={first_sorted} gate={gate:?}: \
+                         survivors-per-block should be {n_blocks} blocks of {block_size}"
+                    );
+                }
+
+                let owned_batch = with_m8_env(Some("1"), || {
+                    m8_fingerprint(&owned.search_raw(
+                        &toks, &vals, k, query_cut, heap_factor, 0, first_sorted,
+                    ))
+                });
+                let owned_scalar = with_m8_env(Some("0"), || {
+                    m8_fingerprint(&owned.search_raw(
+                        &toks, &vals, k, query_cut, heap_factor, 0, first_sorted,
+                    ))
+                });
+                assert_eq!(
+                    owned_batch.len(),
+                    n_docs,
+                    "block_size={block_size}: expected all {n_docs} docs scored"
+                );
+                assert_eq!(
+                    owned_batch, owned_scalar,
+                    "IN-RAM path diverged (block_size={block_size}, first_sorted={first_sorted})"
+                );
+
+                let mmap_batch = with_m8_env(Some("1"), || {
+                    m8_fingerprint(&mmap_idx.search_raw(
+                        &toks, &vals, k, query_cut, heap_factor, 0, first_sorted,
+                    ))
+                });
+                let mmap_scalar = with_m8_env(Some("0"), || {
+                    m8_fingerprint(&mmap_idx.search_raw(
+                        &toks, &vals, k, query_cut, heap_factor, 0, first_sorted,
+                    ))
+                });
+                assert_eq!(
+                    mmap_batch, mmap_scalar,
+                    "SERVED mmap path diverged (block_size={block_size}, first_sorted={first_sorted})"
+                );
+                // Cross-check: the two loops are arithmetic twins, so the mmap
+                // path must also equal the in-RAM path bit-for-bit.
+                assert_eq!(
+                    mmap_batch, owned_batch,
+                    "mmap/in-RAM twin broke (block_size={block_size}, first_sorted={first_sorted})"
+                );
+            }
+            eprintln!(
+                "m8_batch_matches_scalar_exactly OK: block_size={block_size} \
+                 ({n_blocks} blocks, {n_docs} docs)"
+            );
+        }
+        let _ = std::fs::remove_dir_all(&base);
+    }
+
+    /// The gate must be re-readable BETWEEN QUERIES inside one process (the
+    /// latency A/B toggles it live) — i.e. nothing may cache it in a
+    /// `OnceLock`/`lazy_static`. Also pins the accepted spellings: "1" / "true"
+    /// / "TRUE" / "True" = batch ON; unset / anything else = single-pass (the gate-c REVERT default, 2026-08-10).
+    #[test]
+    fn m8_env_gate_is_live_and_covers_multi_term_queries() {
+        let _guard = M8_ENV_LOCK.lock().unwrap_or_else(|e| e.into_inner());
+
+        let base =
+            std::path::PathBuf::from(format!("/tmp/seismic_m8_live_{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&base);
+        std::fs::create_dir_all(&base).expect("create test dir");
+
+        // block_size 18 over 59 docs ⇒ t0's blocks are 18/18/23 (the tail block
+        // absorbs the remainder), and t1 (even docs, 30 of them) forms its own
+        // 30-doc block that is scanned FIRST (highest query weight ⇒
+        // `first_sorted` sends it through `sort_and_search`). The `visited`
+        // dedup then leaves t0's blocks RAGGED — the case where phase 1 and
+        // phase 2 could most easily desynchronize.
+        let owned = build_fixed_block_index(18, 59);
+        write_mmap_index(&owned, &base).expect("write_mmap_index");
+        let mmap_idx = MmapSeismicIndex::from_mmap(&base).expect("from_mmap");
+
+        let toks: Vec<String> = vec!["t0".to_string(), "t1".to_string(), "t9".to_string()];
+        let vals: Vec<f32> = vec![1.0, 2.0, 0.5];
+        // heap_factor 0.0 ⇒ dots are ≥ 0 ⇒ no block is pruned, so the block
+        // geometry asserted below is deterministic.
+        let run = |idx: &MmapSeismicIndex| {
+            m8_fingerprint(&idx.search_raw(&toks, &vals, 20, 4, 0.0, 0, true))
+        };
+        let run_owned = || {
+            m8_fingerprint(&owned.search_raw(&toks, &vals, 20, 4, 0.0, 0, true))
+        };
+
+        // Ragged widths really happen here, and the instrument counter reports
+        // them identically under both gate settings.
+        let stats =
+            with_m8_env(Some("1"), || mmap_idx.search_raw_block_stats(&toks, &vals, 20, 4, 0.0, 0, true).2);
+        let stats_scalar = with_m8_env(Some("0"), || {
+            mmap_idx.search_raw_block_stats(&toks, &vals, 20, 4, 0.0, 0, true).2
+        });
+        assert_eq!(stats, stats_scalar, "scored_in_block counter diverged across the gate");
+        assert!(!stats.is_empty(), "no blocks survived — test geometry is wrong");
+        assert!(
+            stats.iter().any(|&s| s != stats[0]),
+            "expected ragged survivor counts from the multi-term dedup, got {stats:?}"
+        );
+        assert!(
+            stats.iter().any(|&s| s > 6) && stats.iter().any(|&s| s % 6 != 0),
+            "ragged case should cover both a full-batch and a remainder tail, got {stats:?}"
+        );
+
+        // Alternate the gate inside one process; every ON reading must equal
+        // every OFF reading. If the gate were cached, the later toggles would
+        // silently keep the first value — which this still catches only via a
+        // divergence, so we ALSO assert the readings are all identical to the
+        // very first, i.e. the toggle never corrupts results either way.
+        let mut readings = Vec::new();
+        for value in [None, Some("0"), None, Some("false"), Some("1"), Some("FALSE"),
+                      Some("true"), Some("False"), None] {
+            readings.push(with_m8_env(value, || (run(&mmap_idx), run_owned())));
+        }
+        let first = readings[0].clone();
+        assert!(!first.0.is_empty(), "search returned nothing — test geometry is wrong");
+        for (i, r) in readings.iter().enumerate() {
+            assert_eq!(*r, first, "reading {i} diverged under gate toggling");
+        }
+
+        // Direct proof the gate is not cached: the helper reads the env each
+        // call, so flipping it must flip the reported value within one process.
+        unsafe { std::env::set_var("SFU_SEISMIC_M8_BATCH", "0") };
+        assert!(!crate::posting_list::m8_batch_enabled());
+        unsafe { std::env::set_var("SFU_SEISMIC_M8_BATCH", "1") };
+        assert!(crate::posting_list::m8_batch_enabled());
+        unsafe { std::env::remove_var("SFU_SEISMIC_M8_BATCH") };
+        assert!(!crate::posting_list::m8_batch_enabled(), "unset must default to single-pass (gate c REVERT 2026-08-10)");
+
+        let _ = std::fs::remove_dir_all(&base);
+        eprintln!("m8_env_gate_is_live_and_covers_multi_term_queries OK: block_stats={stats:?}");
+    }
+}
diff --git a/src/posting_list.rs b/src/posting_list.rs
index 42040f6..4826455 100644
--- a/src/posting_list.rs
+++ b/src/posting_list.rs
@@ -28,11 +28,25 @@ use vectorium::{
 /// forward index. The values of each doc are packed into a single u64 in `packed_postings`.
 /// We use 48 bits for the offset and 16 bits for the length. This choice limits the size of the dataset to be 1<<48.
 /// We use the forward index to convert the offsets of the top-k back to the id of the corresponding documents.
+/// C1a (2026-06-27): `#[repr(transparent)]` added so the mmap reader can cast
+/// `&[u64]` (the on-disk word layout) into `&[PackedPostingBlock]` soundly via
+/// `bytemuck`/raw pointer cast — the struct is a single `u64`, so the layout is
+/// identical. Additive; the field stays private with accessors.
+#[repr(transparent)]
 #[derive(Copy, Clone, Debug, Eq, PartialEq, Serialize, Deserialize, Hash, Ord, PartialOrd)]
 pub(crate) struct PackedPostingBlock {
     n: u64,
 }
 
+// C1a (2026-06-27): sound because PackedPostingBlock is #[repr(transparent)]
+// over a single u64 (which is Pod + Zeroable); the struct is plain old data
+// with no padding. Enables `bytemuck::cast_slice` for zero-decode mmap IO.
