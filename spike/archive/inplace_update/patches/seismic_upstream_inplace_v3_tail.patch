+                n_repointed += 1;
+                touched = true;
+            }
+        }
+        lists_touched += touched as usize;
+    }
+    pw.sync_all()?;
+    if let Some(j) = repointed.iter().position(|&c| c == 0) {
+        return Err(inval(format!("doc {} (row {}) has no posting; fixture would be vacuous", doc_ids[j], rows[j])));
+    }
+
+    let hdr = header_record(
+        1, 1, n as u64, r.n_lists as u64, r.n_blocks_total as u64, r.manifest_fnv, used as u64, rows.len() as u64,
+    );
+    let hf = std::fs::OpenOptions::new().write(true).open(v3_dir.join("inplace_header.bin"))?;
+    hf.write_all_at(&hdr, HEADER_PAGE as u64)?;
+    hf.sync_all()?;
+    File::open(v3_dir)?.sync_all()?;
+
+    std::fs::create_dir(&oracle_canon)?;
+    let oracle_dir: &Path = &oracle_canon;
+    for f in ["config.json", "forward_encoder.bin", "token_to_id_map.bin"] {
+        copy_bytes(&v3_dir.join(f), &oracle_dir.join(f))?;
+    }
+    {
+        let mut w = File::create(oracle_dir.join("forward_data.bin"))?;
+        w.write_all(bytemuck::cast_slice(&data[..base]))?;
+        w.write_all(&tail_bytes)?;
+        w.sync_all()?;
+    }
+    {
+        let mut w = File::create(oracle_dir.join("forward_offsets.bin"))?;
+        w.write_all(bytemuck::cast_slice(&offs[..n + 1]))?;
+        w.write_all(bytemuck::cast_slice(&tail_offsets))?;
+        w.sync_all()?;
+    }
+    {
+        let mut w = File::create(oracle_dir.join("document_mapping_strings.bin"))?;
+        w.write_all(&strings[..soffs[n]])?;
+        let mut o = File::create(oracle_dir.join("document_mapping_offsets.bin"))?;
+        o.write_all(bytemuck::cast_slice(&soffs[..n + 1]))?;
+        let mut cur = soffs[n];
+        for id in &new_ids {
+            w.write_all(id.as_bytes())?;
+            cur += id.len();
+            o.write_all(&(cur as u64).to_le_bytes())?;
+        }
+        w.sync_all()?;
+        o.sync_all()?;
+    }
+    write_all(&oracle_dir.join("posting_lists.bin"), &pl)?;
+    let mut v = man;
+    {
+        let nnz = mget(&v, "forward_nnz")? + nnz_added;
+        let o = v.as_object_mut().unwrap();
+        o.remove("inplace_v3");
+        o.insert("forward_format_version".into(), serde_json::json!(2));
+        o.insert("n_docs".into(), serde_json::json!(n + rows.len()));
+        o.insert("forward_offsets_len".into(), serde_json::json!(n + 1 + rows.len()));
+        o.insert("forward_data_words".into(), serde_json::json!(base + used));
+        o.insert("forward_nnz".into(), serde_json::json!(nnz));
+    }
+    write_all(&oracle_dir.join("manifest.json"), &serde_json::to_vec_pretty(&v).map_err(|e| inval(e.to_string()))?)?;
+    File::open(oracle_dir)?.sync_all()?;
+    Ok(serde_json::json!({
+        "n_docs_appended": rows.len(), "rows": rows, "fresh_ids": new_ids, "record_words": lens,
+        "tail_words_used": used, "tail_rows_published": rows.len(),
+        "base_words": base, "reserve_words": r.tail_reserve_words, "reserve_rows": r.tail_reserve_rows,
+        "words_repointed_total": n_repointed, "words_repointed_per_doc": repointed,
+        "lists_touched": lists_touched, "published_epoch": 1, "tag_on_repointed_words": 1,
+        "max_base_numeric_id": max_id, "nnz_added": nnz_added,
+        "oracle_dir": oracle_dir.to_string_lossy(),
+    }))
+}
