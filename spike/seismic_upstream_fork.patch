+    /// Build a tiny persona-typed SeismicIndex in-RAM. Uses the persona encoder
+    /// `ScalarSparseQuantizer<u16, f32, f16, DotProduct>` (= `IndexQuantizer`).
+    fn build_tiny_index() -> SeismicIndex<OwnedForward> {
+        // 3 docs over dim=8 vocab. Tokens "t0".."t7" map to ids 0..7.
+        let mut token_to_id_map = HashMap::new();
+        for i in 0..8 {
+            token_to_id_map.insert(format!("t{}", i), i);
+        }
+        let dim = 8;
+        let encoder = ScalarSparseQuantizer::<u16, f32, f16, DotProduct>::new(dim, dim);
+        let mut ds = SparseDatasetGrowable::new(encoder);
+        // doc 0: components [0,1,2] values [1,2,3] (input is f32; encoder quantizes to f16)
+        ds.push(SparseVectorView::new(&[0_u16, 1, 2], &[1.0_f32, 2.0, 3.0]));
+        // doc 1: components [1,2,3] values [2,3,4]
+        ds.push(SparseVectorView::new(&[1_u16, 2, 3], &[2.0_f32, 3.0, 4.0]));
+        // doc 2: components [3,4,5] values [1,1,1]
+        ds.push(SparseVectorView::new(&[3_u16, 4, 5], &[1.0_f32, 1.0, 1.0]));
+        let frozen: OwnedForward = ds.into();
+        let doc_mapping: Vec<String> = (0..3).map(|i| format!("doc{}", i)).collect();
+        SeismicIndex::new(
+            frozen,
+            Configuration::default(),
+            Some(doc_mapping),
+            None::<Vec<Option<String>>>,  // No document content for the test.
+            token_to_id_map,
+        )
+    }
