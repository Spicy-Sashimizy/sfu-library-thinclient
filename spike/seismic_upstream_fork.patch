+        let ext: Vec<(usize, usize)> = extents
+            .iter()
+            .map(|(s, l)| (*s as usize, *l as usize))
+            .collect();
+        match &self.idx {
+            AnyMmapIndex::F16(i) => i.prefault_ranges(&ext),
+            AnyMmapIndex::DotVByte(i) => i.prefault_ranges(&ext),
+        }
+    }
+
+    /// Perform a nearest-neighbor search over the mmap-backed index. Same sparse
+    /// inner-product top-k as `SeismicIndex.search`; same return shape so callers
+    /// are identical. Tokens are resolved through the index's token map (owned,
+    /// O(vocab)) — unknown tokens are silently filtered, matching the owned path.
+    ///
+    /// Args / Returns: identical to `SeismicIndex.search`. See `pylib/mod.rs`.
+    #[pyo3(signature = (
+        query_id, query_components, query_values, k, query_cut, heap_factor,
+        n_knn=0, sorted=true
+    ))]
+    #[pyo3(
+        text_signature = "(self, query_id, query_components, query_values, k, query_cut, heap_factor, n_knn=0, sorted=True)"
+    )]
+    #[allow(clippy::too_many_arguments)]
+    pub fn search<'py>(
+        &self,
+        query_id: String,
+        query_components: PyReadonlyArrayDyn<'py, PyFixedUnicode<MAX_TOKEN_LEN>>,
+        query_values: PyReadonlyArrayDyn<'py, f32>,
+        k: usize,
+        query_cut: usize,
+        heap_factor: f32,
+        n_knn: usize,
+        sorted: bool,
+    ) -> Vec<(String, f32, String)> {
+        // Mirror `PySeismicIndex.search` (pylib/mod.rs:504): numpy fixed-unicode
+        // array → Vec<String>, then `search_raw`, then remap each scored vector
+        // (internal `VectorId` + `DotProduct` distance) into (query_id, score,
+        // doc_id) via the C2 doc-mapping slab — exactly `remap_doc_ids`
+        // (inverted_index_wrapper.rs:193), inlined here without the owned path.
+        let components: Vec<String> = query_components
+            .to_vec()
+            .unwrap_or_default()
+            .iter()
+            .map(|x| x.to_string())
+            .collect();
+        let values: Vec<f32> = query_values.to_vec().unwrap_or_default();
+
+        // The dotvbyte reader has no knn arm (rejected at load; none of the
+        // 150M shards carry one) — its search_raw drops the n_knn parameter.
+        let results = match &self.idx {
+            AnyMmapIndex::F16(i) => {
+                i.search_raw(&components, &values, k, query_cut, heap_factor, n_knn, sorted)
+            }
+            AnyMmapIndex::DotVByte(i) => {
+                i.search_raw(&components, &values, k, query_cut, heap_factor, sorted)
+            }
+        };
+        results
+            .into_iter()
+            .map(|scored| {
+                let score = scored.distance.distance();
+                let doc_idx = scored.vector as usize;
+                // doc_id slab (Path C, zero-copy); fall back to the numeric id
+                // when no mapping is loaded — identical to `remap_doc_ids`.
+                let doc_id = match &self.idx {
+                    AnyMmapIndex::F16(i) => i.doc_id(doc_idx),
+                    AnyMmapIndex::DotVByte(i) => i.doc_id(doc_idx),
+                }
+                .map(|s| s.to_owned())
+                .unwrap_or_else(|| doc_idx.to_string());
+                (query_id.clone(), score, doc_id)
+            })
+            .collect()
+    }
+
+    /// Q6/E5 (2026-07-09): `search` + the traversal's scored-candidate set —
+    /// the forward-range START of every candidate `evaluate_posting_block`
+    /// actually scored (its `visited` dedup key), NOT just the top-k winners.
+    /// Feeds the E5 co-access reordering page-touch simulation
+    /// (`scripts/seismic_testbed/q6_e5_coaccess_sim.py`): cold cost is
+    /// pages-touched-per-candidate, and winners are a ~k' subset of the
+    /// ~10^4–10^5 scored candidates. Starts are component indices into the
+    /// forward arrays (f16) or word offsets into `forward_data.bin`
+    /// (dotvbyte); resolve to doc rows by `np.searchsorted(forward_offsets,
+    /// starts)`. Results are identical to `search` (same traversal — `search`
+    /// delegates to the same body); unsorted candidate order (set iteration).
+    ///
+    /// Returns: (results, visited_starts) where results matches `search`'s
+    /// shape exactly.
+    #[pyo3(signature = (
+        query_id, query_components, query_values, k, query_cut, heap_factor,
+        n_knn=0, sorted=true
+    ))]
+    #[pyo3(
+        text_signature = "(self, query_id, query_components, query_values, k, query_cut, heap_factor, n_knn=0, sorted=True)"
+    )]
+    #[allow(clippy::too_many_arguments)]
+    pub fn search_visited<'py>(
+        &self,
+        query_id: String,
+        query_components: PyReadonlyArrayDyn<'py, PyFixedUnicode<MAX_TOKEN_LEN>>,
+        query_values: PyReadonlyArrayDyn<'py, f32>,
+        k: usize,
+        query_cut: usize,
+        heap_factor: f32,
+        n_knn: usize,
+        sorted: bool,
+    ) -> (Vec<(String, f32, String)>, Vec<u64>) {
+        let components: Vec<String> = query_components
+            .to_vec()
+            .unwrap_or_default()
+            .iter()
+            .map(|x| x.to_string())
+            .collect();
+        let values: Vec<f32> = query_values.to_vec().unwrap_or_default();
+
+        let (results, visited) = match &self.idx {
+            AnyMmapIndex::F16(i) => i.search_raw_visited(
+                &components, &values, k, query_cut, heap_factor, n_knn, sorted,
+            ),
+            AnyMmapIndex::DotVByte(i) => i.search_raw_visited(
+                &components, &values, k, query_cut, heap_factor, sorted,
+            ),
+        };
+        let mapped = results
+            .into_iter()
+            .map(|scored| {
+                let score = scored.distance.distance();
+                let doc_idx = scored.vector as usize;
+                let doc_id = match &self.idx {
+                    AnyMmapIndex::F16(i) => i.doc_id(doc_idx),
+                    AnyMmapIndex::DotVByte(i) => i.doc_id(doc_idx),
+                }
+                .map(|s| s.to_owned())
+                .unwrap_or_else(|| doc_idx.to_string());
+                (query_id.clone(), score, doc_id)
+            })
+            .collect();
+        (mapped, visited.into_iter().map(|s| s as u64).collect())
+    }
+
+    /// Q3/M8 instrument (2026-07-10): `search` + the per-query survivors-per-
+    /// posting-block distribution. Returns (results, visited_starts,
+    /// block_stats) where `block_stats[i]` = number of candidate packs the
+    /// i-th surviving posting block contributed to the heap. Quality-free:
+    /// `results` is bit-identical to `search`; the instrument only OBSERVES
+    /// the per-block survivor count, it does not change the traversal. Feeds
+    /// the M8 register-blocked-kernel pre-gate (math optimization 08 §M8):
+    /// typical batch ≥4 → GO; <2 → M8 dies on paper.
+    ///
+    /// Returns: (results, visited_starts, block_stats) — results matches
+    /// `search`'s shape exactly; block_stats is the per-surviving-block
+    /// candidate-count distribution (unsorted, in block-traversal order).
+    #[pyo3(signature = (
+        query_id, query_components, query_values, k, query_cut, heap_factor,
+        n_knn=0, sorted=true
+    ))]
+    #[pyo3(
+        text_signature = "(self, query_id, query_components, query_values, k, query_cut, heap_factor, n_knn=0, sorted=True)"
+    )]
+    #[allow(clippy::too_many_arguments)]
+    pub fn search_block_stats<'py>(
+        &self,
+        query_id: String,
+        query_components: PyReadonlyArrayDyn<'py, PyFixedUnicode<MAX_TOKEN_LEN>>,
+        query_values: PyReadonlyArrayDyn<'py, f32>,
+        k: usize,
+        query_cut: usize,
+        heap_factor: f32,
+        n_knn: usize,
+        sorted: bool,
+    ) -> (Vec<(String, f32, String)>, Vec<u64>, Vec<usize>) {
+        let components: Vec<String> = query_components
+            .to_vec()
+            .unwrap_or_default()
+            .iter()
+            .map(|x| x.to_string())
+            .collect();
+        let values: Vec<f32> = query_values.to_vec().unwrap_or_default();
+
+        let (results, visited, block_stats) = match &self.idx {
+            AnyMmapIndex::F16(i) => i.search_raw_block_stats(
+                &components, &values, k, query_cut, heap_factor, n_knn, sorted,
+            ),
+            AnyMmapIndex::DotVByte(i) => i.search_raw_block_stats(
+                &components, &values, k, query_cut, heap_factor, sorted,
+            ),
+        };
+        let mapped = results
+            .into_iter()
+            .map(|scored| {
+                let score = scored.distance.distance();
+                let doc_idx = scored.vector as usize;
+                let doc_id = match &self.idx {
+                    AnyMmapIndex::F16(i) => i.doc_id(doc_idx),
+                    AnyMmapIndex::DotVByte(i) => i.doc_id(doc_idx),
+                }
+                .map(|s| s.to_owned())
+                .unwrap_or_else(|| doc_idx.to_string());
+                (query_id.clone(), score, doc_id)
+            })
+            .collect();
+        (
+            mapped,
+            visited.into_iter().map(|s| s as u64).collect(),
+            block_stats,
+        )
+    }
+
+    /// Number of documents in the index (mirror of `SeismicIndex.len`).
+    #[getter]
+    pub fn get_len(&self) -> PyResult<usize> {
+        // The forward dataset's `Dataset::len()` is the doc count.
+        Ok(match &self.idx {
+            AnyMmapIndex::F16(i) => i.forward().len(),
+            AnyMmapIndex::DotVByte(i) => i.forward().len(),
+        })
+    }
+
+    /// Dimensionality (vocab size) of the index (mirror of `SeismicIndex.dim`).
+    #[getter]
+    pub fn get_dim(&self) -> PyResult<usize> {
+        Ok(match &self.idx {
+            AnyMmapIndex::F16(i) => i.forward().input_dim(),
+            AnyMmapIndex::DotVByte(i) => i.forward().input_dim(),
+        })
+    }
+
+    /// Total non-zero components across all documents (mirror of `SeismicIndex.nnz`).
+    #[getter]
+    pub fn get_nnz(&self) -> PyResult<usize> {
+        Ok(match &self.idx {
+            AnyMmapIndex::F16(i) => i.forward().nnz(),
+            AnyMmapIndex::DotVByte(i) => i.forward().nnz(),
+        })
+    }
+
+    /// Whether the index holds no documents (mirror of `SeismicIndex.is_empty`).
+    #[getter]
+    pub fn get_is_empty(&self) -> PyResult<bool> {
+        Ok(match &self.idx {
+            AnyMmapIndex::F16(i) => i.forward().is_empty(),
+            AnyMmapIndex::DotVByte(i) => i.forward().is_empty(),
+        })
+    }
+
+    /// E7: which forward layout this index serves
+    /// ("f16" | "dotvbyte_fixedu8" | "dotvbyte_fixedu8_v2").
+    #[getter]
+    pub fn get_forward_format(&self) -> PyResult<&'static str> {
+        Ok(match &self.idx {
+            AnyMmapIndex::F16(_) => "f16",
+            // Q1 E8: v2 = per-doc-scale record envelope (forward_format_version 2).
+            AnyMmapIndex::DotVByte(i) if i.per_doc_scale() => "dotvbyte_fixedu8_v2",
+            AnyMmapIndex::DotVByte(_) => "dotvbyte_fixedu8",
+        })
+    }
+}
