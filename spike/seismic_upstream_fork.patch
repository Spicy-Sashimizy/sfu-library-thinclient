+/// carry — matches the owning `PySeismicIndex` (`pylib/mod.rs:35`), so the same
+/// `np.array(..., dtype=seismic.get_seismic_string())` query inputs the federated
+/// wrapper already produces are accepted unchanged.
+pub(crate) const MAX_TOKEN_LEN: usize = 30;
+
+/// A Python wrapper around the mmap-backed whole SEISMIC index (`MmapSeismicIndex`).
+///
+/// Construct from a directory written by the `write_mmap_index` layout (the C1a
+/// bin / `convert_shard_to_mmap.py` driver emits it from a stock
+/// `*.index.seismic`). Unlike `SeismicIndex.load()` — which deserializes the whole
+/// index into owned anonymous RAM (Path A, ~137 GB @150M) — this reads every
+/// component zero-decode off reclaimable file cache (Path C; C2 measured the anon
+/// floor at +0.041 GB ≈ 0). At 150M this is the only path that fits a 32 GB host.
+///
+/// `search` returns the identical `(query_id, distance, document_id)` tuple shape
+/// as `SeismicIndex.search`, so a federated wrapper can swap `SeismicIndex.load`
+/// → `MmapSeismicIndex(dir)` with no change to fan-out / merge.
+///
+/// Example:
+///     >>> idx = seismic.MmapSeismicIndex("/tmp/seismic_testbed/mmap_c2")
+///     >>> idx.search("q1", np.array(["token1"], dtype=seismic.get_seismic_string()),
+///     ...            np.array([0.5], dtype=np.float32), k=10, query_cut=8, heap_factor=1.0)
+#[pyclass(name = "MmapSeismicIndex")]
+pub struct PyMmapIndex {
+    idx: AnyMmapIndex,
+}
