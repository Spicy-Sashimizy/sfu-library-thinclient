+    /// surviving posting block contributed (the survivors-per-block
+    /// distribution M8 batches over). Quality-free: identical results to
+    /// `search_raw_visited`. Used to compare the distribution across codecs.
+    pub fn search_raw_block_stats(
+        &self,
+        query_components_original: &[String],
+        query_values: &[f32],
