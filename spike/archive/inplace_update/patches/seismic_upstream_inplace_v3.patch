+/// The v3 reader: the dv-v2 reader's mmaps + header, inflation banks and the
+/// row-id override (FORMAT_V3.md §6).
+pub struct MmapSeismicIndexInplaceV3 {
+    inner: MmapSeismicIndexDotVByte,
+    header: &'static [u8],
+    inflation: &'static [u8],
+    block_base: Vec<usize>,
+    n_blocks_total: usize,
+    row_override: &'static [u8],
+    list_dir: &'static [u8],
+    native_off: Vec<u64>,
+    _posting_heap: &'static [u8],
+    n_docs: usize,
+    n_lists: usize,
+    manifest_fnv: u64,
+}
+
+impl MmapSeismicIndexInplaceV3 {
+    /// Load a v3 dir; every check of FORMAT_V3.md §4 is a load error.
+    pub fn from_mmap(dir: &Path) -> std::io::Result<Self> {
+        let man_bytes = std::fs::read(dir.join("manifest.json"))?;
+        let man: serde_json::Value =
+            serde_json::from_slice(&man_bytes).map_err(|e| inval(e.to_string()))?;
+        if man.get("forward_format").and_then(|x| x.as_str()) != Some("dotvbyte_fixedu8")
+            || mget(&man, "forward_format_version")? != 3
+        {
+            return Err(inval("not an in-place v3 dir (forward_format_version != 3)".into()));
+        }
+        let iv = man.get("inplace_v3").ok_or_else(|| inval("manifest has no inplace_v3".into()))?;
+        if mget(iv, "version")? != FORMAT_VERSION as usize || mget(iv, "record_envelope_version")? != 2 {
+            return Err(inval("inplace_v3 version / record_envelope_version unsupported".into()));
+        }
+        let n_docs = mget(&man, "n_docs")?;
+        let n_lists = mget(&man, "n_posting_lists")?;
+        let lists = man
+            .get("posting_lists")
+            .and_then(|x| x.as_array())
+            .ok_or_else(|| inval("manifest has no posting_lists".into()))?;
+        let mut block_base = Vec::with_capacity(lists.len() + 1);
+        block_base.push(0usize);
+        for p in lists {
+            let nb = mget(p, "n_summaries")?;
+            block_base.push(block_base.last().unwrap() + nb);
+        }
+        let n_blocks_total = *block_base.last().unwrap();
+        if n_blocks_total != mget(iv, "n_blocks_total")? || lists.len() != n_lists {
+            return Err(inval("n_blocks_total / n_posting_lists mismatch".into()));
+        }
+        let header = leak_map(&dir.join("inplace_header.bin"))?;
+        let inflation = leak_map(&dir.join("block_inflation.bin"))?;
+        let row_override = leak_map(&dir.join("row_id_override.bin"))?;
+        let list_dir = leak_map(&dir.join("list_dir.bin"))?;
+        let heap_reserve = iv
+            .get("a2b_reserved")
+            .and_then(|x| x.get("posting_heap"))
+            .and_then(|x| x.get("reserve_bytes"))
+            .and_then(|x| x.as_u64())
+            .ok_or_else(|| inval("inplace_v3.a2b_reserved.posting_heap.reserve_bytes missing".into()))?;
+        let posting_heap = leak_map(&dir.join("posting_heap.bin"))?;
+        let pl_len = std::fs::metadata(dir.join("posting_lists.bin"))?.len() as usize;
+        let native_off: Vec<u64> =
+            list_locations(&man, pl_len)?.iter().map(|l| l.pp_byte as u64).collect();
+        let crc_len = std::fs::metadata(dir.join("list_crc.bin"))?.len() as usize;
+        let pfree_len = std::fs::metadata(dir.join("posting_free.bin"))?.len() as usize;
+        let list_min_len = std::fs::metadata(dir.join("list_min.bin"))?.len() as usize;
+        let free_len = std::fs::metadata(dir.join("forward_free.bin"))?.len() as usize;
+        if header.len() != HEADER_BYTES
+            || inflation.len() != 2 * n_blocks_total
+            || row_override.len() != 8 * n_docs
+            || list_min_len != 8 * n_lists
+            || free_len < FREE_EMPTY_BYTES
+            || list_dir.len() != 16 * n_lists
+            || crc_len != 8 * n_lists
+            || pfree_len < PFREE_EMPTY_BYTES
+            || posting_heap.len() as u64 != heap_reserve
+        {
+            return Err(inval("v3 side file sizes do not match the manifest".into()));
+        }
+        let me = Self {
+            inner: MmapSeismicIndexDotVByte::from_mmap_with(dir, true)?,
+            header,
+            inflation,
+            block_base,
+            n_blocks_total,
+            row_override,
+            list_dir,
+            native_off,
+            _posting_heap: posting_heap,
+            n_docs,
+            n_lists,
+            manifest_fnv: fnv1a64(&man_bytes),
+        };
+        if me.inner.posting_lists_slice().len() != me.n_lists {
+            return Err(inval("reader list count != manifest".into()));
+        }
+        for (t, pl) in me.inner.posting_lists_slice().iter().enumerate() {
+            if pl.n_blocks() != me.block_base[t + 1] - me.block_base[t] {
+                return Err(inval(format!("list {t}: block count != n_summaries")));
+            }
+        }
+        me.published_epoch()
+            .ok_or_else(|| inval("no valid header slot (inplace_header.bin)".into()))?;
+        Ok(me)
+    }
+
+    /// The wrapped dv-v2 reader (residency hooks delegate to it).
+    pub fn inner(&self) -> &MmapSeismicIndexDotVByte {
+        &self.inner
+    }
+
+    fn slot_epoch(&self, s: usize) -> Option<u64> {
+        let base = self.header.as_ptr() as usize + s * HEADER_PAGE;
+        let mut r = [0u8; HEADER_RECORD];
+        for i in 0..HEADER_RECORD / 8 {
+            let p = (base + 8 * i) as *const AtomicU64;
+            let w = unsafe { (*p).load(Ordering::Acquire) };
+            r[8 * i..8 * i + 8].copy_from_slice(&w.to_le_bytes());
+        }
+        let u64_at = |o: usize| u64::from_le_bytes(r[o..o + 8].try_into().unwrap());
+        let u32_at = |o: usize| u32::from_le_bytes(r[o..o + 4].try_into().unwrap());
+        let ok = u64_at(0) == HEADER_MAGIC
+            && u32_at(8) == FORMAT_VERSION
+            && u32_at(12) as usize == s
+            && u64_at(24) == self.n_docs as u64
+            && u64_at(32) == self.n_lists as u64
+            && u64_at(40) == self.n_blocks_total as u64
+            && u64_at(48) == self.manifest_fnv
+            && u64_at(HEADER_RECORD - 8) == fnv1a64(&r[0..HEADER_RECORD - 8])
+            && u64_at(16) <= V3_TAG_MASK;
+        if ok { Some(u64_at(16)) } else { None }
+    }
+
+    /// Published epoch E = the larger epoch of the valid slots (tie: slot 0).
+    pub fn published_epoch(&self) -> Option<u64> {
+        match (self.slot_epoch(0), self.slot_epoch(1)) {
+            (Some(a), Some(b)) => Some(if b > a { b } else { a }),
+            (Some(a), None) => Some(a),
+            (None, Some(b)) => Some(b),
+            (None, None) => None,
+        }
+    }
+
+    /// Per-slot view for diagnostics: (slot0 epoch, slot1 epoch), None = invalid.
+    pub fn header_slots(&self) -> (Option<u64>, Option<u64>) {
+        (self.slot_epoch(0), self.slot_epoch(1))
+    }
+
+    /// External id of a returned row: the override if set, else the slab.
+    pub fn doc_id_string(&self, row: usize) -> Option<String> {
+        if row < self.n_docs {
+            let p = (self.row_override.as_ptr() as usize + 8 * row) as *const AtomicU64;
+            let v = unsafe { (*p).load(Ordering::Relaxed) };
+            if v != 0 {
+                return Some(format!("W{}", v & !(1u64 << 63)));
+            }
+        }
+        self.inner.doc_id(row).map(|s| s.to_owned())
+    }
+
+    /// A2b list directory: the list's unit offset in `bank`, atomically.
+    #[inline(always)]
+    fn list_unit_offset(&self, bank: usize, t: usize) -> u64 {
+        let p = (self.list_dir.as_ptr() as usize + 8 * (bank * self.n_lists + t)) as *const AtomicU64;
+        unsafe { (*p).load(Ordering::Acquire) }
+    }
+
+    /// Resolve list t for this query: native lists use the load-time view;
+    /// an A2b unit (DESIGN, not built) is refused, never mis-read.
+    #[inline(always)]
+    fn check_native(&self, bank: usize, t: usize) -> Result<(), String> {
+        let off = self.list_unit_offset(bank, t);
+        if off == self.native_off[t] {
+            Ok(())
+        } else {
+            Err(format!(
+                "list {t}: list_dir points at an A2b unit (offset {off}); this decoder build reads native lists only"
+            ))
+        }
+    }
+
+    /// Number of lists whose active-bank directory entry is not native.
+    pub fn non_native_lists(&self) -> Option<usize> {
+        let e = self.published_epoch()?;
+        let b = (e & 1) as usize;
+        Some((0..self.n_lists).filter(|&t| self.list_unit_offset(b, t) != self.native_off[t]).count())
+    }
+
+    /// Count of non-zero inflation codes in the active bank (diagnostics).
+    pub fn active_bank_nonzero(&self) -> Option<usize> {
+        let e = self.published_epoch()?;
+        let b = (e & 1) as usize;
+        let bank = &self.inflation[b * self.n_blocks_total..(b + 1) * self.n_blocks_total];
+        Some(
+            bank.iter()
+                .filter(|x| unsafe { (*(*x as *const u8 as *const AtomicU8)).load(Ordering::Relaxed) } != 0)
+                .count(),
+        )
+    }
+
+    /// v3 twin of `MmapSeismicIndexDotVByte::search_raw_block_stats` (the
+    /// stats vector is filled only when `want_stats`). Snapshots E once.
+    #[allow(clippy::too_many_arguments)]
+    pub fn search_raw_v3(
+        &self,
+        query_components_original: &[String],
+        query_values: &[f32],
+        k: usize,
+        query_cut: usize,
+        heap_factor: f32,
+        first_sorted: bool,
+        want_stats: bool,
+    ) -> Result<(Vec<ScoredVectorDotProduct>, Vec<usize>, Vec<usize>), String> {
+        let epoch = self
+            .published_epoch()
+            .ok_or_else(|| "no valid header slot at query time".to_string())?;
+        let b = (epoch & 1) as usize;
+        let bank: &[u8] = &self.inflation[b * self.n_blocks_total..(b + 1) * self.n_blocks_total];
+        let forward = self.inner.forward();
+        let lists = self.inner.posting_lists_slice();
+        let token_map: &HashMap<String, usize> = self.inner.token_map();
+
+        let (filtered_components, filtered_values) =
+            resolve_query_tokens::<u16>(query_components_original, query_values, token_map);
+        let query = SparseVectorView::new(filtered_components.as_slice(), filtered_values.as_slice());
+        let query_components = query.components();
+        let query_values_slice = query.values();
+        assert!(query_components.is_sorted(), "Query components must be sorted in ascending order.");
+
+        let mut evaluator = forward.encoder().query_evaluator(query);
+        let mut heap = KHeap::new(k);
+        let mut visited = FxHashSet::with_capacity_and_hasher(
+            query_cut.min(query_components.len()) * 5000,
+            Default::default(),
+        );
+        let mut block_stats: Vec<usize> = Vec::new();
+
+        let mut iter = query_components
+            .iter()
+            .zip(query_values_slice)
+            .k_largest_by(query_cut, |a, b| a.1.total_cmp(b.1));
+        if first_sorted {
+            if let Some((&component_id, _value)) = iter.next() {
+                let t: usize = component_id.as_();
+                self.check_native(b, t)?;
+                let infl = &bank[self.block_base[t]..self.block_base[t + 1]];
+                lists[t].sort_and_search_v3(
+                    &mut evaluator, &query, k, heap_factor, &mut heap, &mut visited, forward,
+                    if want_stats { Some(&mut block_stats) } else { None }, infl, epoch,
+                );
+            }
+        }
+        for (&component_id, _value) in iter {
+            let t: usize = component_id.as_();
+            self.check_native(b, t)?;
+            let infl = &bank[self.block_base[t]..self.block_base[t + 1]];
+            lists[t].search_v3(
+                &mut evaluator, &query, k, heap_factor, &mut heap, &mut visited, forward,
+                if want_stats { Some(&mut block_stats) } else { None }, infl, epoch,
+            );
+        }
+
+        let visited_starts: Vec<usize> = visited.into_iter().collect();
+        Ok((
+            heap.into_sorted_vec()
+                .into_iter()
+                .map(|scored| ScoredVectorDotProduct {
+                    distance: scored.distance,
+                    vector: forward.id_from_range(scored.range),
+                })
+                .collect(),
+            visited_starts,
+            block_stats,
+        ))
+    }
+}
