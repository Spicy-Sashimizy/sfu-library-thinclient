+        inv_subblock_inventory_len: subblock_inv.len(),
+        inv_overflow_positions_len: overflow.len(),
+    }
+}
+
+/// Number of per-list scalars in an A2b unit header (FORMAT_V3.md §3.6):
+/// the `PostingListManifest` fields in declaration order, each as u64.
+pub(crate) const UNIT_SCALARS: usize = 24;
+
+impl PostingListManifest {
+    pub(crate) fn to_scalars(&self) -> [u64; UNIT_SCALARS] {
+        [
+            self.packed_postings_words as u64, self.block_offsets_len as u64,
+            self.n_summaries as u64, self.dim as u64, self.has_component_ids as u64,
+            self.component_ids_len as u64, self.values_len as u64, self.minimums_len as u64,
+            self.quants_len as u64, self.summaries_ids_field_width as u64,
+            self.summaries_ids_n_bits as u64, self.summaries_ids_n_words as u64,
+            self.ef_high_bits_n_bits as u64, self.ef_high_bits_n_words as u64,
+            self.ef_low_bits_field_width as u64, self.ef_low_bits_n_bits as u64,
+            self.ef_low_bits_n_words as u64, self.ef_low_len as u64, self.ef_universe as u64,
+            self.ef_num_vals as u64, self.inv_n_sets as u64, self.inv_block_inventory_len as u64,
+            self.inv_subblock_inventory_len as u64, self.inv_overflow_positions_len as u64,
+        ]
+    }
+
+    pub(crate) fn from_scalars(s: &[u64; UNIT_SCALARS]) -> Result<Self, String> {
+        if s[4] > 1 || s[9] > 64 || s[14] > 64 {
+            return Err("unit scalars out of range (bool / field widths)".into());
+        }
+        let u = |i: usize| s[i] as usize;
+        Ok(Self {
+            packed_postings_words: u(0), block_offsets_len: u(1), n_summaries: u(2), dim: u(3),
+            has_component_ids: s[4] == 1, component_ids_len: u(5), values_len: u(6),
+            minimums_len: u(7), quants_len: u(8), summaries_ids_field_width: s[9] as u8,
+            summaries_ids_n_bits: u(10), summaries_ids_n_words: u(11),
+            ef_high_bits_n_bits: u(12), ef_high_bits_n_words: u(13),
+            ef_low_bits_field_width: s[14] as u8, ef_low_bits_n_bits: u(15),
+            ef_low_bits_n_words: u(16), ef_low_len: u(17), ef_universe: u(18), ef_num_vals: u(19),
+            inv_n_sets: u(20), inv_block_inventory_len: u(21), inv_subblock_inventory_len: u(22),
+            inv_overflow_positions_len: u(23),
+        })
+    }
+
+    /// Byte length of this list's slice sequence when it starts at an
+    /// 8-aligned offset (the reader's alignment walk, as in the converter).
+    pub(crate) fn walk_len(&self) -> usize {
+        let mut c = skip_pod::<u64>(0, self.packed_postings_words);
+        c = skip_pod::<usize>(c, self.block_offsets_len);
+        c = skip_pod::<u64>(c, self.ef_high_bits_n_words);
+        c = skip_pod::<i64>(c, self.inv_block_inventory_len);
+        c = skip_pod::<u16>(c, self.inv_subblock_inventory_len);
+        c = skip_pod::<usize>(c, self.inv_overflow_positions_len);
+        c = skip_pod::<u64>(c, self.ef_low_bits_n_words);
+        c = skip_pod::<u64>(c, self.summaries_ids_n_words);
+        c += self.values_len;
+        c = skip_pod::<f32>(c, self.minimums_len);
+        c = skip_pod::<f32>(c, self.quants_len);
+        if self.has_component_ids {
+            c = skip_pod::<u16>(c, self.component_ids_len);
+        }
+        c
+    }
+}
+
+/// Manifest scalars of list `t` (in-place v3 test fixtures).
+pub(crate) fn manifest_list_scalars(dir: &Path, t: usize) -> std::io::Result<[u64; UNIT_SCALARS]> {
+    let m: MmapManifest = serde_json::from_str(&std::fs::read_to_string(dir.join("manifest.json"))?)
+        .map_err(|e| std::io::Error::new(std::io::ErrorKind::InvalidData, e))?;
+    Ok(m.posting_lists[t].to_scalars())
+}
+
+/// Replace list `t`'s manifest entry by `scalars` in a manifest JSON value
+/// (in-place v3 test fixtures: the native-splice oracle).
+pub(crate) fn manifest_with_list_replaced(
+    manifest_json: &str,
+    t: usize,
+    scalars: &[u64; UNIT_SCALARS],
+) -> Result<String, String> {
+    let mut m: MmapManifest = serde_json::from_str(manifest_json).map_err(|e| e.to_string())?;
+    m.posting_lists[t] = PostingListManifest::from_scalars(scalars)?;
+    serde_json::to_string_pretty(&m).map_err(|e| e.to_string())
+}
+
+/// Build a list view over an A2b unit body (FORMAT_V3.md §3.6). The body must
+/// be 8-aligned and exactly the scalars' walk length (+ < 8 padding); the
+/// reader's `read_pod` alignment/bounds asserts then cannot fire.
+pub(crate) fn posting_list_view_from_unit(
+    body: &'static [u8],
+    scalars: &[u64; UNIT_SCALARS],
+) -> Result<MmapPostingList<'static>, String> {
+    let plm = PostingListManifest::from_scalars(scalars)?;
+    if body.as_ptr() as usize % 8 != 0 {
+        return Err("unit body not 8-aligned".into());
+    }
+    let need = plm.walk_len();
+    if need > body.len() || body.len() - need >= 8 {
+        return Err(format!("unit body {} bytes, scalars walk {}", body.len(), need));
+    }
+    if plm.packed_postings_words == 0 {
+        if plm.block_offsets_len != 0 || plm.n_summaries != 0 {
+            return Err("empty unit with blocks".into());
+        }
